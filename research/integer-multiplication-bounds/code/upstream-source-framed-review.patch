+    require(beta==Q(1,8),'Chosen whole-complex stopping threshold differs')
+    internal=tau+(1-beta)*max(sigma-tau,Q(0));leaf=sigma+beta*(1-sigma)
+    internal_saving,leaf_saving=1-internal,1-leaf
