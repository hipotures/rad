+@cache
+def bounds(n):
+    lo, hi = log_integer(n, 128)
+    scale = 2**384
+    lower = Q(lo.numerator*scale//lo.denominator, scale)
+    upper = Q(-((-hi.numerator*scale)//hi.denominator), scale)
+    require(lower <= lo <= hi <= upper, 'Independent dyadic rounding failed')
+    return lower, upper
