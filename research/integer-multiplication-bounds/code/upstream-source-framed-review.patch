+    require(row['exponent_order']=='sigma<=tau: root dominated' and
+        all(Q(row['recurrence_savings'][k])==v for k,v in
+            dict(internal=internal_saving,leaf=leaf_saving,reservations=c,q=q).items()),
+        'General stopped savings differ')
+    prefix=row['prefix']
+    if prefix=='original':
