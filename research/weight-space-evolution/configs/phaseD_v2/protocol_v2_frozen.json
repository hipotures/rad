  "F4": "MinAtar policy behaviour (Seaquest/Asterix exp5 hand networks)",
  "F5": "algorithmic transformers (held-out transfer family)"
 },
 "tiers": {
  "T0": "select 1 of 4 complete edits; 4 rotations per instance, oracle once at each position, 1 sample per rotation (seed = rotation)",
  "T1": "subtype named, oracle template with numbers blanked; constrained to the template regex; n = 4, seed 0",
  "T2": "free-form DSL edit constrained to the instance DSL regex (1-12 statements); n = 4, seed 0",
  "T2P": "T2 with one budgeted probe pass: trial edit (n = 4, seed 0) -> probe-set feedback -> final edit (n = 1 per trial, seed 1); probe passes counted"
 },
 "decoding": {
  "chat_template": "non-thinking",
  "temperature": 0.7,
  "top_p": 0.8,
  "top_k": 20,
  "max_tokens": {
   "T0": 8,
   "T1": 256,
   "T2": 384,
   "T2P": 384
  },
  "prefix_cache": "reset before every generate() call (makes sampled outputs bit-reproducible run to run)"
 },
 "engine": {
  "default": "profile3 (FLASHINFER, max_num_seqs 1024, max_num_batched_tokens 16384, BF16, max_model_len 32768, gpu_memory_utilization 0.85)",
  "reproducibility_baseline": "vLLM defaults via --engine-profile default",
  "excluded": [
   "FP8 KV cache",
   "MTP speculative decoding"
  ]
 },
 "scoring": {
  "recovery": "(metric(edited) - metric(damaged)) / (metric(clean) - metric(damaged)) on the instance test set",
  "invalid": "invalid or missing edits are scored as no-ops (recovery 0) and reported separately as invalid",
  "regression": "recovery < -0.02 (F1-F3, F5) or < -0.05 (F4)",
  "effective": "recovery >= 0.5",
  "full_repair": "recovery >= 0.9"
 },
 "cell_acceptance_rule": {
  "unit": "family x tier cell, core families F1-F4, decided on the pilot split",
  "criteria": [
   "oracle mean recovery >= 0.90 (the reference repair is achievable)",
   "headroom over the trivial non-agent repairer: simple-heuristic mean recovery <= 0.60 (for T0 additionally: chance <= 0.40)",
   "Gold E0 is not at ceiling: E0 mean recovery <= 0.80",
   "format is not the bottleneck: E0 valid rate >= 0.50"
  ],
  "floor_cells": "cells where E0 mean recovery <= 0.02 are kept but flagged (improvement must come from candidates)",
  "reporting": "the improved (probe-search) heuristic is reported as the stronger non-agent reference; it is not an acceptance criterion"
 },
 "primary_endpoint": "paired mean recovery difference candidate - E0 over accepted cells on the test split (pairing: instance x tier x sample), instance-cluster bootstrap CI, Holm correction across candidates",
 "secondary": [
  "transfer split (held-out F1-F4 subtypes and the F5 family)",
  "per-family/tier recovery, valid, effective, regression rates",
  "resource-normalized recovery per 1k generated tokens and per GPU-second"
