{
  "version": 1,
  "checks": [
    {
      "id": "publication-policy",
      "group": "repository",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools",
        "-p",
        "test_archive_workspace.py",
        "-v"
      ],
      "inputs": [
        "tools/archive_workspace.py",
        "tools/test_archive_workspace.py",
        "tools/text_evidence.py",
        "tools/import_external_workspaces.py",
        ".gitignore"
      ],
      "paths": [
        "tools/**",
        ".gitignore"
      ],
      "timeout_seconds": 240,
      "scope": "Existing repository publication, retention and artifact-policy regressions"
    },
    {
      "id": "ci-runner-controls",
      "group": "repository",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools",
        "-p",
        "test_ci.py",
        "-v"
      ],
      "inputs": [
        "tools/run_ci.py",
        "tools/test_ci.py",
        "tools/ci_archive_audit.py",
        "tools/ci_checks.json"
      ],
      "paths": [
        "tools/**",
        ".github/workflows/**"
      ],
      "timeout_seconds": 120,
      "scope": "Runner validation, failure propagation, timeouts, safe paths and evidence preservation"
    },
    {
      "id": "assembly-arithmetic-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py",
        "--self-test"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py",
        "research/integer-mult-breakthrough/fixtures/frozen-assembly-ceiling.json"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py",
        "research/integer-mult-breakthrough/fixtures/frozen-assembly-ceiling.json"
      ],
      "timeout_seconds": 60,
      "scope": "Exact arithmetic and negative controls for frozen assumed inequalities; not an integer-multiplication proof"
    },
    {
      "id": "frozen-assembly-ceiling",
      "group": "certificates",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py",
        "research/integer-mult-breakthrough/fixtures/frozen-assembly-ceiling.json"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/check_assembly_ceiling.py",
        "research/integer-mult-breakthrough/fixtures/frozen-assembly-ceiling.json"
      ],
      "timeout_seconds": 60,
      "scope": "Exact consequences of a < (1-beta)b and kappa < a/(1+a), under explicitly assumed fixed inputs"
    },
    {
      "id": "unitary-dyadic-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py",
        "--self-test"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact finite Gaussian-dyadic unitary arithmetic and corruption/scope controls; no multiplier claim"
    },
    {
      "id": "unitary-dyadic-finite-replay",
      "group": "certificates",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py",
        "--workers",
        "1",
        "--max-row-power",
        "4",
        "--max-butterfly-power",
        "4"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "timeout_seconds": 120,
      "scope": "Bounded exact row enumeration and complete finite Walsh Gram/entropy replay; analytic all-size lemmas are not formalized"
    },
    {
      "id": "wider-unitary-macro",
      "group": "certificates",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/obstructions/wider_unitary.py"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/obstructions/wider_unitary.py",
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/obstructions/wider_unitary.py",
        "research/integer-mult-breakthrough/code/obstructions/unitary_dyadic.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact literal three-gate Gaussian-dyadic unitary macro; no free macro cost or recurrence saving"
    },
    {
      "id": "positive-type-mixing-barrier",
      "group": "certificates",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/transfers/coupled_moments.py",
        "--workers",
        "1",
        "--cases",
        "8"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/transfers/coupled_moments.py",
        "research/integer-mult-breakthrough/fixtures/transfers/frozen-full-moments.json"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/transfers/coupled_moments.py",
        "research/integer-mult-breakthrough/fixtures/transfers/frozen-full-moments.json"
      ],
      "timeout_seconds": 120,
      "scope": "Exact complete frozen moment arithmetic and finite nonnegative type-mixing controls; scoped polynomial-certificate obstruction, no multiplication lower bound"
    },
    {
      "id": "deferred-normalization-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "research/integer-mult-breakthrough/code/transfers/deferred_normalization.py",
        "--workers",
        "1",
        "--cases",
        "8"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/transfers/deferred_normalization.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/transfers/deferred_normalization.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact auxiliary finite-field/radix carry, representation and padding controls; no Gaussian all-size transfer"
    },
    {
      "id": "complex-structural-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "-B",
        "research/integer-mult-breakthrough/code/complex/test_complex.py"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/complex/test_complex.py",
        "research/integer-mult-breakthrough/code/complex/characteristic.py",
        "research/integer-mult-breakthrough/code/complex/block_exclusion.py",
        "research/integer-mult-breakthrough/code/complex/center_obstructions.py",
        "research/integer-mult-breakthrough/code/complex/five_subset_envelope.py",
        "research/integer-mult-breakthrough/code/complex/five_side_screen.py",
        "research/integer-mult-breakthrough/code/complex/tree_intersection.py",
        "research/integer-mult-breakthrough/code/complex/frame_feasibility.py",
        "research/integer-mult-breakthrough/fixtures/complex/pr36-local-axis.json"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/complex/test_complex.py",
        "research/integer-mult-breakthrough/code/complex/characteristic.py",
        "research/integer-mult-breakthrough/code/complex/block_exclusion.py",
        "research/integer-mult-breakthrough/code/complex/center_obstructions.py",
        "research/integer-mult-breakthrough/code/complex/five_subset_envelope.py",
        "research/integer-mult-breakthrough/code/complex/five_side_screen.py",
        "research/integer-mult-breakthrough/code/complex/tree_intersection.py",
        "research/integer-mult-breakthrough/code/complex/frame_feasibility.py",
        "research/integer-mult-breakthrough/fixtures/complex/pr36-local-axis.json"
      ],
      "timeout_seconds": 120,
      "scope": "Exact finite complex moments, scalar sides, feature frames and scoped optimistic envelopes; no complete new primitive or exponent"
    },
    {
      "id": "synthesis-auxiliary-certificates",
      "group": "certificates",
      "command": [
        "{python}",
        "-B",
        "research/integer-mult-breakthrough/code/synthesis/verify_certificates.py"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/synthesis/verify_certificates.py",
        "research/integer-mult-breakthrough/code/synthesis/frozen_ledger_bound.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py",
        "research/integer-mult-breakthrough/code/synthesis/run_discriminators.py",
        "research/integer-mult-breakthrough/fixtures/synthesis/auxiliary-scalar-and-ledger.json"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/synthesis/verify_certificates.py",
        "research/integer-mult-breakthrough/code/synthesis/frozen_ledger_bound.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py",
        "research/integer-mult-breakthrough/code/synthesis/run_discriminators.py",
        "research/integer-mult-breakthrough/fixtures/synthesis/auxiliary-scalar-and-ledger.json"
      ],
      "timeout_seconds": 120,
      "scope": "Exact auxiliary source/sink/dirty scalar words and necessary frozen native ledger bracket; no physical network or all-size theorem"
    },
    {
      "id": "static-joint-frame-controls",
      "group": "certificates",
      "command": [
        "{python}",
        "-B",
        "-c",
        "import sys; sys.path.insert(0, 'research/integer-mult-breakthrough/code/synthesis'); from static_joint_frame import probe; results=[probe(h) for h in (5,6,23)]; print('Exact finite stationary-intertwiner controls:', len(results))"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/synthesis/static_joint_frame.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/synthesis/static_joint_frame.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact diagonal identities, rational channel closure and four-target inconsistency in auxiliary stationary intertwiner model; no dynamic circuit lower bound"
    },
    {
      "id": "odd-weight-kernel-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "-B",
        "research/integer-mult-breakthrough/code/obstructions/odd_weight_kernels.py",
        "--workers",
        "1",
        "--bounded"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/obstructions/odd_weight_kernels.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/obstructions/odd_weight_kernels.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact finite odd-subset scalar kernels, binary feature spans and dyadic center reconstruction; no paid side circuit or multiplication exponent"
    },
    {
      "id": "same-width-row-budget-controls",
      "group": "smoke",
      "command": [
        "{python}",
        "-B",
        "research/integer-mult-breakthrough/code/transfers/row_budget_recursion.py",
        "--workers",
        "1"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/transfers/row_budget_recursion.py"
      ],
      "paths": [
        "research/integer-mult-breakthrough/code/transfers/row_budget_recursion.py"
      ],
      "timeout_seconds": 120,
      "scope": "Exact declared toy depth/row/guard recurrence with complete same-width calls; no native phase program or multiplication transfer"
    },
    {
      "id": "shared-twist-scatter-controls",
      "group": "certificates",
      "command": [
        "{python}",
        "-B",
        "-c",
        "import sys; sys.path.insert(0, 'research/integer-mult-breakthrough/code/synthesis'); from shared_twist_factorization import probe; probe((6,11)); print('Exact auxiliary every-address dirty scatter and inverse controls pass')"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/synthesis/shared_twist_factorization.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py"
      ],
      "scope": "Exact auxiliary shared factorization and literal arbitrary-dirty odd-field scatter with missing-inverse controls; no integrated native cost ledger",
      "paths": [
        "research/integer-mult-breakthrough/code/synthesis/shared_twist_factorization.py",
        "research/integer-mult-breakthrough/code/synthesis/global_incidence.py"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "copied-center-independent-controls",
      "group": "certificates",
      "command": [
        "{python}",
        "-B",
        "research/integer-mult-breakthrough/code/transfers/copied_center_review.py",
        "--workers",
        "1"
      ],
      "inputs": [
        "research/integer-mult-breakthrough/code/transfers/copied_center_review.py",
        "research/integer-mult-breakthrough/fixtures/transfers/weighted-tree-h8-frame-witness.json"
      ],
      "scope": "Independent finite copied-phase arrays, eight-bit scatter coefficient and serialized side-DAG radical witness; no full native compiler or all-size transfer",
      "paths": [
        "research/integer-mult-breakthrough/code/transfers/copied_center_review.py",
        "research/integer-mult-breakthrough/fixtures/transfers/weighted-tree-h8-frame-witness.json"
      ],
      "timeout_seconds": 120
    }
  ]
}
