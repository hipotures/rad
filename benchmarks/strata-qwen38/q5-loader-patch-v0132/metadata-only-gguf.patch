+        try {
+            strata::GgufFile g(path.string());
+            const auto* name = g.get("general.name");
+            valid = g.tensors().empty() && name && name->s == "metadata-only" &&
+                    g.file_size() % g.alignment() != 0 && g.data_start() == g.file_size();
+        } catch (const std::exception& e) { err = e.what(); }
+        std::filesystem::remove(path);
+        check(err.empty() && valid, "metadata-only: EOF after metadata, no padding, empty data section");
+    }
+    {
+        const auto path = write_unpadded_gguf(true);
+        std::string err;
+        try { strata::GgufFile g(path.string()); }
+        catch (const std::exception& e) { err = e.what(); }
+        std::filesystem::remove(path);
+        check(err == "GGUF: data section starts past EOF", "one tensor: EOF before aligned data_start is still refused");
+    }
+    {
+        const auto path = write_unpadded_gguf(false, true);
+        std::string err;
+        try { strata::GgufFile g(path.string()); }
+        catch (const std::exception& e) { err = e.what(); }
+        std::filesystem::remove(path);
+        check(!err.empty(), "metadata-only: truncated metadata is still refused");
