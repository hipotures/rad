ies(s_gemv_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s_gemv_parity COMMAND s_gemv_parity --selftest)\n\n  add_executable(elementwise_parity src/kernels/elementwise_parity.cpp)\n  target_include_directories(elementwise_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(elementwise_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME elementwise_parity COMMAND elementwise_parity --selftest)\n\n  add_executable(bf16_gemv_parity src/kernels/bf16_gemv_parity.cpp)\n  target_include_directories(bf16_gemv_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(bf16_gemv_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME bf16_gemv_parity COMMAND bf16_gemv_parity --selftest)\n\n  add_executable(s_gemv_q8k_parity src/kernels/s_gemv_q8k_parity.cpp)\n  target_include_directories(s_gemv_q8k_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s_gemv_q8k_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s_gemv_q8k_parity COMMAND s_gemv_q8k_parity --selftest)\n\n  add_executable(qsa_parity src/kernels/qsa_parity.cpp)\n  target_include_directories(qsa_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(qsa_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME qsa_parity COMMAND qsa_parity --selftest)\n\n  # ---- P2.S4: the PLE n-gram hash, the IQ4_NL table read, and the PLE block ----\n  # `ngram.cpp` is host-only but lives in `strata_kernels` because `ple.cu` shares its geometry constants, and\n  # splitting them across two libraries would only add a layer.\n  #\n  # The pack, the original GGUF and the ggml capture are all REQUIRED inputs: this test's oracles are real\n  # artifacts, so the working directory is pinned to the source tree and a missing input is a hard error\n  # INSIDE the test.  A test that passes by finding nothing to compare is the failure mode this project keeps\n  # re-learning.\n  add_executable(ple_parity src/kernels/ple_parity.cpp)\n  target_include_directories(ple_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(ple_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  set(STRATA_PLE_FIXTURE_DIR \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro\" CACHE PATH\n      \"Directory containing required ple_in.bin and ple_out.bin parity fixtures\")\n  add_test(NAME ple_parity COMMAND ple_parity --selftest\n    --in \"${STRATA_PLE_FIXTURE_DIR}/ple_in.bin\" --out \"${STRATA_PLE_FIXTURE_DIR}/ple_out.bin\"\n    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n\n  # Plan v0.3 P7: INT8 KV storage vs a host reference and vs the FP16 path (GPU, synthetic, no model).\n  add_executable(kv_q8_parity src/kernels/kv_q8_parity.cpp)\n  target_include_directories(kv_q8_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_q8_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_q8_parity COMMAND kv_q8_parity)\n\n  # KV streaming (docs/kv-streaming-design.md): streamed vs resident attention, bitwise (GPU, synthetic, no model).\n  add_executable(kv_stream_parity src/kernels/kv_stream_parity.cpp)\n  target_include_directories(kv_stream_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_stream_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_stream_parity COMMAND kv_stream_parity)\n\n  # PR #120: the hybrid K8V4 KV (INT8 K + rotated Q4_0 V) vs host references (GPU, synthetic, no model).\n  add_executable(kv_hybrid_parity src/kernels/kv_hybrid_parity.cpp)\n  target_include_directories(kv_hybrid_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_hybrid_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_hybrid_parity COMMAND kv_hybrid_parity)\n  # PR #21: Q4_0 KV with Walsh-Hadamard rotation vs a host reference (GPU, synthetic, no model).\n  add_executable(kv_q4_parity src/kernels/kv_q4_parity.cpp)\n  target_include_directories(kv_q4_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_q4_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_q4_parity COMMAND kv_q4_parity)\n  add_executable(cvec_parity src/kernels/cvec_parity.cpp)\n  target_include_directories(cvec_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(cvec_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME cvec_parity COMMAND cvec_parity)\n\n  # The rewritten per-hit and grouped expert kernels vs the previous ones, bitwise (GPU, synthetic, no model).\n  # `--bench` adds previous/new timings on engine-like shapes.\n  add_executable(s2_expert_grouped_parity src/kernels/s2_expert_grouped_parity.cpp)\n  target_include_directories(s2_expert_grouped_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s2_expert_grouped_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s2_expert_grouped_parity COMMAND s2_expert_grouped_parity --selftest)\n\n  # Plan v0.3 P3: native MMVQ for 1..8 tokens (bitwise selftest + --bench timing); synthetic data, no model.\n  if(STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/native_mmvq_multi.cpp\")\n    add_executable(native_mmvq_multi bench/micro/native_mmvq_multi.cpp)\n    target_include_directories(native_mmvq_multi PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(native_mmvq_multi PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n    add_test(NAME native_mmvq_multi COMMAND native_mmvq_multi --selftest)\n  endif()\n\n  # Plan v0.3 P0.1: working-set lock of a host region (CPU only).\n  add_executable(platform_memory_test src/platform/memory_test.cpp)\n  target_link_libraries(platform_memory_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n  add_test(NAME platform_memory_test COMMAND platform_memory_test)\n\n  if(CMAKE_SYSTEM_NAME STREQUAL \"Linux\")\n    add_executable(pinned_shared_test src/core/pinned_shared_test.cpp)\n    target_link_libraries(pinned_shared_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n    add_test(NAME pinned_shared_test COMMAND pinned_shared_test)\n  endif()\n\n  # Plan v0.3 P2: the n-gram table read straight from the SSD. The selftest needs only the CPU and a temp file.\n  add_executable(ple_reader_test src/ngram/ple_reader_test.cpp)\n  target_include_directories(ple_reader_test PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(ple_reader_test PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME ple_reader_selftest COMMAND ple_reader_test --selftest)\n\n  # The GPU test runs ON THE TARGET PC. `--selftest` allocates\n  # and writes real VRAM, so a machine without a device fails this test rather than skipping it silently -\n  # which is correct: an engine that targets one GPU should not report a pass for having no GPU.\n  if(STRATA_ENABLE_CUDA)\n    add_test(NAME cuda_device_selftest COMMAND strata-device --selftest)\n  else()\n    add_test(NAME hip_device_selftest COMMAND strata-device --selftest)\n  endif()\n\n  # ---- P2.S5: the GraphRegistry --------------------------------------------------\n  # A .cu because the test needs real kernels to capture; it links `strata_core` and not `strata_kernels`,\n  # because what it exercises is the capture machinery and not any kernel in it.\n  if(STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/graph_registry_test.cu\")\n    add_executable(graph_registry_test bench/micro/graph_registry_test.cu)\n    target_include_directories(graph_registry_test PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(graph_registry_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n    add_test(NAME graph_registry_test COMMAND graph_registry_test)\n  endif()\n\n  # ---- P2.S5's GATE: is a device<->pinned-memory handoff graph-capturable? --------------------\n  # The doorbell protocol puts the D2H of `x_f` and the miss list INSIDE G[l] - that is the whole overlap.  The\n  # phase doc says to verify this \"before building on it\", and this project has already lost two rounds to\n  # building first (a memory-only spin that DEADLOCKS on Windows, and a `cudaEventRecord` inside a capture that\n  # is SILENTLY DROPPED).  It links only cudart: it is about the capture machinery, not about any kernel.\n  if(STRATA_ENABLE_CUDA AND STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/pinned_capture.cu\")\n    add_executable(pinned_capture bench/micro/pinned_capture.cu)\n    target_include_directories(pinned_capture PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(pinned_capture PRIVATE ${_strata_gpu_runtime_target})\n    add_test(NAME pinned_capture COMMAND pinned_capture)\n  endif()\n\n  # Tells tests/CMakeLists.txt to add the CUDA-dependent Catch2 target.  It cannot be declared there\n  # unconditionally: tests/ is added at the end of this file, but the flag has to be known before it runs.\n  if(STRATA_ENABLE_CUDA)\n    set(STRATA_CUDA_TESTS ON)\n  endif()\nendif()\n\n# ---- strata_kernels_cpu (P2.S3) ----\n#\n# A SEPARATE LIBRARY from `strata_kernels`, and `/arch:AVX512` is set on the SOURCE rather than on the target\n# so that the flag applies only to the TU that needs it.  Both parts matter:\n#\n#   * the CPU expert kernel uses `_mm256_dpbusd_epi32` (AVX512-VNNI) and `_mm256_multishift_epi64_epi8`\n#     (AVX512-VBMI); without the flag MSVC reports undeclared intrinsics and never mentions AVX-512;\n#   * a TU compiled WITH `/arch:AVX512` may use AVX-512 in ANY of its code, so the scalar fallback and the\n#     test drivers must NOT be in it - otherwise the fallback is not a fallback, it is the same bet with\n#     worse opt-out.  `cpu_require_expert_support()` therefore refuses at startup on a CPU without the\n#     features, and the fallback exists for tests, exactly as P2.S3 specifies.\n# Plan v0.3 P6: speculation components that need no GPU.\nadd_library(strata_spec STATIC src/spec/suffix_drafter.cpp src/spec/controller.cpp src/spec/draft_policy.cpp)\ntarget_include_directories(strata_spec PUBLIC include)\nif(STRATA_BUILD_TESTS)\n  add_executable(suffix_drafter_test src/spec/suffix_drafter_test.cpp)\n  target_link_libraries(suffix_drafter_test PRIVATE strata_spec)\n  add_test(NAME suffix_drafter_test COMMAND suffix_drafter_test)\n  add_executable(controller_test src/spec/controller_test.cpp)\n  target_link_libraries(controller_test PRIVATE strata_spec)\n  add_test(NAME controller_test COMMAND controller_test)\n  add_executable(draft_policy_test src/spec/draft_policy_test.cpp)\n  target_link_libraries(draft_policy_test PRIVATE strata_spec)\n  add_test(NAME draft_policy_test COMMAND draft_policy_test)\nendif()\nif(STRATA_BUILD_TESTS OR STRATA_BUILD_CONVERSATION_TESTS)\n  # the serve loop's conversation-cache retention policy (header-only, no library to link)\n  add_executable(conv_cache_test src/program/conv_cache_test.cpp)\n  target_include_directories(conv_cache_test PRIVATE include)\n  add_test(NAME conv_cache_test COMMAND conv_cache_test)\n  # coupled draft sampling's counter and penalty-ring arithmetic (header-only, CPU)\n  add_executable(coupled_draft_test src/core/coupled_draft_test.cpp)\n  target_include_directories(coupled_draft_test PRIVATE include)\n  add_test(NAME coupled_draft_test COMMAND coupled_draft_test)\n  # the f32 -> bf16 rounding against ggml's, NaN included, over every f32 bit pattern (header-only, CPU)\n  add_executable(bf16_bits_test src/kernels/bf16_bits_test.cpp)\n  target_include_directories(bf16_bits_test PRIVATE include)\n  add_test(NAME bf16_bits_test COMMAND bf16_bits_test)\nendif()\n\nadd_library(strata_kernels_cpu STATIC src/kernels/cpu/expert.cpp src/kernels/cpu/pool.cpp\n            src/kernels/cpu/expert_layout.cpp src/kernels/cpu/q2_avx2.cpp)\ntarget_include_directories(strata_kernels_cpu PUBLIC include)\n# Plan v0.3 P6: only the kernel files get the AVX-512 / AVX2 flags; the pool and the probe run on any x86-64,\n# and the engine picks the kernels at run time (cpu_avx512_ok).\nif(MSVC)\n  set_source_files_properties(src/kernels/cpu/expert.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX512\")\n  set_source_files_properties(src/kernels/cpu/q2_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\nelse()\n  # GCC/Clang spell it differently, and `-mavx512vnni` alone is not enough: VBMI is a separate feature bit.\n  set_source_files_properties(src/kernels/cpu/expert.cpp\n                              PROPERTIES COMPILE_OPTIONS \"-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma\")\n  set_source_files_properties(src/kernels/cpu/q2_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\nendif()\nfind_package(Threads REQUIRED)\ntarget_link_libraries(strata_kernels_cpu PUBLIC Threads::Threads)\n\n# ---- plan v0.3 P6: the i-quant models' CPU experts (IQ2_XS / IQ3_XXS files) ----\n#\n# The CPU computes a native expert with ggml-cpu's own dot products (`ggml_get_type_traits_cpu`), so an IQ\n# weight means exactly what it means in llama.cpp.  ggml is built static from a llama.cpp checkout: a local one\n# with -DSTRATA_GGML_DIR=..., otherwise the pinned upstream commit (third_party/ggml/VERSION.txt).\noption(STRATA_NATIVE_EXPERTS \"Native (IQ) expert support through ggml-cpu\" ON)\nset(STRATA_GGML_DIR \"\" CACHE PATH \"llama.cpp checkout to take ggml from (empty: fetch the pinned commit)\")\nif(STRATA_PREFILL_MMQ AND NOT STRATA_NATIVE_EXPERTS)\n  message(FATAL_ERROR \"STRATA_PREFILL_MMQ requires STRATA_NATIVE_EXPERTS=ON for GGML sources\")\nendif()\nif(STRATA_NATIVE_EXPERTS)\n  enable_language(C)\n  set(BUILD_SHARED_LIBS OFF CACHE BOOL \"\" FORCE)\n  set(GGML_STATIC ON CACHE BOOL \"\" FORCE)\n  set(GGML_CUDA OFF CACHE BOOL \"\" FORCE)\n  set(GGML_OPENMP OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BACKEND_DL OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BUILD_TESTS OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BUILD_EXAMPLES OFF CACHE BOOL \"\" FORCE)\n  if(STRATA_PORTABLE)\n    set(GGML_NATIVE OFF CACHE BOOL \"\" FORCE)\n    foreach(_f GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2)\n      set(${_f} ON CACHE BOOL \"\" FORCE)\n    endforeach()\n  else()\n    set(GGML_NATIVE ON CACHE BOOL \"\" FORCE)\n  endif()\n  if(STRATA_GGML_DIR)\n    add_subdirectory(${STRATA_GGML_DIR}/ggml ${CMAKE_BINARY_DIR}/ggml EXCLUDE_FROM_ALL)\n  else()\n    include(FetchContent)\n    FetchContent_Declare(strata_llamacpp\n      GIT_REPOSITORY https://github.com/ggml-org/llama.cpp.git\n      GIT_TAG 3cf03257f219afbe7334045ff7c6a06ac68c627d\n      GIT_SHALLOW FALSE)\n    FetchContent_GetProperties(strata_llamacpp)\n    if(NOT strata_llamacpp_POPULATED)\n      FetchContent_Populate(strata_llamacpp)\n    endif()\n    add_subdirectory(${strata_llamacpp_SOURCE_DIR}/ggml ${CMAKE_BINARY_DIR}/ggml EXCLUDE_FROM_ALL)\n  endif()\n  # part of strata_kernels_cpu (the pool calls these and they call its CPU probe: one library, so GNU ld's\n  # one-pass static linking has no cycle to resolve)\n  target_sources(strata_kernels_cpu PRIVATE src/kernels/cpu/native_expert.cpp src/kernels/cpu/iq_avx512.cpp\n                                           src/kernels/cpu/iq_avx2.cpp src/kernels/cpu/kq_avx2.cpp)\n  target_include_directories(strata_kernels_cpu PRIVATE third_party/ggml)\n  if(MSVC)\n    set_source_files_properties(src/kernels/cpu/iq_avx512.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX512\")\n    set_source_files_properties(src/kernels/cpu/iq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\n    set_source_files_properties(src/kernels/cpu/kq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\n  else()\n    set_source_files_properties(src/kernels/cpu/iq_avx512.cpp PROPERTIES COMPILE_OPTIONS\n                                \"-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma\")\n    set_source_files_properties(src/kernels/cpu/iq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\n    set_source_files_properties(src/kernels/cpu/kq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\n  endif()\n  target_link_libraries(strata_kernels_cpu PUBLIC ggml-cpu ggml-base)\n  target_compile_definitions(strata_kernels_cpu PUBLIC STRATA_NATIVE_EXPERTS=1)\n  if(STRATA_ENABLE_CUDA)\n    # prompt-speed plan step 2b: llama.cpp's MMQ kernels (ggml-cuda, MIT) for the prompt path's experts, compiled\n    # from the same checkout as ggml above - only mmq.cuh's instances for the packs' types and the quantizer, with\n    # the few host symbols of ggml-cuda.cu they use in src/prefill/ggml_cuda_host.cu\n    if(STRATA_GGML_DIR)\n      set(_strata_gg ${STRATA_GGML_DIR}/ggml)\n    else()\n      set(_strata_gg ${strata_llamacpp_SOURCE_DIR}/ggml)\n    endif()\n    set(_strata_mmq ${_strata_gg}/src/ggml-cuda)\n    add_library(strata_mmq STATIC src/prefill/moe_mmq.cu src/prefill/ggml_cuda_host.cu ${_strata_mmq}/quantize.cu)\n    foreach(_t q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)   # q8_0: the drafter's matrices (E-9)\n      target_sources(strata_mmq PRIVATE ${_strata_mmq}/template-instances/mmq-instance-${_t}.cu)\n    endforeach()\n    target_include_directories(strata_mmq PRIVATE ${_strata_gg}/include ${_strata_gg}/src ${_strata_mmq}\n                               PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_compile_options(strata_mmq PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda -use_fast_math>)\n    if(MSVC)\n      target_compile_options(strata_mmq PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/bigobj>)\n    endif()\n    target_link_libraries(strata_mmq PUBLIC ggml-base ${_strata_gpu_runtime_target})\n    target_link_libraries(strata_prefill PUBLIC strata_mmq)\n    target_compile_definitions(strata_prefill PUBLIC STRATA_PREFILL_MMQ=1)\n  elseif(STRATA_PREFILL_MMQ)\n    # Compile only the pinned GGML MMQ and activation-quantizer sources used by prefill. This uses\n    # common.cuh's native HIP path without enabling a second GGML HIP backend.\n    if(STRATA_GGML_DIR)\n      set(_strata_gg \"${STRATA_GGML_DIR}/ggml\")\n    else()\n      set(_strata_gg \"${strata_llamacpp_SOURCE_DIR}/ggml\")\n    endif()\n    set(_strata_mmq \"${_strata_gg}/src/ggml-cuda\")\n    if(NOT EXISTS \"${_strata_mmq}/common.cuh\" OR NOT EXISTS \"${_strata_mmq}/quantize.cu\")\n      message(FATAL_ERROR \"The selected GGML source is missing the ggml-cuda MMQ sources: ${_strata_mmq}\")\n    endif()\n    set(_strata_mmq_sources\n      src/prefill/moe_mmq.cu\n      src/prefill/ggml_cuda_host.cu\n      \"${_strata_mmq}/quantize.cu\")\n    foreach(_t q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)\n      list(APPEND _strata_mmq_sources \"${_strata_mmq}/template-instances/mmq-instance-${_t}.cu\")\n    endforeach()\n    set_source_files_properties(${_strata_mmq_sources} PROPERTIES LANGUAGE HIP)\n    add_library(strata_mmq STATIC ${_strata_mmq_sources})\n    target_include_directories(strata_mmq\n      PRIVATE \"${_strata_gg}/include\" \"${_strata_gg}/src\" \"${_strata_mmq}\"\n      PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_compile_definitions(strata_mmq PRIVATE GGML_USE_HIP=1)\n    target_link_libraries(strata_mmq PUBLIC ggml-base hip::host roc::hipblas)\n    target_link_libraries(strata_prefill PUBLIC strata_mmq)\n    target_compile_definitions(strata_prefill PUBLIC STRATA_PREFILL_MMQ=1)\n\n    # Numerical diagnostic: synthetic layouts by default, optional first-expert IQ3_XXS/IQ4_NL check with a pack.\n    add_executable(hip_prefill_mmq_parity tests/hip/prefill_mmq_parity.cpp)\n    target_include_directories(hip_prefill_mmq_parity PRIVATE \"${_strata_gg}/include\")\n    target_link_libraries(hip_prefill_mmq_parity PRIVATE strata_prefill)\n    add_test(NAME hip_prefill_mmq_parity COMMAND hip_prefill_mmq_parity)\n    set_tests_properties(hip_prefill_mmq_parity PROPERTIES TIMEOUT 120)\n    list(APPEND _strata_hip_tests hip_prefill_mmq_parity)\n  endif()\n  if(STRATA_ENABLE_HIP)\n    # Optional real-model diagnostic: pass the GGUF shard containing the native PLE key.\n    add_executable(hip_ple_iq4 tests/hip/ple_iq4.cpp)\n    target_link_libraries(hip_ple_iq4 PRIVATE strata_kernels strata_hip_runtime ggml-base)\n  endif()\n  if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)\n    add_executable(native_expert_parity src/kernels/native_expert_parity.cpp)\n    target_include_directories(native_expert_parity PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(native_expert_parity PRIVATE strata_kernels strata_kernels_cpu strata_artifact ${_strata_gpu_runtime_target})\n    if(STRATA_BUILD_TESTS AND STRATA_ENABLE_CUDA)\n      # Unsloth UD-Q4_K_XL's three expert pairs (and Q8_0 alone, its embedding) on synthetic ggml-quantized weights\n      # at 2560/640: GPU and CPU experts against the float reference, GPU dequantizers against to_float\n      foreach(_pair q4_K/q5_1 q4_K/q8_0 q5_K/q8_0 q8_0/q8_0)\n        string(REPLACE \"/\" \"_\" _name \"${_pair}\")\n        add_test(NAME native_expert_parity_${_name} COMMAND native_expert_parity --synthetic ${_pair})\n        set_tests_properties(native_expert_parity_${_name} PROPERTIES TIMEOUT 120)\n      endforeach()\n      add_test(NAME native_expert_parity_q5_1_min COMMAND native_expert_parity --q5_1-min)\n      # a pair without GPU kernels (Q6_K gate/up) is refused by native_expert_supported, not run\n      add_test(NAME native_expert_parity_refuses_q6_K COMMAND native_expert_parity --synthetic q6_K/q8_0)\n      set_tests_properties(native_expert_parity_refuses_q6_K PROPERTIES WILL_FAIL TRUE)\n    endif()\n  endif()\nendif()\n\nif(STRATA_ENABLE_CUDA AND STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/hit_cpu_order_parity.cu\")\n  add_executable(hit_cpu_order_parity bench/micro/hit_cpu_order_parity.cu)\n  target_link_libraries(hit_cpu_order_parity PRIVATE strata_kernels strata_kernels_cpu ${_strata_gpu_runtime_target})\nendif()\n\nif(STRATA_BUILD_TESTS)\n  # Plan v0.3 P6: one expert applied to several tokens, bitwise vs the single-token kernel (synthetic, CPU only).\n  # plan v0.3 P5: the device dequantizers vs the artifact's CPU dequantizers on the real shards (not a ctest: needs\n  # the 38 GB model; run it by hand or from tools/gpu_session.py)\n  if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)   # #93: it needs the device dequantizers and a GPU runtime\n    add_executable(dequant_bf16_test src/kernels/dequant_bf16_test.cpp)\n    target_link_libraries(dequant_bf16_test PRIVATE strata_kernels strata_artifact ${_strata_gpu_runtime_target})\n  endif()\n\n  add_executable(expert_multi_test src/kernels/cpu/expert_multi_test.cpp)\n  target_link_libraries(expert_multi_test PRIVATE strata_kernels_cpu)\n  add_test(NAME expert_multi_test COMMAND expert_multi_test)\n\n  add_executable(expert_parity src/kernels/cpu/expert_parity.cpp)\n  target_link_libraries(expert_parity PRIVATE strata_kernels_cpu)\n  # The pack is a REQUIRED input, not an optional one: this test compares against a real expert blob, and a\n  # missing file would otherwise be reported as a pass by a test that skipped everything.\n  add_test(NAME expert_parity COMMAND expert_parity --selftest\n           WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n\n  add_executable(pool_test src/kernels/cpu/pool_test.cpp)\n  target_link_libraries(pool_test PRIVATE strata_kernels_cpu)\n  add_test(NAME pool_test COMMAND pool_test --selftest WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n  # issue #29: tiny batches with sleeping workers, as on a big-VRAM card; a hang fails it\n  add_executable(pool_stress src/kernels/cpu/pool_stress.cpp)\n  target_link_libraries(pool_stress PRIVATE strata_kernels_cpu)\n  add_test(NAME pool_stress COMMAND pool_stress 20)\n\n  if(UNIX AND NOT APPLE)\n    add_executable(direct_file_async_test tests/platform/direct_file_async.cpp src/platform/direct_file.cpp)\n    target_include_directories(direct_file_async_test PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_link_libraries(direct_file_async_test PRIVATE Threads::Threads)\n    add_test(NAME direct_file_async_test COMMAND direct_file_async_test)\n  endif()\nendif()\n\nif(STRATA_BUILD_TESTS)\n  enable_testing()\n  # Model-level checks may be absent from source distributions.\n  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/CMakeLists.txt\")\n    add_subdirectory(tests)\n  endif()\nendif()\n\n```\n### README.md\n```\n<h1 align=\"center\">Strata</h1>\n\n<p align=\"center\"><b>Run a 125-billion-parameter AI model on a normal gaming PC</b><br>\none NVIDIA card (12-24 GB) + 64 GB of RAM · Windows or Linux · one click to install</p>\n\n<p align=\"center\"><a href=\"https://github.com/Niko1221/Strata/releases/download/v0.1.10/Pagoda.mp4\"><img src=\"docs/media/pagoda-preview.webp\" width=\"720\" alt=\"A voxel pagoda garden that Strata's model wrote, running in the browser\"></a><br>\n<sub>A voxel pagoda garden, 1 shot prompt running on an RTX 5070 with Strata (IQ3_S, 128K context) ·\n<a href=\"https://github.com/Niko1221/Strata/releases/download/v0.1.10/Pagoda.mp4\">full video (49 s)</a></sub></p>\n\nStrata runs **[Qwen3.8-Flash-Next](https://huggingface.co/Qwen/Qwen3.8-Flash-Next)** - a large, smart AI model that\nnormally needs a server - on your own PC. It writes its answers at **60-95 tokens per second** (a token is about ¾\nof a word): faster than you can read.\n\n- **Free and open source.**\n\n> **Jump to:** [How fast?](#how-fast-is-it) · [Which model?](#which-model-should-i-pick) · [Install](#install) ·\n> [Using it](#using-it) · [Problems?](#something-went-wrong) · [How it works](#how-does-it-work) ·\n> [All the details](docs/DETAILS.md)\n\n---\n\n## How fast is it?\n\nMeasured on an RTX 5070 (12 GB), a Ryzen 5 7600 and 64 GB of RAM:\n\n| Size | Writes answers (short chat) | Writes answers (128K context) | Reads your prompt |\n| --- | ---: | ---: | ---: |\n| **Q2_0** | 93 tokens/s | 74 tokens/s | 2,170 tokens/s |\n| **IQ2_XS** | 79 tokens/s | 63 tokens/s | 2,090 tokens/s |\n| **IQ3_XXS** | 62 tokens/s | 49 tokens/s | 1,750 tokens/s |\n| **IQ3_S** | 53 tokens/s | 46 tokens/s | 1,620 tokens/s |\n| **Coder** (IQ1_M) | 55 tokens/s | 43 tokens/s | 2,180 tokens/s |\n\n- **Writes answers** = how fast the reply appears (tokens per second).\n- **Reads your prompt** = how fast it takes in what you send (long documents, code, chat history), measured on a\n  32K-token prompt; a 4K prompt reads at 910-1,580 tokens/s. A 32K prompt takes about 15 seconds with Q2_0.\n\nA card with more VRAM is faster, because more of the model fits on the GPU: an RTX 3090 (24 GB) should do roughly\n100-140 tokens per second. All measurements, long-context numbers and estimates for other cards are in the\n[details](docs/DETAILS.md#speed-measured).\n\nEvery PC is different: `START-HERE.bat --calibrate` measures a few engine settings on yours and keeps the fastest\n(about 5-10 minutes; on the PC above it made the Coder 7% faster).\n\nMeasured Strata on your own PC? See [Community benchmark results](docs/COMMUNITY_BENCHMARKS.md)\nfor a report template and how to share your results in a pull request.\n\n**Two or three NVIDIA cards?** Just run `START-HERE.bat`: it lists your cards, says which ones Strata can use, and\nasks whether to share the model across them (recommended when two can). An install made on one card asks once at\nits next start. Or choose yourself: `START-HERE.bat --gpus 0,2` (both, remembered), `--gpus all`, or `--gpu 0` (one\ncard, this start only). Each card keeps the experts of its own layers, and prompts flow through the cards in a\npipeline: on an RTX 5080 + RTX 3090 prompts were read 18-20% faster than on the 5080 alone, decoding on par.\nEvery card must be an RTX 20 series or newer with 8 GB or more. See [docs/MULTI_GPU.md](docs/MULTI_GPU.md).\n\n## Which model should I pick?\n\n**The size** (the same model, compressed more or less):\n\n| Model | RAM+VRAM Requirements | Speed | Quality |\n| --- | ---: | --- | --- |\n| **Q2_0** | 37.6 GB | fastest | good |\n| **IQ2_XS** | 39.2 GB | fast | better (**recommended**) |\n| **IQ3_XXS** | 47.0 GB | slower | great |\n| **IQ3_S** | 54.8 GB | slowest | best: matches the full model on the published tests (original model only) |\n\n**Will it fit?** Shard 1 is the part of the model that gets loaded when it starts: its experts go into your **RAM**,\nthe rest onto your graphics card (the second shard, a 29 GB lookup table, stays on the SSD). So it fits when your\n**RAM is at least shard 1 + about 10 GB** for Windows and your other programs. With 64 GB of RAM every size fits\n(IQ3_S with little else open); with 48 GB, Q2_0 and IQ2_XS. A bigger graphics card makes it faster, but it doesn't\nlower the RAM needed.\n\n**The version:**\n\n- **Qwen3.8-Flash-Next** - the original.\n- **[Coder](https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-Coder-GGUF)** - ISTA-DASLab's coding\n  version: half of the experts removed, keeping the ones that code, tool use and images need (91% of the full model's\n  SWE-bench Verified score, 99% of LiveCodeBench, by its authors). One size (IQ1_M: its experts stored like IQ3_S):\n  shard 1 is **29.6 GB**, so it fits a PC with **32 GB of RAM**, runs 262K context on 64 GB, and reads long prompts\n  the fastest of all. Weaker outside coding.\n- **[Swift 1.5](https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-Flash-Next-GSQ-RCO-GGUF)** - a fine-tune by UkisAI\n  that thinks much shorter before answering, so you get the answer sooner, with about the same quality. Same speed per\n  token, and about the same RAM as the same size of the original (no IQ3_S). Its own license applies (see its page).\n\nNot sure? Take **IQ2_XS** - or the **Coder** if you mainly write code, or have 32-48 GB of RAM. You can add another\none later with `SETUP.bat` (the same as `START-HERE.bat --setup`; on Linux `./setup.sh --setup`).\n\nFor **OrcaRouter's Flash-Next Uncensored IQ3_XXS**, see the [manual compatibility setup](docs/ORCA.md).\nIt needs an explicit packing conversion and is not an installer menu option.\n\nAn **AMD Radeon RX 7900 XT / XTX, RX 9070 / 9070 XT or Radeon AI PRO R9700 on Linux** works too (experimental; the\nRX 7800 XT / 7700 XT and RX 9060 XT were validated by their owners):\n`./setup.sh --backend hip`, chosen by itself on a PC with no NVIDIA card Strata can use. It installs ROCm without sudo\nand compiles the engine (no images yet; several cards with `--gpus`). Details: [AMD HIP](docs/AMD_HIP.md).\n\n## Install\n\n**You need:** an NVIDIA RTX 20, 30, 40 or 50 card with 12 GB of VRAM or more (RTX 20 since 0.1.27), enough RAM for the size you pick (above;\na big GPU makes up for less RAM - the [low-RAM mode](docs/DETAILS.md)),\n~80 GB of free disk space (an SSD makes the first start much faster), and Windows 10/11 or Linux. The only thing you\ninstall yourself is a current **NVIDIA driver** ([nvidia.com/drivers](https://www.nvidia.com/drivers) or the NVIDIA\nApp). Everything else - Python, the engine, the model - is set up for you.\n\n**Windows**\n\n1. [Download this project](https://github.com/Niko1221/Strata/archive/refs/heads/main.zip) and unzip it (or `git clone` it).\n2. Double-click **`START-HERE.bat`**.\n3. Answer a few questions - or just press Enter each time for the recommended choice:\n   - **Which model and size?** The original or Swift 1.5, and Q2_0, IQ2_XS, IQ3_XXS or IQ3_S - see [above](#which-model-should-i-pick)\n   - **How much context?** How much text it can keep in mind at once (it suggests one for your card). 384K and\n     512K (experimental) extend the model past its trained 262K by rope scaling - the setup turns it on itself (yarn and a\n     covering factor; `--rope-scaling`/`--rope-scale` override) ([details](docs/DETAILS.md))\n   - **Images?** Whether it should also read pictures\n   - **Experimental speed projection?** Off unless you say yes - [read what it does](docs/DETAILS.md#experimental-speed-projection-experimental-off-by-default) first\n\nThen it downloads everything (the model is ~70 GB, so the first time takes a while - you can stop and it picks up\nwhere it left off) and **starts the model**. Your browser opens the Strata app at `http://127.0.0.1:8080`.\n\n> **While the model starts, your PC can be slow or stop responding for 1-3 minutes** (longest the first time): Strata\n> loads 35-55 GB into your RAM and locks part of it for the graphics card. That's normal - wait, and don't close the\n> window. The window tells you what it is doing.\n\n**Next time**, just double-click `START-HERE.bat` again: it starts right away, nothing is downloaded twice. Close its\nwindow to stop the model.\n\n**Updating:** download the new version and unzip it anywhere (or `git pull`), then run `START-HERE.bat` in it. The\nmodel files are kept in a `Strata-data` folder next to your Strata folder, so a new copy finds them and sets itself up\nthe same way - nothing big is downloaded again.\n\n**Linux:** run `./setup.sh` - same questions, same result.\n\n**Docker (Linux):** the same idea, in a container.\n\n1. Host: Docker with the [NVIDIA Container Toolkit](https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html)\n   and a driver **580 or newer** (CUDA 13.0).\n2. Build (this compiles the engine into the image, so the container never compiles):\n   `docker build -t strata .`\n   `docker build -t strata --build-arg CUDA_ARCHITECTURES=89 .` builds for one card only (faster).\n   The default covers RTX 30 (86), RTX 40 (89), RTX 50 (120) and A-series (80); a card outside that\n   set needs a rebuild with its own arch. Add `--build-arg BUILD_VISION=0` to skip the image encoder.\n3. Run (the first start downloads the ~70 GB model, then starts; later starts go straight to serving):\n   `docker run --rm --gpus all -p 8080:8080 --ulimit memlock=-1 -v strata-data:/data strata`\n\n   The setup choices are env vars: `-e MODEL=IQ2_XS -e FAMILY=qwen -e CONTEXT=32768 -e VISION=no`\n   (or `MODEL=Q2_0|IQ3_XXS|IQ3_S`, `FAMILY=swift|coder`; the defaults above are the recommended ones).\n   `-e VISION=cpu` keeps the image encoder on the CPU. `-e KV=int8|q4_0|k8v4` picks the KV cache\n   precision; `k8v4` is INT8 K with 4-bit V and keeps its KV in VRAM from 64K up.\n   Only the model files, the prepared pack, the MTP layer and the install config live in the\n   `strata-data` volume; the engine is part of the image. Switching between models already on the\n   volume needs no setup pass: `-e MODEL=Q2_0 -e FAMILY=coder` picks that model's config. Add\n   `-e REINSTALL=1` only to change settings for a model already set up (context, vision, KV, host,\n   api_key, LOW_RAM), since those are recorded in its config.\n   Strata loads 32-62 GB into RAM. `--gpus all` on a host with two usable cards takes both: the\n   layer split is setup's recommended default ([docs/MULTI_GPU.md](docs/MULTI_GPU.md)), and a volume\n   set up for one card switches to the pair on its first start there. Pin one card with `-e GPU=0`,\n   or name them with `-e GPUS=0,2` and where the later card's layers start with `-e LAYER_SPLIT=18`.\n   A memory limit needs `-e LOW_RAM=on`, which maps the model's experts from the pack instead of\n   keeping them in RAM: setup.py measures the host's RAM, not the container's limit, so it cannot\n   see a cap. LOW_RAM runs on one card.\n   The server listens on `0.0.0.0:8080` by default; set `-e API_KEY=<secret>` before exposing the port\n   to a network. The image has a `HEALTHCHECK` on `/health`, so `docker ps` shows the container\n   healthy once the model is loaded, and `GET /v1/status` says what it is running.\n\n## Using it\n\n<p align=\"center\"><img src=\"docs/media/runpagoda.png\" width=\"900\" alt=\"The Strata app's Monitor tab next to a coding agent\"><br>\n<sub>The Strata app's <b>Monitor</b> (left) while a coding agent writes the pagoda garden from the video (right)</sub></p>\n\n- **In the browser:** `http://127.0.0.1:8080` - the Strata app (it opens by itself when the model starts): **Chat**, a\n  live **Monitor** of the model and your GPU/CPU/RAM, and **About** with the settings and addresses.\n- **Chat in the terminal:** `.venv\\Scripts\\python chat.py`\n- **Your apps and coding agents:** add it as an \"OpenAI-compatible\" provider with base URL\n  **`http://127.0.0.1:8080/v1`**, any API key and any model name. Apps that use Anthropic's API: `http://127.0.0.1:8080/v1/messages`.\n- **Thinking:** the model thinks before it answers. Choose **off, low, medium or high** - in the chat page menu, with\n  `/think low` in `chat.py`, or with your app's \"reasoning effort\" setting. Off is fastest; high is best for hard questions.\n- **Pictures:** in the chat page click **Picture**; in `chat.py` type `/image <path>`; in apps just attach them.\n- **From your phone or another PC:** `START-HERE.bat --setup --host 0.0.0.0 --api-key <secret>`, then open the\n  address the server window prints; see the [details](docs/DETAILS.md#using-it).\n- **Experimental speed projection (off by default):** an experimental control vector that setup can turn on; it\n  changes how the model answers - read [what it does](docs/DETAILS.md#experimental-speed-projection-experimental-off-by-default) first.\n\n**Good to know:** it answers one request at a time. The first message of a chat is read in full (about 1 minute per\n30,000 tokens); after that it keeps the conversation and reads only what is new, so follow-ups start in seconds.\n\n### Where things are stored\n\n- **Your chats: only in your browser.** The Chat tab keeps the conversation, its settings and the API key you typed\n  in the browser's local storage (`strata.*` keys) - not on the server and not in the Strata folder. Pictures are not\n  kept, only their names. Another browser or a private window starts empty; clearing the site's data deletes them.\n- **How the model starts:** `strata-<model>.json` in the Strata folder (context, GPUs, host, API key, ...), written\n  by setup; next to it `run-<model>.bat` / `.sh`, the log `strata-<model>.log` and, when you use \"Use for other\n  apps too\", `strata-<model>.shared-settings.json`.\n- **The model files** (`models/`, `packs/`, `mtp/`, 70-120 GB): in **`Strata-data` next to the Strata folder**, or\n  wherever `--data-dir` put them.\n- **Where that data folder is:** `%APPDATA%\\Strata\\settings.json` on Windows, `~/.config/strata/settings.json` on\n  Linux ([details](docs/DETAILS.md)).\n\n## Something went wrong?\n\n**My PC froze, or got very slow, the first time Strata started.**\nThat's normal while it starts, most of all the first time. Strata loads 35-55 GB into your RAM, locks part of it for\nthe graphics card, and works out how much of the model fits on your GPU. The mouse can freeze for a few minutes. **Wait, and don't close the\nwindow.** The next starts are much faster. Still frozen after 10 minutes? Restart the PC, close other programs\n(browsers use a lot of RAM) and try again. If it keeps happening, pick a smaller size (Q2_0 or IQ2_XS).\n\n**It stopped while downloading or installing.**\nRun `START-HERE.bat` again. It continues where it stopped.\n\n**It says the NVIDIA driver is too old.**\nUpdate it (NVIDIA App or [nvidia.com/drivers](https://www.nvidia.com/drivers)), restart the PC, and run\n`START-HERE.bat` again.\n\n**It says port 8080 is already in use.**\nStrata is already running. Look for its window.\n\n**It's very slow and the disk light keeps blinking.**\nYour PC is out of free RAM. Close other programs, or pick a smaller size (Q2_0 or IQ2_XS).\n\n**An answer stopped with \"the engine stopped unexpectedly\".**\nUsually not enough RAM (on Linux the system then stops the engine). Just send your message again: Strata starts the\nengine by itself. If it keeps happening, close other programs or pick a smaller size.\n\n**It says the prompt exceeds the context.**\nThe conversation is longer than the context you chose. Start a new chat, or run `SETUP.bat` and pick more\ncontext.\n\n**Still stuck?** Look in the [full troubleshooting table](docs/DETAILS.md#troubleshooting), or open an issue and\nattach `strata-<model>.log` from the Strata folder.\n\n## How does it work?\n\nModels like this one normally run on servers with hundreds of gigabytes of graphics memory. Your graphics card has\n12-24 GB. Strata makes it fit by **sharing the work across your whole PC** - the same idea as a kitchen, where the\nthings you use all the time stay on the counter and the rest waits in the pantry.\n\n<p align=\"center\"><img src=\"docs/media/how-it-works.svg\" width=\"860\" alt=\"The model's 24,576 experts: the busiest on the graphics card, all of them in RAM, a lookup table on the SSD\"></p>\n\n- **The model is a team of 24,576 small specialists (\"experts\"),** and each word it writes needs only 10 of them.\n  So it doesn't have to have all of them on the graphics card at once.\n- **Your graphics card** does the part of the work needed for every word, and keeps the few thousand experts that\n  are asked most often. It keeps learning which ones those are while you use it.\n- **Your RAM** holds every expert. When a word needs one the card doesn't have, **your processor** works on it -\n  at the same time as the graphics card, so neither waits for the other.\n- **Your SSD** holds a big lookup table; the model only reads a few small rows of it per word.\n\n<p align=\"center\"><img src=\"docs/media/guess-and-check.svg\" width=\"860\" alt=\"A small helper guesses the next words; the big model checks them all at once and keeps the right ones\"></p>\n\n- **Guess, then check.** A small, fast helper built into the model guesses the next few words, and the big model\n  checks all the guesses in one go. It keeps the ones it agrees with and writes the next word itself - so one step\n  often produces several words. The helper only guesses - the big model decides every word - so you get the same\n  quality answer, 1.6-1.8x sooner.\n- **Long texts are read in big pieces** (up to 8,192 tokens - pieces of words - at a time), which is why a long\n  document or code base is read at over 1,000 tokens per second.\n\nWant the full picture? The [details](docs/DETAILS.md#how-it-works) explain every part and its numbers, and the\n[paper](docs/paper/Strata-Paper.pdf) tells the whole story, with the measurements behind it.\n\n## Credits\n\n- Model: [Qwen3.8-Flash-Next](https://huggingface.co/Qwen/Qwen3.8-Flash-Next) by the Qwen team; compressed versions by\n  [ISTA-DASLab](https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF);\n  [Swift 1.5](https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-Flash-Next-GSQ-RCO-GGUF) by UkisAI. Their licenses apply\n  to the model files.\n- Built with parts of [llama.cpp / ggml](https://github.com/ggml-org/llama.cpp) (MIT). Ideas from\n  [Splash](https://github.com/incoai/splash), [ninfer](https://github.com/Neroued/ninfer) and\n  [HyperQwen](https://github.com/syv-ai/HyperQwen). More in the [details](docs/DETAILS.md#credits-and-licenses).\n\n## License\n\nStrata is open source under the [MIT License](LICENSE). A few parts carry their own licenses: `third_party/ggml`\n(MIT, llama.cpp / ggml), the web app's font (SIL Open Font License 1.1) and the experimental speed projection's\nvector in `data/experimental-speed-projection` (Qwen Community License 1.0, from the model's activations). The\nmodels are not part of this repository; each model's own license applies to its files.\n\n```\n### chat.py\n```\n#!/usr/bin/env python3\n\"\"\"A tiny terminal chat for a running Strata server (start it with run-<model>.bat / run-<model>.sh first).\n\n    python chat.py [--port 8080] [--think none|low|medium|high]\n\nType a message and press Enter.  /image <path> attaches a picture to your next message (when the server was set up\nwith images), /think <none|low|medium|high> sets how long the model thinks first, /reset starts a new conversation,\n/quit leaves.  Standard library only.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport base64\nimport json\nimport mimetypes\nimport os\nimport sys\nimport time\nimport urllib.request\n\n\ndef stream(url, messages, think, max_tokens):\n    body = {\"model\": \"strata\", \"messages\": messages, \"stream\": True, \"max_tokens\": max_tokens,\n            \"reasoning_effort\": think}\n    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})\n    with urllib.request.urlopen(req, timeout=3600) as r:\n        for raw in r:\n            line = raw.decode(\"utf-8\", \"replace\").strip()\n            if not line.startswith(\"data: \") or line == \"data: [DONE]\":\n                continue\n            d = json.loads(line[6:])[\"choices\"][0][\"delta\"]\n            yield d.get(\"reasoning_content\") or \"\", d.get(\"content\") or \"\"\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--port\", type=int, default=8080)\n    ap.add_argument(\"--host\", default=\"127.0.0.1\")\n    ap.add_argument(\"--think\", default=\"medium\", choices=[\"none\", \"low\", \"medium\", \"high\"],\n                    help=\"how long the model thinks before answering (none = answer directly)\")\n    ap.add_argument(\"--no-think\", action=\"store_true\", help=\"same as --think none\")\n    ap.add_argument(\"--max-tokens\", type=int, default=4096)\n    a = ap.parse_args()\n    url = f\"http://{a.host}:{a.port}/v1/chat/completions\"\n    gray, reset = (\"\\033[90m\", \"\\033[0m\") if sys.stdout.isatty() else (\"\", \"\")\n    messages, pending = [], []\n    think = \"none\" if a.no_think else a.think\n    print(f\"Strata chat ({url}).  /image <path> = attach a picture, /think none|low|medium|high (now: {think}), \"\n          f\"/reset = new conversation, /quit = leave.\")\n    while True:\n        try:\n            user = input(\"\\nyou> \").strip()\n        except (EOFError, KeyboardInterrupt):\n            print()\n            return 0\n        if user in (\"/quit\", \"/exit\"):\n            return 0\n        if user == \"/reset\":\n            messages, pending = [], []\n            print(\"(new conversation)\")\n            continue\n        if user.startswith(\"/think\"):\n            level = user[6:].strip().lower()\n            if level in (\"none\", \"low\", \"medium\", \"high\"):\n                think = level\n                print(f\"(thinking: {think})\")\n            else:\n                print(\"(usage: /think none|low|medium|high)\")\n            continue\n        if user.startswith(\"/image\"):\n            path = user[6:].strip().strip('\"').strip(\"'\")\n            if not os.path.isfile(path):\n                print(f\"(no such file: {path or '?'} - usage: /image <path to a picture>)\")\n                continue\n            mime = mimetypes.guess_type(path)[0] or \"image/jpeg\"\n            data = base64.b64encode(open(path, \"rb\").read()).decode()\n            pending.append({\"type\": \"image_url\", \"image_url\": {\"url\": f\"data:{mime};base64,{data}\"}})\n            print(f\"(picture attached: {os.path.basename(path)} - now type your question)\")\n            continue\n        if not user:\n            continue\n        if pending:\n            messages.append({\"role\": \"user\", \"content\": [*pending, {\"type\": \"text\", \"text\": user}]})\n            pending = []\n        else:\n            messages.append({\"role\": \"user\", \"content\": user})\n        answer, n, t0 = [], 0, time.time()\n        print(\"model> \", end=\"\", flush=True)\n        try:\n            in_think = False\n            for reasoning, content in stream(url, messages, think, a.max_tokens):\n                if reasoning:\n                    if not in_think:\n                        print(gray, end=\"\")\n                        in_think = True\n                    print(reasoning, end=\"\", flush=True)\n                if content:\n                    if in_think:\n                        print(reset + \"\\n\", end=\"\")\n                        in_think = False\n                    print(content, end=\"\", flush=True)\n                    answer.append(content)\n                n += 1\n            if in_think:\n                print(reset, end=\"\")\n        except OSError as e:\n            print(f\"\\n(could not reach the server at {url}: {e})\")\n            messages.pop()\n            continue\n        dt = time.time() - t0\n        print(f\"\\n{gray}[{n} chunks in {dt:.1f} s]{reset}\")\n        messages.append({\"role\": \"assistant\", \"content\": \"\".join(answer)})\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n### cmake/hip_backend.cmake\n```\n# Opt-in HIP configuration. Strata's CUDA-shaped kernels target wave32 RDNA3 / RDNA4 (64 KiB LDS per workgroup,\n# the signed dot4 instruction). CMake/compiler discovery stays machine-independent; pass CMAKE_HIP_COMPILER when it\n# is not on PATH.\nif(NOT DEFINED CMAKE_HIP_ARCHITECTURES OR CMAKE_HIP_ARCHITECTURES STREQUAL \"\")\n  set(CMAKE_HIP_ARCHITECTURES gfx1100 CACHE STRING \"Strata HIP target architecture(s), e.g. gfx1100 or gfx1100;gfx1201\")\nendif()\n# Validated on real cards: gfx1100 (RX 7900 XT / XTX) and gfx1201 (RX 9070 / 9070 XT, Radeon AI PRO R9700) by the\n# maintainers; gfx1101 (RX 7800 XT, #254) and gfx1200 (RX 9060 XT, #256) by their owners. gfx1102 (RX 7600) has the\n# same LDS limit and dot4 instruction and passed ctest (#192), but no model run has been reported yet.\nset(_strata_hip_validated gfx1100 gfx1201)\nset(_strata_hip_community gfx1101 gfx1200)\nset(_strata_hip_unvalidated gfx1102)\nset(STRATA_HIP_ARCH_LIST \"\")\nforeach(_arch IN LISTS CMAKE_HIP_ARCHITECTURES)\n  string(REGEX REPLACE \":.*$\" \"\" _base \"${_arch}\")      # gfx1100:xnack- -> gfx1100\n  if(_base IN_LIST _strata_hip_validated)\n  elseif(_base IN_LIST _strata_hip_community)\n    message(STATUS \"Strata HIP: ${_base} was validated by community reports (docs/AMD_HIP.md)\")\n  elseif(_base IN_LIST _strata_hip_unvalidated)\n    message(WARNING \"Strata HIP: ${_base} builds, but it is not validated on a real card yet; please report results\")\n  else()\n    message(FATAL_ERROR\n      \"Strata HIP supports wave32 gfx1100, gfx1101, gfx1200 and gfx1201 (unvalidated: ${_strata_hip_unvalidated}); \"\n      \"CMAKE_HIP_ARCHITECTURES is '${CMAKE_HIP_ARCHITECTURES}'\")\n  endif()\n  list(APPEND STRATA_HIP_ARCH_LIST \"${_base}\")\nendforeach()\nlist(REMOVE_DUPLICATES STRATA_HIP_ARCH_LIST)\nif(NOT STRATA_HIP_ARCH_LIST)\n  message(FATAL_ERROR \"Strata HIP: CMAKE_HIP_ARCHITECTURES is empty\")\nendif()\n# The compiled architectures reach the runtime device check (src/core/device.cu) as \"gfx1100,gfx1201\": a binary\n# carried to a card it has no code for stops at startup with a clear message instead of \"invalid device function\".\nstring(REPLACE \";\" \",\" STRATA_HIP_ARCHS \"${STRATA_HIP_ARCH_LIST}\")\n\nenable_language(HIP)\nfind_package(hip CONFIG REQUIRED)\nfind_package(hipblas CONFIG REQUIRED)\nfind_package(hipblaslt CONFIG QUIET)\n\nif(NOT TARGET hip::host)\n  message(FATAL_ERROR \"The ROCm hip CMake package did not provide hip::host\")\nendif()\nif(NOT TARGET roc::hipblas)\n  message(FATAL_ERROR \"The ROCm hipblas CMake package did not provide roc::hipblas\")\nendif()\nif(TARGET roc::hipblaslt)\n  set(STRATA_HIPBLASLT_AVAILABLE ON)\nelse()\n  set(STRATA_HIPBLASLT_AVAILABLE OFF)\n  message(STATUS \"Strata: hipBLASLt not found; solution-table dispatch is unavailable\")\nendif()\n\n# HIP's link step produces a PIE; make Strata and ggml objects PIC for the ROCm linker.\nset(CMAKE_POSITION_INDEPENDENT_CODE ON)\n\nset(STRATA_HIP_COMPAT_INCLUDE_DIR \"${CMAKE_CURRENT_SOURCE_DIR}/include/strata/hip_compat\")\nadd_library(strata_hip_runtime INTERFACE)\ntarget_include_directories(strata_hip_runtime BEFORE INTERFACE\n  \"${STRATA_HIP_COMPAT_INCLUDE_DIR}\" \"${CMAKE_CURRENT_SOURCE_DIR}/include\")\ntarget_compile_definitions(strata_hip_runtime INTERFACE STRATA_USE_HIP=1 \"STRATA_HIP_ARCHS=\\\"${STRATA_HIP_ARCHS}\\\"\")\ntarget_link_libraries(strata_hip_runtime INTERFACE hip::host)\nforeach(_language IN ITEMS CXX HIP)\n  target_compile_options(strata_hip_runtime INTERFACE\n    \"$<$<COMPILE_LANGUAGE:${_language}>:-include>\"\n    \"$<$<COMPILE_LANGUAGE:${_language}>:${STRATA_HIP_COMPAT_INCLUDE_DIR}/cuda_runtime.h>\")\nendforeach()\n\n# CMake does not infer HIP from Strata's existing CUDA-shaped .cu suffixes.\nfile(GLOB_RECURSE _strata_hip_sources CONFIGURE_DEPENDS\n  \"${CMAKE_CURRENT_SOURCE_DIR}/src/*.cu\"\n  \"${CMAKE_CURRENT_SOURCE_DIR}/bench/*.cu\"\n  \"${CMAKE_CURRENT_SOURCE_DIR}/tests/*.cu\")\nif(_strata_hip_sources)\n  set_source_files_properties(${_strata_hip_sources} PROPERTIES LANGUAGE HIP)\nendif()\nforeach(_source IN ITEMS tests/hip/intrinsics.cpp tests/hip/native_qsa_score.cpp)\n  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/${_source}\")\n    set_source_files_properties(\"${_source}\" PROPERTIES LANGUAGE HIP)\n  endif()\nendforeach()\n\nmessage(STATUS \"Strata: HIP enabled, arch ${STRATA_HIP_ARCHS}\")\n\n```\n### docs/AMD_HIP.md\n```\n# Experimental AMD HIP backend (gfx1100, gfx1101, gfx1200, gfx1201)\n\nThis is a Linux source build for the RX 7900 XT / XTX (RDNA3, gfx1100) and the\nRX 9070 / 9070 XT / Radeon AI PRO R9700 (RDNA4, gfx1201; see [RDNA4](#rdna4-gfx1201)). The RX 7800 XT / 7700 XT\n(gfx1101) and the RX 9060 XT (gfx1200) were validated by their owners (see [Community-validated\ncards](#community-validated-cards)). It is opt-in; the NVIDIA installer and CUDA build remain the default. Other AMD\narchitectures, wave64, Windows HIP, and mixed AMD/NVIDIA execution are outside this contribution.\n\nThe backend maps the CUDA-shaped runtime and BLAS calls to HIP/hipBLAS, uses\nRDNA3/RDNA4's signed integer dot instruction for quantized kernels, and supplies\nwave32 shuffle/packed-byte operations. CUDA-only QSA matrix instructions have\nan ordered FP32 fallback. Prefill supports both dequantization plus hipBLAS GEMM and opt-in HIP ggml MMQ.\nAn optional, calibrated hipBLASLt path accelerates dense projections (per-architecture tables in `tools/hip`).\nThis does not claim bit-identical model answers across backends. See\n[performance settings and evidence](AMD_HIP_PERFORMANCE.md).\n\n## Install with setup (recommended)\n\nOn Linux with an RX 7900 XT / XTX, RX 7800 XT / 7700 XT, RX 9060 XT, RX 9070 / 9070 XT or Radeon AI PRO R9700 and\nthe kernel's amdgpu driver (no ROCm install needed):\n\n```sh\n./setup.sh --backend hip\n```\n\n- **Detection:** setup finds the card through the kernel's KFD topology. Integrated Radeon GPUs are listed as not\n  supported. On a PC without an NVIDIA card Strata can use, `--backend hip` is chosen automatically.\n- **ROCm:** a system ROCm 7 in `/opt/rocm` (or `$ROCM_PATH`) with hipcc and hipBLAS is used when present. Otherwise\n  (or when it is older than 7.0) ROCm is installed into `.venv` from AMD's TheRock wheels (~10 GB, no sudo), pinned\n  to the version this backend was tested with, from the card family's index: `gfx110X-dgpu` for gfx1100 / gfx1101,\n  `gfx120X-all` for gfx1200 / gfx1201 (`STRATA_ROCM_VERSION` / `STRATA_ROCM_INDEX` override them).\n- **Engine:** compiled on your PC for the card's architecture (10-20 minutes, once; again after a `git pull` that\n  changes it, or when you pick a card of another architecture). This needs a C++ compiler and git\n  (`sudo apt install build-essential git`).\n- **hipBLASLt tuning table:** setup uses `tools/hip/<arch>-hipblaslt-<version>.txt` only when it matches both the\n  card's architecture and the installed hipBLASLt version (read from `hipblaslt-version.h`; 1.2.0 is `100200`).\n  Otherwise it says so and the prompt's dense matrix products use plain hipBLAS (slower prompts, same answers).\n  A table's solution ids are valid only for that pair, and the engine refuses any other table.\n- **Several cards:** setup takes one card (the one with the most VRAM, or `--gpu N`) unless you name more:\n  `./setup.sh --backend hip --gpus 1,0` splits the model's layers across them, the first one the main card (numbers\n  as setup lists them; `--gpus all` = every supported card, the most VRAM first). Every chosen card must be one of the\n  architectures above; the engine is compiled for each of them (cards of two families, e.g. gfx1100 + gfx1201, need\n  a system ROCm 7: AMD's wheels hold one family). A split pays only when no single card holds the model's experts\n  (see RDNA4 below).\n- **Limits for now:** no images, no calibration. The Monitor shows no GPU statistics.\n\nThe rest of setup is the same as on NVIDIA: the model download, the start script, the server.\n\n## Build\n\nRequirements: a working ROCm driver/runtime, HIP development headers and\ncompiler, hipBLAS and (for tuned dense prefill) hipBLASLt development files, CMake 3.24+, a C++20 host compiler, and Git.\nThe model still needs sufficient system RAM and fast SSD storage for its PLE\ntable. VRAM occupancy alone is not a throughput measurement.\n\n```sh\ncmake -S . -B build-hip \\\n  -DCMAKE_BUILD_TYPE=Release \\\n  -DSTRATA_ENABLE_HIP=ON -DSTRATA_ENABLE_CUDA=OFF \\\n  -DCMAKE_HIP_ARCHITECTURES=gfx1100\ncmake --build build-hip --target strata -j2\n```\n\n`CMAKE_HIP_ARCHITECTURES` is `gfx1100`, `gfx1101`, `gfx1200`, `gfx1201`, or a list such as `\"gfx1100;gfx1201\"`\n(one binary for both). gfx1102 (the same wave32, 64 KiB LDS and dot4 instruction) builds with a warning: it passed\nctest (#192) but no model run has been reported. At startup the engine and `strata-device` compare each GPU they use\n(`gcnArchName` up to the `:` feature suffix) with the architectures the binary was compiled for, and require\nwave32. A binary carried to another card stops with the card's name, its architecture and the build's list,\ninstead of failing later with \"invalid device function\".\n\nIf CMake cannot find the HIP compiler, add\n`-DCMAKE_HIP_COMPILER=/path/to/rocm/llvm/bin/clang++`. On the Fedora-family test\nhost this was `/usr/lib64/rocm/llvm/bin/clang++`. Use the compiler and libraries\nfrom the same ROCm installation. Do not enable both GPU backends in one build.\n\nNative IQ experts are enabled by default. CMake fetches the llama.cpp revision\npinned by this repository. For an offline build, point `STRATA_GGML_DIR` at a\ncheckout of that exact revision; using an arbitrary newer checkout changes the\ndependency being tested.\n\n## Model and serving configuration\n\nPrepare a supported model pack and its MTP runtime using the existing tools.\nFor OrcaRouter IQ3_XXS, follow [the explicit compatibility conversion](ORCA.md);\nthis backend does not change quantization, model licenses, or tokenizers.\nAdd `--experts-bin` to the `tools/iq_pack.py` command: mmap requires the pack's\n`experts.bin`, which the default native packing command does not emit. This\nconsumes additional disk space. Original GSQ-RCO IQ3_XXS uses shard 2 for PLE;\nOrca uses shard 1. Keep each model's own pack and tokenizer together.\n\nUse `build-hip/strata` as the executable in the server JSON. Select the AMD\ndevice with `ROCR_VISIBLE_DEVICES`/`HIP_VISIBLE_DEVICES` if necessary. Start with\na modest context and prefill chunk size before measuring larger workloads.\nKeep the PLE file on an SSD. Do not assume a configured context length proves\nsuccessful full-window inference.\n\nLarge pinned host allocations can fail on ROCm even when ordinary RAM is\navailable. The existing `--mmap-experts` path avoids allocating the full pinned\nexpert arena; it still depends on OS file-cache residency and may stall on\nstorage reads. It does not make SSD access equivalent to RAM.\n\nStarting args for the original GSQ-RCO IQ3_XXS model (replace the paths):\n\n```sh\nbuild-hip/strata --serve \\\n  --pack packs/iq3xxs \\\n  --native /path/to/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf \\\n  --ple-gguf /path/to/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf \\\n  --mmap-experts --expert-profile data/expert-profile.bin --expert-cache auto \\\n  --prefill 512 --spec 4 --spec-min-p 0.5 --mtp mtp/rt \\\n  --max-context 4096 --kv int8 --pool-workers 15 \\\n  --adapt-every 0 --pcie-frac 0 --vram-reserve-mib 1024\n```\n\n`--serve` is the engine's internal token protocol. For a browser or OpenAI API,\nput these args in the `args` array of the [server JSON example](ORCA.md#local-server),\nset `exe` to `build-hip/strata`, and use the matching pack's `tokenizer` directory.\nLaunch with `.venv/bin/python -m serve.server --engine strata --config strata-hip.json --port 8080`.\nThe worker count above was used on a 16-core CPU; measure it for your CPU.\nThe 4K context is a smoke-test starting point, not a model limit. The expert cache\nsizes itself automatically and leaves 1 GiB of VRAM headroom.\n\nThe installer supports this backend (see \"Install with setup\" above). The vision helper is NVIDIA-only for now.\nSetup installs one AMD card, or several with `--gpus` (the engine's layer split; see RDNA4 below).\n\n## RDNA4 (gfx1201)\n\nThe RX 9070 / 9070 XT and the Radeon AI PRO R9700 run the same kernels as gfx1100: wave32, 64 KiB of LDS per\nworkgroup, the signed dot4 instruction (`v_dot4_i32_iu8` through `__builtin_amdgcn_sudot4`) and a 100 MHz wall\nclock. The first report and patch came from doplxyz (#178). Validated on 2026-09-30 on doplxyz's test machine:\nan RX 9070 XT 16 GB and a Radeon AI PRO R9700 32 GB (both gfx1201), a Ryzen 9 3900X (16 threads, no AVX-512),\n47 GB RAM, Ubuntu 24.04 in a KVM/VFIO guest.\n\n- **Build:** complete HIP build with tests (`-DCMAKE_HIP_ARCHITECTURES=gfx1201 -DSTRATA_BUILD_TESTS=ON\n  -DSTRATA_PREFILL_MMQ=ON`), with the system ROCm 7.14 (hipBLASLt 1.4.1) and with setup's own path: TheRock\n  7.10.0a20251120 wheels from `gfx120X-all` (hipBLASLt 1.2.0) and `build_engine_hip`.\n- **ctest** (all 45 registered tests, R9700): 42 pass, `hip_prefill_hipblaslt_gemm` skips (no table), and two\n  fail for reasons outside the GPU: `ple_parity` needs the Q2_0 model fixture, `expert_multi_test` needs an\n  AVX-512 CPU. `hip_handoff` needed the volatile ring store: on gfx1201 a plain store to mapped pinned memory\n  stays in the GPU's L2 until the stream is synchronized.\n- **Arch check:** a gfx1100-only build stops on the gfx1201 card at startup with the message above (engine and\n  `strata-device`).\n- **End to end** (Coder IQ1_M, setup's arguments: `--expert-cache auto --prefill auto --spec 4 --spec-min-p 0.5`,\n  MTP, `--kv int8`, `--max-context 32768`; 128 greedy tokens, system ROCm 7.14, no hipBLASLt table). The answers\n  are coherent and the same on both cards. The live server smoke (`serve/server.py`: web page, models, props,\n  chat, prefix reuse, streaming, the Anthropic endpoint, a sampled code answer) passed 9/9 on each card.\n\n  | card | expert cache | peak VRAM | 4K prompt | 4K decode | 16K prompt | 16K decode |\n  |---|---|---|---|---|---|---|\n  | Radeon AI PRO R9700 32 GB | 12,288 slots, 23.4 GiB | 29.7 GiB | 982 tok/s | 45.5 tok/s | 1,402 tok/s | 48.3 tok/s |\n  | RX 9070 XT 16 GB | 4,931 slots, 9.4 GiB | 15.6 GiB | 782 tok/s | 30.8 tok/s | 1,235 tok/s | 35.4 tok/s |\n  | R9700, TheRock 7.10 wheels | 12,288 slots | | 957 tok/s | 44.2 tok/s | 1,284 tok/s | 43.9 tok/s |\n\n  The engine's resident memory was about 26 GB in every run. Since 0.1.31 `__byte_perm` is one `v_perm_b32` and the\n  packed byte subtracts/compare work on four lanes at once (#262, ttio2tech): decode +15% on the R9700 (46.0 -> 53.0\n  tok/s on a 4K prompt, 52.0 -> 60.5 warm) and +5-7% on the 9070 XT, prompts unchanged, the same tokens.\n- **hipBLASLt:** there is no gfx1201 table in `tools/hip`. A table calibrated on the R9700 at the engine's shapes\n  (hipBLASLt 1.4.1; 0.98-1.76x per GEMM over hipBLAS) changed the end-to-end prompt speed by 0-3%, within noise,\n  so none is shipped: on gfx1201 the plain hipBLAS path is already close.\n- **Both cards in one run (layer split, engine 0.1.30):** the config's `\"backend\": \"hip\", \"gpu\": [1, 0]` (R9700\n  first) runs through `serve/server.py` (setup writes it with `--gpus 1,0` since 0.1.31). Auto split put layers 0-27 on the R9700 and\n  28-47 on the 9070 XT. With every expert on the GPUs the split gives exactly the tokens of the R9700 alone (4K and\n  16K prompts); checkpoints on the split (second turn, rewind, a prompt sharing a prefix, a cancelled prompt\n  retried) give exactly the tokens of a fresh read. The conversation cache refuses a split at start (exit 2).\n  On this pair the split does not pay: the R9700 alone already holds all 12,288 expert pairs.\n\n  | run (the same session, warm) | 4K prompt | 16K prompt | decode |\n  |---|---|---|---|\n  | R9700 alone | 1,794 tok/s | 1,804 tok/s | 51-52 tok/s |\n  | R9700 + 9070 XT, auto split | 1,384 tok/s | 1,906 tok/s | 42-43 tok/s |\n  | RX 9070 XT alone | 1,016 tok/s | 1,519 tok/s | 38-40 tok/s |\n\n  A split is worth it when no single card holds the model's experts. Since 0.1.31 a split pins the whole expert\n  arena on Linux (the 8 GiB cap is for Windows/WSL2 only, #253): with an expert cache of 1,500 on the R9700 (most\n  experts streamed) the split read a 16K prompt at 1,803 tok/s instead of 1,287, with the same tokens in 5 + 5\n  starts. `\"split_skip_if_fits\": true` in the config (0.1.31, opt-in) runs such a pair on the first card alone when it\n  holds every profiled expert: with the R9700 first, 4K prompts 1,776 tok/s (split: 1,244) and decode ~60 tok/s\n  (split: ~51), the tokens of the R9700 alone (docs/MULTI_GPU.md).\n- **Known:** rarely (about 1 start in 10) a HIP run's greedy output differs from another start's at some token, on\n  one card or two and on engine 0.1.29 as well; not yet explained.\n- **Not validated:** images, long contexts beyond 16K, answer-quality benchmarks.\n\n## Community-validated cards\n\nRun by their owners, not on the maintainers' machines; setup accepts them like gfx1100 / gfx1201. No hipBLASLt table\nis shipped for them (make one with [Tuning table](#tuning-table) and compare the prompt speed with and without it).\n\n- **gfx1101, RX 7800 XT 16 GB** (jhohertz, #254; engine 0.1.29, Ryzen 9 5950X, 121 GiB RAM, system ROCm with\n  hipBLASLt 1.4.1): `./setup.sh --backend hip` detected the card and compiled the engine; `strata-device --selftest`\n  passed; ctest 30/32 (`ple_parity` needs the Q2_0 fixture, `platform_memory_test` the memlock limit). Coder IQ1_M,\n  64K context, MTP, with a table the owner calibrated: fresh prompts of 4K-9K tokens at 898-953 tok/s, decode\n  38-44 tok/s (128 tokens).\n- **gfx1200, RX 9060 XT 16 GB** (Efeisot, #256 after #176; engine 0.1.29, Ryzen 9 7950X, 64 GiB RAM, ROCm 7.2 with\n  hipBLASLt 1.2.2): ctest 32/32 (without `ple_parity` and `platform_memory_test`). Coder IQ1_M, greedy, MTP\n  `--spec 4 --spec-min-p 0.5`, with a table the owner calibrated:\n\n  | prompt | prompt speed | decode |\n  |---|---|---|\n  | 2,374 tokens | 540 tok/s | 27.1 tok/s (0.69 draft acceptance; 31.0 at 1.00) |\n  | 65K (`--kv int8 --kv-resident 65536 --prefill 16384`) | 748-753 tok/s | 26-40 tok/s by acceptance |\n  | 130K (the same flags) | 725 tok/s | - |\n\n  Greedy output was the same across runs. For comparison, llama.cpp's HIP build measured 20 tok/s decode and\n  450 tok/s prompt on that card.\n\n## Tuning table\n\nA hipBLASLt table holds solution ids that are valid only for one GPU architecture and one hipBLASLt version, so it\nis calibrated on the card with the ROCm the engine runs with. The shipped gfx1100 table's rows are the engine's\ndense GEMM shapes; to calibrate them for another card or version (a few minutes):\n\n```sh\ncmake --build build-hip --target tune_hipblaslt\nCASES=$(awk 'NR>2 {printf \" --case %s,%s,%s,%s,%s\", $1, $5, $2, $3, $4}' tools/hip/gfx1100-hipblaslt-100200.txt)\n./build-hip/tune_hipblaslt $CASES --tuning-out table.txt\n```\n\nThe file's second line names the architecture and version (`STRATA_HIPBLASLT_TUNING_V1 gfx1201 100401`); save it\nas `tools/hip/<arch>-hipblaslt-<version>.txt` for setup, or point `STRATA_HIPBLASLT_TUNING` at it. Compare the\nprompt speed with and without it before keeping it.\n\n## Original backend validation (PR #94)\n\nThe following is historical validation of the original backend, not a fresh\ntest count for this replacement. Current build/test evidence and performance\nlimits are recorded in [AMD_HIP_PERFORMANCE.md](AMD_HIP_PERFORMANCE.md).\n\nTested against upstream `c1e903310f211e6630780c3bd2038778c071c68d` (0.1.20),\nwith pinned llama.cpp `3cf03257f219afbe7334045ff7c6a06ac68c627d`.\nThe host has an RX 7900 XTX (24 GiB), Ryzen 9 7950X3D, 64 GiB system RAM,\nand Fedora-family Linux with ROCm 7.1.52802 / Clang 20. The original model used\nfor the smoke check was on mechanical RAID0; cold page faults were slow. Keep\nlatency-sensitive data on SSD and measure warm residency separately.\n\n- Complete HIP Release build, including the executable and parity targets.\n- All 25 tests selected by the command below passed on 2026-09-29.\n- Intrinsic parity includes signed packed-byte dot products and overflow.\n- CPU/GPU mapped-memory handoff covers delayed publication, changing payloads,\n  and repeated graph replay in both directions.\n- GR coverage includes the maximum eight-token fused batch and graph replay\n  after inputs change. Native QSA checks the scalar HIP fallback.\n- Q8_K quantization is byte-exact against the existing reference. HIP's\n  `__fmul_rn` can become ordinary multiplication; disabling contraction in\n  `quantize_act.cu` preserves the separately rounded product before the magic\n  rounding bias is added. CUDA's compile flags remain unchanged.\n- The mmap regression covers canonical and differing native layer sizes,\n  truncated/oversized files, lookup bounds, and reopening after errors.\n- CUDA 13 / GCC 15 / sm_89 executable build passed; GR, sampler, quantization,\n  and mmap tests passed on the same tree. This is a regression check, not a\n  claim of complete CUDA inference validation.\n- CPU-only `strata-plan` build passed without either GPU backend.\n- Real GSQ-RCO IQ3_XXS server smoke with mmap, the shipped expert profile,\n  automatic GPU cache, and MTP passed arithmetic, executable Python addition,\n  system-marker recall, and 1,170-token batched-prefill recall. All four requests\n  ended normally with correct answers; one engine process served them all.\n  The cache held 11,142 experts (18.08 GiB), with 874 MiB of VRAM free after\n  startup. These short checks do not establish a throughput or quality benchmark.\n\nBuild all targets before running the registered focused checks:\n\n```sh\ncmake --build build-hip -j2\nctest --test-dir build-hip --output-on-failure --timeout 60 \\\n  -E '^(ple_parity|platform_memory_test)$'\n```\n\n`ple_parity` requires an external model fixture. `platform_memory_test` requests\n256 MiB of locked memory; the test shell's 8 MiB memlock limit prevented that\ntest from passing. These are explicit exclusions, not skipped tests counted as\npasses. Additional unpublished upstream fixture suites are not covered.\n\nThe published performance table explicitly identifies the measured development\nsnapshot; it must not be read as a benchmark of every subsequent rebase. Vision, long-context stress, broad answer-quality\nequivalence, other AMD cards, and mixed-vendor inference are not validated here.\n\n```\n### docs/AMD_HIP_PERFORMANCE.md\n```\n# RX 7900 XTX support and performance evidence\n\nThis opt-in Linux `gfx1100` backend supersedes the initial support in\n[PR #94](https://github.com/Niko1221/Strata/pull/94). It retains HIP runtime and\nwave32 integer-dot compatibility, native mmap layout validation, and MTP, then\nadds HIP MMQ, optional calibrated dense hipBLASLt GEMM, native prefill batching,\nand the host-memory / SSD paths used by the measured configuration. HIP blocking\nexpert uploads use one reusable pinned staging buffer, including prompt-cache\nrefills, to avoid repeated pageable-source registrations.\n\n## Reproduce the configuration\n\nBuild instructions are in [AMD_HIP.md](AMD_HIP.md). Use the repository-pinned\nllama.cpp dependency; do not silently substitute another revision. Build with\n`STRATA_PREFILL_MMQ=ON` and use these runtime variables for the measured arm:\n\n```sh\nexport STRATA_PREFILL_MMQ=1\nexport STRATA_HIPBLASLT_TUNING=\"$PWD/tools/hip/gfx1100-hipblaslt-100100.txt\"\nexport STRATA_PREFILL_RING=96\nexport STRATA_IO_THREADS=32\n```\n\nThe supplied table is calibrated for gfx1100 and hipBLASLt version 100100.\nIt is not a universal ROCm tuning table. The runtime guards architecture,\nlibrary version and actual shape/stride/workspace requirements, falling back\nwhen a table entry is unavailable or incompatible. HIP MMQ is opt-in at runtime. Default CUDA selection is preserved.\n\nMeasured engine configuration: Orca Flash Next IQ3_XXS, native pack plus matching\nGGUF/tokenizer/template, `--mmap-experts --resident-cpu-experts`, fixed ranked\n`--expert-profile`, `--expert-cache auto`, `--prefill 8192`, `--spec 4`,\n`--spec-min-p 0.5`, matching MTP runtime, `--max-context 262144`, `--kv int8`,\n`--kv-resident 32768`, `--pool-workers 15`, `--adapt-every 0`, `--pcie-frac 0`,\nand `--vram-reserve-mib 1024`. Keep PLE on SSD.\n\n`--resident-cpu-experts` copies the complement of the static GPU cache to ordinary\nRAM. It requires mmap and a fixed expert profile. The slots the prompt path may\nborrow keep their experts in RAM too as far as the budget below allows (the rest\nuse the mapped fallback while borrowed and for their refill), and adaptive swaps\n(`--adapt-every`) exchange experts between VRAM and the RAM copy without reading\nthe file. The copy is pageable; `--resident-experts` (CUDA, chosen by setup)\npage-locks it and uses 4 GiB of headroom. Allocation needs sufficient available RAM;\non Linux this option requires readable standard cgroup-v2 mounts. For each\nfinite cgroup ancestor, the guard credits only `inactive_file` after subtracting\n`file_dirty` and `file_writeback`, capped by current usage; it remains bounded by\nthe ancestor limit and host `MemAvailable`, with 8 GiB headroom. This accounts\nfor reclaimable clean file cache but cannot reserve memory against concurrent\nsystem or process allocations.\nThe POSIX PLE path issues direct reads through a configurable worker pool.\n\nUse a dedicated idle server, restart it between arms, and capture its engine log:\n\n```sh\npython3 tools/hip/bench_prefill.py \\\n  --model MODEL_NAME --url http://127.0.0.1:8080 \\\n  --engine-log /path/to/engine.log --label candidate --output candidate.json\n```\n\nThe script uses the same synthetic source prompts and request order as the\nreported measurements: a small warmup, then 140/280/140/280 functions, with one\nfollow-up after each fresh prompt. It enforces zero reused tokens for the fresh\nprompts and records prefill, decode, wall time and stop reason. It requires the\nunbuffered log to contain exactly one completed timing record per request. The\n128-token output cap is intentional for throughput measurement, not task success.\nNever use cancelled-request timing lines as throughput evidence.\n\n## Final revision benchmark\n\nMeasured on 2026-09-29, source revision `9568e78da663e6b224ab96d57baf450717b36e73`.\nHIP executable SHA-256: `705f5925a788bc227bad72abfb5466032e0879d752fea9afc3eb32051b35182b`.\nThe control and candidate below were both measured anew in this session; no\nhistorical benchmark values are mixed\n\nTask: explain what the last file above does, then propose one concrete improvement as a unified diff. This is an offline task with no tools: write the explanation and diff directly in your reply using only the files supplied here. If the last file is truncated, work from the visible portion. Provide a detailed answer of at least 500 words, including the explanation, complete diff, and how to verify the change."
+      "content": "Repository files:\n\n### CMakeLists.txt\n```\n﻿# Strata Engine - top-level build (P1.S1).\n#\n# Targets (phase-1 Ă‚Â§P1.S1): `strata_artifact` (no CUDA dependency), `tests`.  `strata_plan` and the C++\n# `strata-pack` are added when their sources exist - a target with no sources would make the build graph\n# claim something the tree does not have, which is worse than an absent target.\n#\n# CUDA targets arrive in Phase 2.  The kernels need sm_80 or newer (tf32 mma, bf16 math) and the guard\n# below refuses anything older: silently building for a pre-Ampere arch would produce a binary that runs\n# and is wrong about its own performance, which is the worst of both outcomes.\ncmake_minimum_required(VERSION 3.24)\nproject(strata VERSION 0.1.31 LANGUAGES CXX)\nadd_compile_definitions(STRATA_VERSION=\"${PROJECT_VERSION}\")\n# issue #31: release builds keep a PDB beside the exe (not shipped in it), so a minidump from a stalled engine can\n# be read back to the exact source line\nif(MSVC AND CMAKE_BUILD_TYPE STREQUAL \"Release\")\n  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:/Zi>)\n  add_link_options(/DEBUG /OPT:REF /OPT:ICF)\nendif()\n\n# The prebuilt release (setup.py downloads it, so users need no compiler): ggml's CPU backend for any AVX2 CPU\n# instead of this machine's (Strata's own AVX-512 kernels are per-file and chosen at run time either way), and\n# the MSVC runtime linked in, so no Visual C++ redistributable is needed.\noption(STRATA_PORTABLE \"build for other PCs: AVX2 baseline, static MSVC runtime\" OFF)\nif(STRATA_PORTABLE AND MSVC)\n  set(CMAKE_MSVC_RUNTIME_LIBRARY \"MultiThreaded\")\nendif()\n\nset(CMAKE_CXX_STANDARD 20)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nset(CMAKE_CXX_EXTENSIONS OFF)\nif(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)\n  set(CMAKE_BUILD_TYPE Release CACHE STRING \"\" FORCE)\nendif()\n\noption(STRATA_ENABLE_CUDA \"Build the CUDA targets (Phase 2+)\" OFF)\noption(STRATA_ENABLE_HIP \"Build the HIP targets for wave32 AMD GPUs (gfx1100, gfx1201)\" OFF)\noption(STRATA_PREFILL_MMQ \"Build the optional GGML MMQ prefill path for HIP\" OFF)\nif(STRATA_PREFILL_MMQ AND NOT STRATA_ENABLE_HIP)\n  message(FATAL_ERROR \"STRATA_PREFILL_MMQ requires STRATA_ENABLE_HIP=ON\")\nendif()\nif(STRATA_ENABLE_CUDA AND STRATA_ENABLE_HIP)\n  message(FATAL_ERROR \"STRATA_ENABLE_CUDA and STRATA_ENABLE_HIP are separate backends; enable only one\")\nendif()\nif(STRATA_ENABLE_HIP)\n  include(cmake/hip_backend.cmake)\nendif()\n# The test suite and the micro benchmarks live in tests/ and bench/micro/, which the published source leaves out.\nset(_strata_tests_default OFF)\nif(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/tests/CMakeLists.txt AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/bench/micro)\n  set(_strata_tests_default ON)\nendif()\noption(STRATA_BUILD_TESTS \"Build the test suite\" ${_strata_tests_default})\noption(STRATA_BUILD_CONVERSATION_TESTS \"Build standalone conversation cache tests\" OFF)\noption(STRATA_WERROR \"Treat compiler warnings as errors\" OFF)\n\nif(STRATA_BUILD_CONVERSATION_TESTS)\n  enable_testing()\n  add_executable(conversation_cache_test src/core/conversation_cache_test.cpp)\n  target_include_directories(conversation_cache_test PRIVATE include)\n  add_test(NAME conversation_cache_test COMMAND conversation_cache_test)\n  add_executable(conversation_memory_test src/core/conversation_memory_test.cpp src/core/conversation_memory.cpp)\n  target_include_directories(conversation_memory_test PRIVATE include)\n  add_test(NAME conversation_memory_test COMMAND conversation_memory_test)\nendif()\n\nif(STRATA_ENABLE_CUDA)\n  enable_language(CUDA)\n  # `enable_language(CUDA)` gives the .cu compile rules but NOT the imported targets, so `CUDA::cudart` has to\n  # be brought in explicitly for the host-side tests that call cudaMalloc themselves.\n  find_package(CUDAToolkit REQUIRED)\n  option(STRATA_EXPERIMENTAL_SM60 \"community build for GPUs below compute capability 7.5: Pascal sm_60, Volta sm_70 (#236)\" OFF)\n  if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)\n    set(CMAKE_CUDA_ARCHITECTURES 120 CACHE STRING \"CUDA architectures\" FORCE)\n  endif()\n  foreach(_a IN LISTS CMAKE_CUDA_ARCHITECTURES)\n    string(REGEX REPLACE \"-.*$\" \"\" _base \"${_a}\")     # 120-real / 120-virtual are still 120\n    # Turing port: developed and measured on sm_120 (RTX 50); the tf32 mma in the QSA scorer has a\n    # portable fp32-FMA fallback, so RTX 20 (75), 30 (86), RTX 40 (89) and RTX 50 (120) build too.\n    # Pre-sm_75 is refused.\n    if(_base STREQUAL \"native\" OR _base STREQUAL \"all\" OR _base STREQUAL \"all-major\")\n      continue()\n    endif()\n    # STRATA_EXPERIMENTAL_SM60: a Pascal (sm_60, GP100-class) or Volta (sm_70, V100 / Titan V, #236) build.\n    # These sit below every architecture the kernels were written for, so two intrinsics are replaced below\n    # their arch - `__dp4a` (6.1+) and `__nanosleep` (7.0+) - in include/strata/kernels/dp4a.hpp, which is\n    # bit-exact for the first and merely a shorter pause for the second (sm_70 has both).  Community-tested,\n    # not in the ready-made engine; RTX 20/30/40/50 cards must use the release engine instead.  It needs a CUDA\n    # 12.x toolkit: CUDA 13 dropped sm_60 and sm_70 (nvcc fails CMake's compiler test with \"compute_70\").\n    if(_base LESS 75 AND NOT STRATA_EXPERIMENTAL_SM60)\n      message(FATAL_ERROR\n        \"Strata needs an NVIDIA GPU of compute capability 7.5 or newer (RTX 20 / 30 / 40 / 50 series), but \"\n        \"CMAKE_CUDA_ARCHITECTURES is '${CMAKE_CUDA_ARCHITECTURES}'.  (A Pascal sm_60 or Volta sm_70 build is \"\n        \"-DSTRATA_EXPERIMENTAL_SM60=ON; upstream does not support it.)\")\n    endif()\n    if(_base LESS 60)\n      message(FATAL_ERROR \"CMAKE_CUDA_ARCHITECTURES '${CMAKE_CUDA_ARCHITECTURES}': even the experimental build \"\n                          \"needs compute capability 6.0 (sm_60) or newer\")\n    endif()\n    # #220 / #224: RTX 50 engines built with CUDA 12.8 crashed in the prompt path on Linux (13.0 and newer did not)\n    if(_base GREATER_EQUAL 120 AND CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.0)\n      message(WARNING \"Building for sm_${_base} (RTX 50) with CUDA ${CMAKE_CUDA_COMPILER_VERSION}: engines built with \"\n                      \"CUDA 12.8 crashed on long prompts on these cards (issues #220, #224). Use CUDA 13.0 or newer.\")\n    endif()\n  endforeach()\n  message(STATUS \"Strata: CUDA enabled, arch ${CMAKE_CUDA_ARCHITECTURES}\")\n  set(_strata_gpu_runtime_target CUDA::cudart)\n  set(_strata_gpu_blas_target CUDA::cublas)\n  set(_strata_gpu_include_directories ${CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES})\nelseif(STRATA_ENABLE_HIP)\n  set(_strata_gpu_runtime_target strata_hip_runtime)\n  set(_strata_gpu_blas_target roc::hipblas)\n  set(_strata_gpu_include_directories ${STRATA_HIP_COMPAT_INCLUDE_DIR})\nendif()\n\n# Warnings live on an INTERFACE target the project's own code links, NOT in add_compile_options: applied\n# globally they would also hit FetchContent'd Catch2, whose -W4 warnings are not this project's to fix and\n# whose /WX failures would be indistinguishable from our own.\n#\n# Every flag is guarded by COMPILE_LANGUAGE:CXX.  Without that guard nvcc receives bare `/W4 /utf-8` and dies\n# with \"A single input file is required for a non-link phase\" - it parses them as inputs rather than host\n# flags.  Host flags for CUDA must go through -Xcompiler, which is what COMPILE_LANGUAGE:CUDA does below.\nadd_library(strata_warnings INTERFACE)\ntarget_compile_options(strata_warnings INTERFACE\n  $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:/W4>\n  $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:/utf-8>\n  $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<NOT:$<CXX_COMPILER_ID:MSVC>>>:-Wall>\n  $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<NOT:$<CXX_COMPILER_ID:MSVC>>>:-Wextra>\n  $<$<AND:$<COMPILE_LANGUAGE:CUDA>,$<CXX_COMPILER_ID:MSVC>>:-Xcompiler=/W4>\n  $<$<COMPILE_LANGUAGE:HIP>:-Wall>\n  $<$<COMPILE_LANGUAGE:HIP>:-Wextra>)\nif(STRATA_WERROR)\n  target_compile_options(strata_warnings INTERFACE\n    $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:/WX>\n    $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<NOT:$<CXX_COMPILER_ID:MSVC>>>:-Werror>\n    $<$<COMPILE_LANGUAGE:HIP>:-Werror>)\nendif()\n\n# ---- strata_artifact -------------------------------------------------------\n# Header-only, and that is a deliberate property rather than an unfinished split: the GGUF reader and the\n# scalar dequantizers hold no state worth hiding, and a header-only boundary cannot introduce a\n# duplicate-symbol or missing-declaration bug into code that is already validated against the real artifact.\nadd_library(strata_artifact INTERFACE)\ntarget_include_directories(strata_artifact INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)\ntarget_link_libraries(strata_artifact INTERFACE strata_warnings)\n\nadd_executable(strata-gguf src/artifact/gguf_reader.cpp)\ntarget_link_libraries(strata-gguf PRIVATE strata_artifact)\n\nadd_executable(strata-dequant src/artifact/dequant.cpp)\ntarget_link_libraries(strata-dequant PRIVATE strata_artifact)\n# this file is now nothing but the CLI entry point, and its inherited guard spells that as a \"selftest\"\ntarget_compile_definitions(strata-dequant PRIVATE STRATA_DEQUANT_SELFTEST)\nif(STRATA_BUILD_TESTS)\n  # the reader refuses a duplicate tensor name at open, naming it (a synthetic GGUF: no model, no GPU)\n  add_executable(gguf_reader_test src/artifact/gguf_reader_test.cpp)\n  target_link_libraries(gguf_reader_test PRIVATE strata_artifact)\n  add_test(NAME gguf_reader_test COMMAND gguf_reader_test)\n  # a split model's shards and their joint view: missing shard, split keys, duplicates, truncation (synthetic)\n  add_executable(gguf_split_test tests/core/gguf_split_test.cpp)\n  target_link_libraries(gguf_split_test PRIVATE strata_artifact)\n  add_test(NAME gguf_split_test COMMAND gguf_split_test)\nendif()\n\n# ---- strata_plan ----------------------------------------------------------\n# Also header-only.  A \"planner\" that hides state would be one whose decision is not inspectable, and the\n# whole point of P1.S9 is that the decision is arithmetic you can check by hand.\nadd_library(strata_plan INTERFACE)\ntarget_include_directories(strata_plan INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)\ntarget_link_libraries(strata_plan INTERFACE strata_warnings)\n\nadd_executable(strata-plan src/plan/plan_main.cpp)\ntarget_link_libraries(strata-plan PRIVATE strata_plan)\n\n# ---- strata_core (GPU runtime) ---------------------------------------------\n# Only built when a GPU backend is on, so the Phase 1 targets keep working without a toolkit.\nif(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)\n  add_library(strata_core STATIC src/core/device.cu src/core/pinned.cu src/platform/memory.cpp src/core/graph.cpp src/core/weights.cpp\n                               src/core/layout.cpp)\n  target_include_directories(strata_core PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n  if(STRATA_ENABLE_CUDA AND STRATA_EXPERIMENTAL_SM60)\n    # the runtime device check (src/core/device.cu) admits the cards this build was made for (#236)\n    target_compile_definitions(strata_core PRIVATE STRATA_EXPERIMENTAL_SM60=1)\n  endif()\n  # The selected runtime is PUBLIC because graph.cpp is a HOST translation unit that calls cudaGraphLaunch and\n  # cudaEventQuery: the .cu sources get cudart through the CUDA language rules, a .cpp does not, and the\n  # linker error (\"unresolved external symbol cudaGraphInstantiate\") names the function rather than the cause.\n  target_link_libraries(strata_core PUBLIC strata_plan strata_warnings ${_strata_gpu_runtime_target})\n\n  add_executable(strata-device src/core/device_main.cpp)\n  target_link_libraries(strata-device PRIVATE strata_core)\n\n  add_executable(strata-load src/core/load_main.cpp)\n  target_link_libraries(strata-load PRIVATE strata_core strata_kernels)\n\n  add_executable(strata-concurrent src/core/concurrent_main.cpp)\n  target_include_directories(strata-concurrent PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(strata-concurrent PRIVATE strata_core strata_kernels ${_strata_gpu_runtime_target})\n\n  add_executable(strata-overlap src/core/overlap_main.cpp)\n  # a .cpp that calls cudaMemcpyAsync itself needs the toolkit headers and cudart explicitly\n  target_include_directories(strata-overlap PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(strata-overlap PRIVATE strata_core strata_kernels ${_strata_gpu_runtime_target})\n\n  # The load test needs the 34 GB artifact, so it is registered ONLY where that artifact exists.  A test that\n  # silently skips is a test that stops running; an absent registration is visible in the configure output.\n  if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/pack/full/experts.bin)\n    add_test(NAME expert_arena_load\n             COMMAND strata-load --file ${CMAKE_CURRENT_SOURCE_DIR}/pack/full/experts.bin --layers 1)\n    set_tests_properties(expert_arena_load PROPERTIES PASS_REGULAR_EXPRESSION \"per-layer checksums\")\n  else()\n    message(STATUS \"strata: pack/full/experts.bin absent - the expert arena load test is NOT registered\")\n  endif()\n\n  # ---- strata_kernels (P2.S2) ----\n  # Naive first, each with a parity test against a reference that was itself validated against ggml.  The\n  # kernels link `strata_artifact` for the scalar dequantizers, because using the VALIDATED scalar path as the\n  # reference is the whole point - a kernel checked against another copy of itself proves nothing.\n  add_library(strata_kernels STATIC src/kernels/cuda/dequant_s2.cu src/kernels/cuda/s2_gemv.cu\n                          src/kernels/cuda/s_gemv.cu\n                          src/kernels/cuda/s2_gemv_quads.cu\n                          src/kernels/cuda/s2_gemv_fast.cu\n                          src/kernels/cuda/router_top10.cu\n                          src/kernels/cuda/quantize_act.cu\n                          src/kernels/cuda/rope.cu\n                          src/kernels/cuda/sampler.cu\n                          src/kernels/cuda/s2_gemv_q8.cu\n    src/kernels/cuda/s2_expert_grouped.cu\n                          src/kernels/cuda/shared_expert.cu\n                          src/kernels/cuda/gr.cu\n                          src/kernels/cuda/gdn.cu\n                          src/kernels/cuda/qsa.cu\n                          src/kernels/cuda/elementwise.cu\n                          src/kernels/cuda/bf16_gemv.cu\n                          src/kernels/cuda/native_mmvq.cu\n                          src/kernels/cuda/native_bf16.cu\n                          src/kernels/cuda/native_gr_norm.cu\n                          src/kernels/cuda/native_moe.cu\n                          src/kernels/cuda/native_gdn.cu\n                          src/kernels/cuda/native_gr_postops.cu\n                          src/kernels/cuda/native_router.cu\n                          src/kernels/cuda/native_gdn_preprocess.cu\n                          src/kernels/cuda/native_qsa.cu\n                          src/kernels/cuda/native_rope.cu\n                          src/kernels/cuda/native_ple_postops.cu\n                          src/kernels/cuda/native_flash_attn.cu\n                          src/kernels/cuda/native_qsa_indexer.cu\n                          src/kernels/cuda/native_qsa_score.cu\n                          src/kernels/cuda/ple.cu\n                          src/kernels/cuda/kv_q8.cu\n                          src/kernels/cuda/kv_stream.cu\n                          src/kernels/cuda/kv_q4.cu\n                          src/kernels/cuda/fused_gr.cu\n                          src/kernels/cuda/cvec.cu\n                          src/kernels/cuda/qsa_decode_attn.cu\n                          src/kernels/cuda/qsa_prompt_attn.cu\n                          src/kernels/cuda/fused_gdn.cu\n                          src/kernels/cuda/dequant_bf16.cu\n                          src/kernels/cuda/qsa_select.cu\n                          src/kernels/cuda/verify_kernels.cu\n                          src/kernels/cuda/iq_kernels.cu\n                          src/kernels/ngram.cpp\n                          src/ngram/ple_reader.cpp\n                          src/platform/direct_file.cpp)\n  target_link_libraries(strata_kernels PUBLIC strata_core strata_artifact)\n  # perf-review D-1: the tensor-core prompt attention vs the FP32 kernel and FP64 (GPU, synthetic, no model); with\n  # the tests, or alone with -DSTRATA_PARITY_PROMPT_ATTN=ON.  CUDA only: HIP compiles the tensor-core kernel out.\n  if((STRATA_BUILD_TESTS OR STRATA_PARITY_PROMPT_ATTN) AND STRATA_ENABLE_CUDA)\n    add_executable(qsa_prompt_attn_parity src/kernels/qsa_prompt_attn_parity.cpp)\n    target_include_directories(qsa_prompt_attn_parity PRIVATE ${CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES})\n    target_link_libraries(qsa_prompt_attn_parity PRIVATE strata_kernels CUDA::cudart)\n  endif()\n  # plan v0.3 P6: llama.cpp's block layouts and codebook grids for the i-quant formats (MIT, third_party/ggml)\n  target_include_directories(strata_kernels PRIVATE third_party/ggml)\n  # Match the pinned llama.cpp CUDA arithmetic contract for this adapter only.\n  if(STRATA_ENABLE_CUDA)\n    set_source_files_properties(src/kernels/cuda/native_mmvq.cu src/kernels/cuda/native_bf16.cu\n      src/kernels/cuda/native_gr_norm.cu\n      src/kernels/cuda/native_moe.cu\n      src/kernels/cuda/native_gdn.cu\n      src/kernels/cuda/native_gr_postops.cu\n      src/kernels/cuda/native_router.cu\n      src/kernels/cuda/native_gdn_preprocess.cu\n      src/kernels/cuda/native_qsa.cu\n      src/kernels/cuda/native_rope.cu\n      src/kernels/cuda/native_ple_postops.cu\n      src/kernels/cuda/native_flash_attn.cu\n      src/kernels/cuda/native_qsa_indexer.cu\n      src/kernels/cuda/native_qsa_score.cu\n      PROPERTIES COMPILE_OPTIONS \"--use_fast_math\")\n  elseif(STRATA_ENABLE_HIP)\n    # Keep Q8_K's multiply and magic-bias rounding as separate FP32 operations on HIP; contraction to an\n    # FMA changes tie results. The embedding gather also relies on separately rounded operations.\n    set_source_files_properties(src/kernels/cuda/elementwise.cu src/kernels/cuda/quantize_act.cu\n      PROPERTIES COMPILE_OPTIONS \"-ffp-contract=off\")\n  endif()\n\n  set(STRATA_ORACLE_SOURCE_DIR \"\" CACHE PATH \"Pinned llama.cpp source for independent CUDA parity tests\")\n  set(STRATA_ORACLE_BUILD_DIR \"\" CACHE PATH \"Matching existing shared llama.cpp build\")\n  # This oracle is a CUDA ggml build; do not pull CUDA libraries into a HIP build.\n  if(STRATA_ENABLE_CUDA AND STRATA_ORACLE_SOURCE_DIR AND STRATA_ORACLE_BUILD_DIR)\n    foreach(parity IN ITEMS native_mmvq native_bf16 native_shared native_gr_norm native_moe native_gdn native_gr_postops native_router native_gdn_preprocess native_gdn_pipeline native_qsa native_rope native_ple_postops native_flash_attn native_qsa_indexer native_qsa_score)\n    add_executable(${parity}_parity bench/micro/${parity}_parity.cpp)\n    target_include_directories(${parity}_parity PRIVATE\n      \"${STRATA_ORACLE_SOURCE_DIR}/ggml/include\" ${_strata_gpu_include_directories})\n    target_compile_definitions(${parity}_parity PRIVATE GGML_SHARED GGML_BACKEND_SHARED)\n    target_link_libraries(${parity}_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n    foreach(component IN ITEMS ggml ggml-base ggml-cpu ggml-cuda)\n      string(REPLACE \"-\" \"_\" variable \"STRATA_ORACLE_${component}\")\n      find_library(${variable} NAMES ${component} PATHS\n        \"${STRATA_ORACLE_BUILD_DIR}/ggml/src\" \"${STRATA_ORACLE_BUILD_DIR}/ggml/src/${component}\"\n        \"${STRATA_ORACLE_BUILD_DIR}/bin\" NO_DEFAULT_PATH REQUIRED)\n      target_link_libraries(${parity}_parity PRIVATE \"${${variable}}\")\n    endforeach()\n    add_test(NAME ${parity}_parity COMMAND ${parity}_parity --selftest)\n    if(WIN32)\n      set_tests_properties(${parity}_parity PROPERTIES\n        ENVIRONMENT_MODIFICATION \"PATH=path_list_prepend:${STRATA_ORACLE_BUILD_DIR}/bin\")\n    endif()\n    endforeach()\n  endif()\n\n  # ---- strata_engine (P2.S5) -----------------------------------------------------\n  # The COMPOSED layer lives here and not in `strata_core`, because it calls kernels and `strata_kernels`\n  # already links `strata_core` - putting `gdn_layer` in core would make the two mutually dependent.  A third\n  # library is the honest shape of the dependency graph: core knows about devices and weights, kernels know\n  # about arithmetic, and this one knows the ORDER the arithmetic happens in.\n  add_library(strata_engine STATIC src/core/layer.cpp src/core/session.cpp src/core/expert_source.cpp src/core/remote_experts.cpp\n    src/core/expert_cache.cpp src/core/native_head.cpp src/core/native_dense.cpp src/core/verify.cpp src/core/mtp.cpp\n    src/core/conversation_snapshot.cpp src/core/conversation_state.cpp src/core/conversation_memory.cpp)\n  target_include_directories(strata_engine PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n  target_link_libraries(strata_engine PUBLIC strata_core strata_kernels strata_kernels_cpu ${_strata_gpu_runtime_target})\n  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/core/file_expert_source_test.cpp\")\n    enable_testing()\n    add_executable(file_expert_source_test tests/core/file_expert_source_test.cpp)\n    target_link_libraries(file_expert_source_test PRIVATE strata_engine)\n    add_test(NAME file_expert_source_test COMMAND file_expert_source_test)\n    set_tests_properties(file_expert_source_test PROPERTIES TIMEOUT 60)\n  endif()\n  if(STRATA_BUILD_TESTS AND STRATA_NATIVE_EXPERTS)\n    # native_experts.txt v2-v4 (the real packs' copies and the per-role shard column) and the arena filled from\n    # synthetic GGUF shards at the real expert dimensions\n    add_executable(expert_layout_test tests/core/expert_layout_test.cpp)\n    target_link_libraries(expert_layout_test PRIVATE strata_engine)\n    add_test(NAME expert_layout_test COMMAND expert_layout_test ${CMAKE_CURRENT_SOURCE_DIR}/tests/data/native_experts)\n    set_tests_properties(expert_layout_test PROPERTIES TIMEOUT 60)\n  endif()\n  if(STRATA_BUILD_CONVERSATION_TESTS)\n    add_executable(conversation_snapshot_test src/core/conversation_snapshot_test.cpp)\n    target_link_libraries(conversation_snapshot_test PRIVATE strata_engine)\n    add_test(NAME conversation_snapshot_test COMMAND conversation_snapshot_test)\n    set_tests_properties(conversation_snapshot_test PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 120)\n    add_executable(conversation_validation_test src/core/conversation_validation_test.cpp)\n    target_link_libraries(conversation_validation_test PRIVATE strata_engine)\n    add_test(NAME conversation_validation_test COMMAND conversation_validation_test)\n    set_tests_properties(conversation_validation_test PROPERTIES ENVIRONMENT \"CUDA_VISIBLE_DEVICES=-1\" TIMEOUT 120)\n    if(NOT STRATA_ENABLE_HIP AND UNIX AND NOT APPLE AND CMAKE_CXX_COMPILER_ID MATCHES \"GNU|Clang\")\n      add_executable(conversation_transfer_test src/core/conversation_validation_test.cpp)\n      target_compile_definitions(conversation_transfer_test PRIVATE CONVERSATION_TEST_TRANSFERS)\n      target_link_options(conversation_transfer_test PRIVATE\n        -Wl,--wrap=cudaMemcpy -Wl,--wrap=cudaDeviceSynchronize -Wl,--wrap=cudaGetLastError)\n      target_link_libraries(conversation_transfer_test PRIVATE strata_engine)\n      add_test(NAME conversation_transfer_test COMMAND conversation_transfer_test)\n      set_tests_properties(conversation_transfer_test PROPERTIES ENVIRONMENT \"CUDA_VISIBLE_DEVICES=-1\" TIMEOUT 120)\n    endif()\n  endif()\n\n  # `strata generate` (P2.S6).  The FIRST user-facing program: everything under it is a component, and this is\n  # what composes them into a token.  No tokenizer - the prompt arrives as ids - because Gate C1 compares logits\n  # against llama.cpp on the SAME ids and a tokenizer on one side of that comparison is a second variable.\n  # plan v0.3 P5: batched prompt processing (tensor-core GEMMs through cuBLAS).\n  add_library(strata_prefill STATIC src/prefill/gemm.cu src/prefill/kernels.cu src/prefill/prefill.cpp)\n  target_include_directories(strata_prefill PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_strata_gpu_include_directories})\n  target_link_libraries(strata_prefill PUBLIC strata_engine ${_strata_gpu_blas_target} ${_strata_gpu_runtime_target})\n  if(STRATA_ENABLE_HIP AND STRATA_HIPBLASLT_AVAILABLE)\n    target_compile_definitions(strata_prefill PRIVATE STRATA_HIPBLASLT_AVAILABLE=1)\n    target_link_libraries(strata_prefill PRIVATE roc::hipblaslt)\n\n    add_executable(tune_hipblaslt tools/hip/tune_hipblaslt.cpp)\n    target_link_libraries(tune_hipblaslt PRIVATE hip::host roc::hipblas roc::hipblaslt)\n  endif()\n\n  add_executable(strata src/program/generate.cpp)\n  target_include_directories(strata PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(strata PRIVATE strata_engine strata_prefill strata_spec ${_strata_gpu_runtime_target})\n\n  if(STRATA_ENABLE_HIP)\n    enable_testing()\n    set(_strata_hip_tests)\n    add_executable(hip_expert_cache_staging tests/hip/expert_cache_staging.cpp)\n    target_link_libraries(hip_expert_cache_staging PRIVATE strata_engine)\n    add_test(NAME hip_expert_cache_staging COMMAND hip_expert_cache_staging)\n    list(APPEND _strata_hip_tests hip_expert_cache_staging)\n    if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/hip/intrinsics.cpp\")\n      add_executable(hip_intrinsics tests/hip/intrinsics.cpp)\n      target_link_libraries(hip_intrinsics PRIVATE strata_hip_runtime)\n      add_test(NAME hip_intrinsics COMMAND hip_intrinsics)\n      list(APPEND _strata_hip_tests hip_intrinsics)\n    endif()\n    if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/hip/handoff.cpp\")\n      add_executable(hip_handoff tests/hip/handoff.cpp)\n      target_link_libraries(hip_handoff PRIVATE strata_kernels strata_hip_runtime)\n      add_test(NAME hip_handoff COMMAND hip_handoff)\n      list(APPEND _strata_hip_tests hip_handoff)\n    endif()\n    if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/hip/native_qsa_score.cpp\")\n      add_executable(hip_native_qsa_score tests/hip/native_qsa_score.cpp)\n      target_link_libraries(hip_native_qsa_score PRIVATE strata_kernels strata_hip_runtime)\n      add_test(NAME hip_native_qsa_score COMMAND hip_native_qsa_score)\n      list(APPEND _strata_hip_tests hip_native_qsa_score)\n    endif()\n    if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/hip/prefill_native_batch.cpp\")\n      add_executable(hip_prefill_native_batch tests/hip/prefill_native_batch.cpp)\n      target_link_libraries(hip_prefill_native_batch PRIVATE strata_kernels strata_hip_runtime)\n      add_test(NAME hip_prefill_native_batch COMMAND hip_prefill_native_batch)\n      list(APPEND _strata_hip_tests hip_prefill_native_batch)\n    endif()\n    if(STRATA_HIPBLASLT_AVAILABLE AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/hip/prefill_hipblaslt_gemm.cpp\")\n      add_executable(hip_prefill_hipblaslt_gemm tests/hip/prefill_hipblaslt_gemm.cpp)\n      target_include_directories(hip_prefill_hipblaslt_gemm PRIVATE \"${CMAKE_CURRENT_SOURCE_DIR}/src/prefill\")\n      target_link_libraries(hip_prefill_hipblaslt_gemm PRIVATE strata_prefill strata_hip_runtime roc::hipblaslt roc::hipblas)\n      add_test(NAME hip_prefill_hipblaslt_gemm COMMAND hip_prefill_hipblaslt_gemm)\n      set_tests_properties(hip_prefill_hipblaslt_gemm PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77)\n      list(APPEND _strata_hip_tests hip_prefill_hipblaslt_gemm)\n    endif()\n    if(_strata_hip_tests)\n      set_tests_properties(${_strata_hip_tests} PROPERTIES TIMEOUT 60)\n    endif()\n    if(TARGET hip_prefill_native_batch)\n      set_tests_properties(hip_prefill_native_batch PROPERTIES TIMEOUT 120)\n    endif()\n    if(TARGET hip_prefill_hipblaslt_gemm)\n      set_tests_properties(hip_prefill_hipblaslt_gemm PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77)\n    endif()\n  endif()\n\n  add_executable(dequant_s2_parity src/kernels/dequant_s2_parity.cpp)\n  # The tests are HOST C++ files that call cudaMalloc/cudaMemcpy themselves, so they need the toolkit headers\n  # and cudart explicitly: enabling the CUDA language gives those to .cu sources automatically, but a .cpp\n  # target is just a C++ target and gets neither.\n  target_include_directories(dequant_s2_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(dequant_s2_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME dequant_s2_parity COMMAND dequant_s2_parity --selftest)\n\n  add_executable(s2_gemv_parity src/kernels/s2_gemv_parity.cpp)\n  target_include_directories(s2_gemv_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s2_gemv_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s2_gemv_parity COMMAND s2_gemv_parity --selftest)\n\n  add_executable(iq_parity src/kernels/iq_parity.cpp)\n  target_include_directories(iq_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(iq_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  # TODO 24: the i-quant fixtures are generated, not shipped.  tools/iq_fixture.py needs python3 + numpy\n  # and the repository's vendored gguf-py (no pip installs); it writes deterministic fixtures into the\n  # BUILD directory (the source tree is not touched).  The CTest fixture makes generation-to-test order\n  # explicit even under parallel execution; a fixture-generation failure fails iq_parity with it.\n  find_package(Python3 COMPONENTS Interpreter QUIET)\n  # the generator needs an interpreter WITH numpy: probe the configured one, the setup's .venv, and the\n  # system python3; -DIQ_FIXTURE_PYTHON=... overrides the search outright.\n  set(_iq_python \"\")\n  set(_iq_candidates \"\")\n  if(IQ_FIXTURE_PYTHON)\n    list(APPEND _iq_candidates ${IQ_FIXTURE_PYTHON})\n  else()\n    if(Python3_Interpreter_FOUND)\n      list(APPEND _iq_candidates ${Python3_EXECUTABLE})\n    endif()\n    list(APPEND _iq_candidates \"${CMAKE_CURRENT_SOURCE_DIR}/.venv/bin/python\"\n                                \"${CMAKE_CURRENT_SOURCE_DIR}/.venv/Scripts/python.exe\"\n                                /usr/bin/python3\n                                python3)\n  endif()\n  foreach(_cand IN LISTS _iq_candidates)\n    if(_cand STREQUAL \"\")\n      continue()\n    endif()\n    execute_process(COMMAND ${_cand} -c \"import numpy\" OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE _iq_probe)\n    if(_iq_probe EQUAL 0)\n      set(_iq_python \"${_cand}\")\n      break()\n    endif()\n  endforeach()\n  if(NOT _iq_python STREQUAL \"\")\n    add_test(NAME iq_parity_fixtures\n             COMMAND ${_iq_python} ${CMAKE_CURRENT_SOURCE_DIR}/tools/iq_fixture.py\n                     --out ${CMAKE_CURRENT_BINARY_DIR}/iq_fixture)\n    # exit 3: numpy or the vendored gguf-py is missing (a trimmed third_party) - a skip, not a failure\n    set_tests_properties(iq_parity_fixtures PROPERTIES FIXTURES_SETUP iq_fixture_data SKIP_RETURN_CODE 3)\n    add_test(NAME iq_parity COMMAND iq_parity ${CMAKE_CURRENT_BINARY_DIR}/iq_fixture)\n    set_tests_properties(iq_parity PROPERTIES FIXTURES_REQUIRED iq_fixture_data SKIP_RETURN_CODE 3)\n  else()\n    message(STATUS \"STRATA tests: no python3 with numpy was found (the configured interpreter and .venv \"\n                   \"were probed) - the iq_parity fixtures and its test are not registered; the fixtures \"\n                   \"need python3 with numpy and the repository's vendored gguf-py\")\n  endif()\n  if(STRATA_ENABLE_CUDA)\n    # native_mmvq's multi_exact contract, bitwise: a T-column call against T single-column calls on the same Q8_1\n    # bytes, with the flag off as the negative control (synthetic, GPU, no model; the control assumes 32-lane warps)\n    add_executable(mmvq_multi_parity src/kernels/mmvq_multi_parity.cpp)\n    target_include_directories(mmvq_multi_parity PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(mmvq_multi_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n    add_test(NAME mmvq_multi_parity COMMAND mmvq_multi_parity)\n  endif()\n  # the IQ kernels that decode a weight part once for every column/entry, bitwise vs the per-column ones\n  # (GPU, synthetic, no model; --bench adds old/new timings)\n  add_executable(iq_multi_parity src/kernels/iq_multi_parity.cpp)\n  target_include_directories(iq_multi_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(iq_multi_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME iq_multi_parity COMMAND iq_multi_parity)\n  add_executable(shared_expert_parity src/kernels/shared_expert_parity.cpp)\n  target_include_directories(shared_expert_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(shared_expert_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME shared_expert_parity COMMAND shared_expert_parity --selftest)\n\n  add_executable(gr_parity src/kernels/gr_parity.cpp)\n  target_include_directories(gr_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(gr_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME gr_parity COMMAND gr_parity --selftest)\n\n  add_executable(gdn_parity src/kernels/gdn_parity.cpp)\n  target_include_directories(gdn_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(gdn_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME gdn_parity COMMAND gdn_parity --selftest)\n\n  add_executable(s2_gemv_q8_parity src/kernels/s2_gemv_q8_parity.cpp)\n  target_include_directories(s2_gemv_q8_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s2_gemv_q8_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s2_gemv_q8_parity COMMAND s2_gemv_q8_parity --selftest)\n\n  add_executable(sampler_parity src/kernels/sampler_parity.cpp)\n  target_include_directories(sampler_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(sampler_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME sampler_parity COMMAND sampler_parity --selftest)\n  set_tests_properties(sampler_parity PROPERTIES ENVIRONMENT \"STRATA_OLD_SAMPLER=0;STRATA_SAMPLER_ONE_BLOCK=0\")\n  # the same fixtures on the other two sampled paths: the one-block kernel and the 0.1.20 kernel\n  add_test(NAME sampler_parity_one_block COMMAND sampler_parity --selftest)\n  set_tests_properties(sampler_parity_one_block PROPERTIES ENVIRONMENT \"STRATA_OLD_SAMPLER=0;STRATA_SAMPLER_ONE_BLOCK=1\")\n  add_test(NAME sampler_parity_old COMMAND sampler_parity --selftest)\n  set_tests_properties(sampler_parity_old PROPERTIES ENVIRONMENT \"STRATA_OLD_SAMPLER=1;STRATA_SAMPLER_ONE_BLOCK=0\")\n\n  add_executable(rope_parity src/kernels/rope_parity.cpp)\n  target_include_directories(rope_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(rope_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME rope_parity COMMAND rope_parity --selftest)\n\n  add_executable(quantize_act_parity src/kernels/quantize_act_parity.cpp)\n  target_include_directories(quantize_act_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(quantize_act_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME quantize_act_parity COMMAND quantize_act_parity --selftest)\n\n  add_executable(router_top10_parity src/kernels/router_top10_parity.cpp)\n  target_include_directories(router_top10_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(router_top10_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME router_top10_parity COMMAND router_top10_parity --selftest)\n\n  add_executable(s_gemv_parity src/kernels/s_gemv_parity.cpp)\n  target_include_directories(s_gemv_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s_gemv_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s_gemv_parity COMMAND s_gemv_parity --selftest)\n\n  add_executable(elementwise_parity src/kernels/elementwise_parity.cpp)\n  target_include_directories(elementwise_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(elementwise_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME elementwise_parity COMMAND elementwise_parity --selftest)\n\n  add_executable(bf16_gemv_parity src/kernels/bf16_gemv_parity.cpp)\n  target_include_directories(bf16_gemv_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(bf16_gemv_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME bf16_gemv_parity COMMAND bf16_gemv_parity --selftest)\n\n  add_executable(s_gemv_q8k_parity src/kernels/s_gemv_q8k_parity.cpp)\n  target_include_directories(s_gemv_q8k_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s_gemv_q8k_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s_gemv_q8k_parity COMMAND s_gemv_q8k_parity --selftest)\n\n  add_executable(qsa_parity src/kernels/qsa_parity.cpp)\n  target_include_directories(qsa_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(qsa_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME qsa_parity COMMAND qsa_parity --selftest)\n\n  # ---- P2.S4: the PLE n-gram hash, the IQ4_NL table read, and the PLE block ----\n  # `ngram.cpp` is host-only but lives in `strata_kernels` because `ple.cu` shares its geometry constants, and\n  # splitting them across two libraries would only add a layer.\n  #\n  # The pack, the original GGUF and the ggml capture are all REQUIRED inputs: this test's oracles are real\n  # artifacts, so the working directory is pinned to the source tree and a missing input is a hard error\n  # INSIDE the test.  A test that passes by finding nothing to compare is the failure mode this project keeps\n  # re-learning.\n  add_executable(ple_parity src/kernels/ple_parity.cpp)\n  target_include_directories(ple_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(ple_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  set(STRATA_PLE_FIXTURE_DIR \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro\" CACHE PATH\n      \"Directory containing required ple_in.bin and ple_out.bin parity fixtures\")\n  add_test(NAME ple_parity COMMAND ple_parity --selftest\n    --in \"${STRATA_PLE_FIXTURE_DIR}/ple_in.bin\" --out \"${STRATA_PLE_FIXTURE_DIR}/ple_out.bin\"\n    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n\n  # Plan v0.3 P7: INT8 KV storage vs a host reference and vs the FP16 path (GPU, synthetic, no model).\n  add_executable(kv_q8_parity src/kernels/kv_q8_parity.cpp)\n  target_include_directories(kv_q8_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_q8_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_q8_parity COMMAND kv_q8_parity)\n\n  # KV streaming (docs/kv-streaming-design.md): streamed vs resident attention, bitwise (GPU, synthetic, no model).\n  add_executable(kv_stream_parity src/kernels/kv_stream_parity.cpp)\n  target_include_directories(kv_stream_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_stream_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_stream_parity COMMAND kv_stream_parity)\n\n  # PR #120: the hybrid K8V4 KV (INT8 K + rotated Q4_0 V) vs host references (GPU, synthetic, no model).\n  add_executable(kv_hybrid_parity src/kernels/kv_hybrid_parity.cpp)\n  target_include_directories(kv_hybrid_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_hybrid_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_hybrid_parity COMMAND kv_hybrid_parity)\n  # PR #21: Q4_0 KV with Walsh-Hadamard rotation vs a host reference (GPU, synthetic, no model).\n  add_executable(kv_q4_parity src/kernels/kv_q4_parity.cpp)\n  target_include_directories(kv_q4_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(kv_q4_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME kv_q4_parity COMMAND kv_q4_parity)\n  add_executable(cvec_parity src/kernels/cvec_parity.cpp)\n  target_include_directories(cvec_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(cvec_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME cvec_parity COMMAND cvec_parity)\n\n  # The rewritten per-hit and grouped expert kernels vs the previous ones, bitwise (GPU, synthetic, no model).\n  # `--bench` adds previous/new timings on engine-like shapes.\n  add_executable(s2_expert_grouped_parity src/kernels/s2_expert_grouped_parity.cpp)\n  target_include_directories(s2_expert_grouped_parity PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(s2_expert_grouped_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME s2_expert_grouped_parity COMMAND s2_expert_grouped_parity --selftest)\n\n  # Plan v0.3 P3: native MMVQ for 1..8 tokens (bitwise selftest + --bench timing); synthetic data, no model.\n  if(STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/native_mmvq_multi.cpp\")\n    add_executable(native_mmvq_multi bench/micro/native_mmvq_multi.cpp)\n    target_include_directories(native_mmvq_multi PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(native_mmvq_multi PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n    add_test(NAME native_mmvq_multi COMMAND native_mmvq_multi --selftest)\n  endif()\n\n  # Plan v0.3 P0.1: working-set lock of a host region (CPU only).\n  add_executable(platform_memory_test src/platform/memory_test.cpp)\n  target_link_libraries(platform_memory_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n  add_test(NAME platform_memory_test COMMAND platform_memory_test)\n\n  if(CMAKE_SYSTEM_NAME STREQUAL \"Linux\")\n    add_executable(pinned_shared_test src/core/pinned_shared_test.cpp)\n    target_link_libraries(pinned_shared_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n    add_test(NAME pinned_shared_test COMMAND pinned_shared_test)\n  endif()\n\n  # Plan v0.3 P2: the n-gram table read straight from the SSD. The selftest needs only the CPU and a temp file.\n  add_executable(ple_reader_test src/ngram/ple_reader_test.cpp)\n  target_include_directories(ple_reader_test PRIVATE ${_strata_gpu_include_directories})\n  target_link_libraries(ple_reader_test PRIVATE strata_kernels ${_strata_gpu_runtime_target})\n  add_test(NAME ple_reader_selftest COMMAND ple_reader_test --selftest)\n\n  # The GPU test runs ON THE TARGET PC. `--selftest` allocates\n  # and writes real VRAM, so a machine without a device fails this test rather than skipping it silently -\n  # which is correct: an engine that targets one GPU should not report a pass for having no GPU.\n  if(STRATA_ENABLE_CUDA)\n    add_test(NAME cuda_device_selftest COMMAND strata-device --selftest)\n  else()\n    add_test(NAME hip_device_selftest COMMAND strata-device --selftest)\n  endif()\n\n  # ---- P2.S5: the GraphRegistry --------------------------------------------------\n  # A .cu because the test needs real kernels to capture; it links `strata_core` and not `strata_kernels`,\n  # because what it exercises is the capture machinery and not any kernel in it.\n  if(STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/graph_registry_test.cu\")\n    add_executable(graph_registry_test bench/micro/graph_registry_test.cu)\n    target_include_directories(graph_registry_test PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(graph_registry_test PRIVATE strata_core ${_strata_gpu_runtime_target})\n    add_test(NAME graph_registry_test COMMAND graph_registry_test)\n  endif()\n\n  # ---- P2.S5's GATE: is a device<->pinned-memory handoff graph-capturable? --------------------\n  # The doorbell protocol puts the D2H of `x_f` and the miss list INSIDE G[l] - that is the whole overlap.  The\n  # phase doc says to verify this \"before building on it\", and this project has already lost two rounds to\n  # building first (a memory-only spin that DEADLOCKS on Windows, and a `cudaEventRecord` inside a capture that\n  # is SILENTLY DROPPED).  It links only cudart: it is about the capture machinery, not about any kernel.\n  if(STRATA_ENABLE_CUDA AND STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/pinned_capture.cu\")\n    add_executable(pinned_capture bench/micro/pinned_capture.cu)\n    target_include_directories(pinned_capture PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(pinned_capture PRIVATE ${_strata_gpu_runtime_target})\n    add_test(NAME pinned_capture COMMAND pinned_capture)\n  endif()\n\n  # Tells tests/CMakeLists.txt to add the CUDA-dependent Catch2 target.  It cannot be declared there\n  # unconditionally: tests/ is added at the end of this file, but the flag has to be known before it runs.\n  if(STRATA_ENABLE_CUDA)\n    set(STRATA_CUDA_TESTS ON)\n  endif()\nendif()\n\n# ---- strata_kernels_cpu (P2.S3) ----\n#\n# A SEPARATE LIBRARY from `strata_kernels`, and `/arch:AVX512` is set on the SOURCE rather than on the target\n# so that the flag applies only to the TU that needs it.  Both parts matter:\n#\n#   * the CPU expert kernel uses `_mm256_dpbusd_epi32` (AVX512-VNNI) and `_mm256_multishift_epi64_epi8`\n#     (AVX512-VBMI); without the flag MSVC reports undeclared intrinsics and never mentions AVX-512;\n#   * a TU compiled WITH `/arch:AVX512` may use AVX-512 in ANY of its code, so the scalar fallback and the\n#     test drivers must NOT be in it - otherwise the fallback is not a fallback, it is the same bet with\n#     worse opt-out.  `cpu_require_expert_support()` therefore refuses at startup on a CPU without the\n#     features, and the fallback exists for tests, exactly as P2.S3 specifies.\n# Plan v0.3 P6: speculation components that need no GPU.\nadd_library(strata_spec STATIC src/spec/suffix_drafter.cpp src/spec/controller.cpp src/spec/draft_policy.cpp)\ntarget_include_directories(strata_spec PUBLIC include)\nif(STRATA_BUILD_TESTS)\n  add_executable(suffix_drafter_test src/spec/suffix_drafter_test.cpp)\n  target_link_libraries(suffix_drafter_test PRIVATE strata_spec)\n  add_test(NAME suffix_drafter_test COMMAND suffix_drafter_test)\n  add_executable(controller_test src/spec/controller_test.cpp)\n  target_link_libraries(controller_test PRIVATE strata_spec)\n  add_test(NAME controller_test COMMAND controller_test)\n  add_executable(draft_policy_test src/spec/draft_policy_test.cpp)\n  target_link_libraries(draft_policy_test PRIVATE strata_spec)\n  add_test(NAME draft_policy_test COMMAND draft_policy_test)\nendif()\nif(STRATA_BUILD_TESTS OR STRATA_BUILD_CONVERSATION_TESTS)\n  # the serve loop's conversation-cache retention policy (header-only, no library to link)\n  add_executable(conv_cache_test src/program/conv_cache_test.cpp)\n  target_include_directories(conv_cache_test PRIVATE include)\n  add_test(NAME conv_cache_test COMMAND conv_cache_test)\n  # coupled draft sampling's counter and penalty-ring arithmetic (header-only, CPU)\n  add_executable(coupled_draft_test src/core/coupled_draft_test.cpp)\n  target_include_directories(coupled_draft_test PRIVATE include)\n  add_test(NAME coupled_draft_test COMMAND coupled_draft_test)\n  # the f32 -> bf16 rounding against ggml's, NaN included, over every f32 bit pattern (header-only, CPU)\n  add_executable(bf16_bits_test src/kernels/bf16_bits_test.cpp)\n  target_include_directories(bf16_bits_test PRIVATE include)\n  add_test(NAME bf16_bits_test COMMAND bf16_bits_test)\nendif()\n\nadd_library(strata_kernels_cpu STATIC src/kernels/cpu/expert.cpp src/kernels/cpu/pool.cpp\n            src/kernels/cpu/expert_layout.cpp src/kernels/cpu/q2_avx2.cpp)\ntarget_include_directories(strata_kernels_cpu PUBLIC include)\n# Plan v0.3 P6: only the kernel files get the AVX-512 / AVX2 flags; the pool and the probe run on any x86-64,\n# and the engine picks the kernels at run time (cpu_avx512_ok).\nif(MSVC)\n  set_source_files_properties(src/kernels/cpu/expert.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX512\")\n  set_source_files_properties(src/kernels/cpu/q2_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\nelse()\n  # GCC/Clang spell it differently, and `-mavx512vnni` alone is not enough: VBMI is a separate feature bit.\n  set_source_files_properties(src/kernels/cpu/expert.cpp\n                              PROPERTIES COMPILE_OPTIONS \"-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma\")\n  set_source_files_properties(src/kernels/cpu/q2_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\nendif()\nfind_package(Threads REQUIRED)\ntarget_link_libraries(strata_kernels_cpu PUBLIC Threads::Threads)\n\n# ---- plan v0.3 P6: the i-quant models' CPU experts (IQ2_XS / IQ3_XXS files) ----\n#\n# The CPU computes a native expert with ggml-cpu's own dot products (`ggml_get_type_traits_cpu`), so an IQ\n# weight means exactly what it means in llama.cpp.  ggml is built static from a llama.cpp checkout: a local one\n# with -DSTRATA_GGML_DIR=..., otherwise the pinned upstream commit (third_party/ggml/VERSION.txt).\noption(STRATA_NATIVE_EXPERTS \"Native (IQ) expert support through ggml-cpu\" ON)\nset(STRATA_GGML_DIR \"\" CACHE PATH \"llama.cpp checkout to take ggml from (empty: fetch the pinned commit)\")\nif(STRATA_PREFILL_MMQ AND NOT STRATA_NATIVE_EXPERTS)\n  message(FATAL_ERROR \"STRATA_PREFILL_MMQ requires STRATA_NATIVE_EXPERTS=ON for GGML sources\")\nendif()\nif(STRATA_NATIVE_EXPERTS)\n  enable_language(C)\n  set(BUILD_SHARED_LIBS OFF CACHE BOOL \"\" FORCE)\n  set(GGML_STATIC ON CACHE BOOL \"\" FORCE)\n  set(GGML_CUDA OFF CACHE BOOL \"\" FORCE)\n  set(GGML_OPENMP OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BACKEND_DL OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BUILD_TESTS OFF CACHE BOOL \"\" FORCE)\n  set(GGML_BUILD_EXAMPLES OFF CACHE BOOL \"\" FORCE)\n  if(STRATA_PORTABLE)\n    set(GGML_NATIVE OFF CACHE BOOL \"\" FORCE)\n    foreach(_f GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2)\n      set(${_f} ON CACHE BOOL \"\" FORCE)\n    endforeach()\n  else()\n    set(GGML_NATIVE ON CACHE BOOL \"\" FORCE)\n  endif()\n  if(STRATA_GGML_DIR)\n    add_subdirectory(${STRATA_GGML_DIR}/ggml ${CMAKE_BINARY_DIR}/ggml EXCLUDE_FROM_ALL)\n  else()\n    include(FetchContent)\n    FetchContent_Declare(strata_llamacpp\n      GIT_REPOSITORY https://github.com/ggml-org/llama.cpp.git\n      GIT_TAG 3cf03257f219afbe7334045ff7c6a06ac68c627d\n      GIT_SHALLOW FALSE)\n    FetchContent_GetProperties(strata_llamacpp)\n    if(NOT strata_llamacpp_POPULATED)\n      FetchContent_Populate(strata_llamacpp)\n    endif()\n    add_subdirectory(${strata_llamacpp_SOURCE_DIR}/ggml ${CMAKE_BINARY_DIR}/ggml EXCLUDE_FROM_ALL)\n  endif()\n  # part of strata_kernels_cpu (the pool calls these and they call its CPU probe: one library, so GNU ld's\n  # one-pass static linking has no cycle to resolve)\n  target_sources(strata_kernels_cpu PRIVATE src/kernels/cpu/native_expert.cpp src/kernels/cpu/iq_avx512.cpp\n                                           src/kernels/cpu/iq_avx2.cpp src/kernels/cpu/kq_avx2.cpp)\n  target_include_directories(strata_kernels_cpu PRIVATE third_party/ggml)\n  if(MSVC)\n    set_source_files_properties(src/kernels/cpu/iq_avx512.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX512\")\n    set_source_files_properties(src/kernels/cpu/iq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\n    set_source_files_properties(src/kernels/cpu/kq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"/arch:AVX2\")\n  else()\n    set_source_files_properties(src/kernels/cpu/iq_avx512.cpp PROPERTIES COMPILE_OPTIONS\n                                \"-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma\")\n    set_source_files_properties(src/kernels/cpu/iq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\n    set_source_files_properties(src/kernels/cpu/kq_avx2.cpp PROPERTIES COMPILE_OPTIONS \"-mavx2;-mfma;-mf16c\")\n  endif()\n  target_link_libraries(strata_kernels_cpu PUBLIC ggml-cpu ggml-base)\n  target_compile_definitions(strata_kernels_cpu PUBLIC STRATA_NATIVE_EXPERTS=1)\n  if(STRATA_ENABLE_CUDA)\n    # prompt-speed plan step 2b: llama.cpp's MMQ kernels (ggml-cuda, MIT) for the prompt path's experts, compiled\n    # from the same checkout as ggml above - only mmq.cuh's instances for the packs' types and the quantizer, with\n    # the few host symbols of ggml-cuda.cu they use in src/prefill/ggml_cuda_host.cu\n    if(STRATA_GGML_DIR)\n      set(_strata_gg ${STRATA_GGML_DIR}/ggml)\n    else()\n      set(_strata_gg ${strata_llamacpp_SOURCE_DIR}/ggml)\n    endif()\n    set(_strata_mmq ${_strata_gg}/src/ggml-cuda)\n    add_library(strata_mmq STATIC src/prefill/moe_mmq.cu src/prefill/ggml_cuda_host.cu ${_strata_mmq}/quantize.cu)\n    foreach(_t q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)   # q8_0: the drafter's matrices (E-9)\n      target_sources(strata_mmq PRIVATE ${_strata_mmq}/template-instances/mmq-instance-${_t}.cu)\n    endforeach()\n    target_include_directories(strata_mmq PRIVATE ${_strata_gg}/include ${_strata_gg}/src ${_strata_mmq}\n                               PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_compile_options(strata_mmq PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda -use_fast_math>)\n    if(MSVC)\n      target_compile_options(strata_mmq PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/bigobj>)\n    endif()\n    target_link_libraries(strata_mmq PUBLIC ggml-base ${_strata_gpu_runtime_target})\n    target_link_libraries(strata_prefill PUBLIC strata_mmq)\n    target_compile_definitions(strata_prefill PUBLIC STRATA_PREFILL_MMQ=1)\n  elseif(STRATA_PREFILL_MMQ)\n    # Compile only the pinned GGML MMQ and activation-quantizer sources used by prefill. This uses\n    # common.cuh's native HIP path without enabling a second GGML HIP backend.\n    if(STRATA_GGML_DIR)\n      set(_strata_gg \"${STRATA_GGML_DIR}/ggml\")\n    else()\n      set(_strata_gg \"${strata_llamacpp_SOURCE_DIR}/ggml\")\n    endif()\n    set(_strata_mmq \"${_strata_gg}/src/ggml-cuda\")\n    if(NOT EXISTS \"${_strata_mmq}/common.cuh\" OR NOT EXISTS \"${_strata_mmq}/quantize.cu\")\n      message(FATAL_ERROR \"The selected GGML source is missing the ggml-cuda MMQ sources: ${_strata_mmq}\")\n    endif()\n    set(_strata_mmq_sources\n      src/prefill/moe_mmq.cu\n      src/prefill/ggml_cuda_host.cu\n      \"${_strata_mmq}/quantize.cu\")\n    foreach(_t q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)\n      list(APPEND _strata_mmq_sources \"${_strata_mmq}/template-instances/mmq-instance-${_t}.cu\")\n    endforeach()\n    set_source_files_properties(${_strata_mmq_sources} PROPERTIES LANGUAGE HIP)\n    add_library(strata_mmq STATIC ${_strata_mmq_sources})\n    target_include_directories(strata_mmq\n      PRIVATE \"${_strata_gg}/include\" \"${_strata_gg}/src\" \"${_strata_mmq}\"\n      PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_compile_definitions(strata_mmq PRIVATE GGML_USE_HIP=1)\n    target_link_libraries(strata_mmq PUBLIC ggml-base hip::host roc::hipblas)\n    target_link_libraries(strata_prefill PUBLIC strata_mmq)\n    target_compile_definitions(strata_prefill PUBLIC STRATA_PREFILL_MMQ=1)\n\n    # Numerical diagnostic: synthetic layouts by default, optional first-expert IQ3_XXS/IQ4_NL check with a pack.\n    add_executable(hip_prefill_mmq_parity tests/hip/prefill_mmq_parity.cpp)\n    target_include_directories(hip_prefill_mmq_parity PRIVATE \"${_strata_gg}/include\")\n    target_link_libraries(hip_prefill_mmq_parity PRIVATE strata_prefill)\n    add_test(NAME hip_prefill_mmq_parity COMMAND hip_prefill_mmq_parity)\n    set_tests_properties(hip_prefill_mmq_parity PROPERTIES TIMEOUT 120)\n    list(APPEND _strata_hip_tests hip_prefill_mmq_parity)\n  endif()\n  if(STRATA_ENABLE_HIP)\n    # Optional real-model diagnostic: pass the GGUF shard containing the native PLE key.\n    add_executable(hip_ple_iq4 tests/hip/ple_iq4.cpp)\n    target_link_libraries(hip_ple_iq4 PRIVATE strata_kernels strata_hip_runtime ggml-base)\n  endif()\n  if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)\n    add_executable(native_expert_parity src/kernels/native_expert_parity.cpp)\n    target_include_directories(native_expert_parity PRIVATE ${_strata_gpu_include_directories})\n    target_link_libraries(native_expert_parity PRIVATE strata_kernels strata_kernels_cpu strata_artifact ${_strata_gpu_runtime_target})\n    if(STRATA_BUILD_TESTS AND STRATA_ENABLE_CUDA)\n      # Unsloth UD-Q4_K_XL's three expert pairs (and Q8_0 alone, its embedding) on synthetic ggml-quantized weights\n      # at 2560/640: GPU and CPU experts against the float reference, GPU dequantizers against to_float\n      foreach(_pair q4_K/q5_1 q4_K/q8_0 q5_K/q8_0 q8_0/q8_0)\n        string(REPLACE \"/\" \"_\" _name \"${_pair}\")\n        add_test(NAME native_expert_parity_${_name} COMMAND native_expert_parity --synthetic ${_pair})\n        set_tests_properties(native_expert_parity_${_name} PROPERTIES TIMEOUT 120)\n      endforeach()\n      add_test(NAME native_expert_parity_q5_1_min COMMAND native_expert_parity --q5_1-min)\n      # a pair without GPU kernels (Q6_K gate/up) is refused by native_expert_supported, not run\n      add_test(NAME native_expert_parity_refuses_q6_K COMMAND native_expert_parity --synthetic q6_K/q8_0)\n      set_tests_properties(native_expert_parity_refuses_q6_K PROPERTIES WILL_FAIL TRUE)\n    endif()\n  endif()\nendif()\n\nif(STRATA_ENABLE_CUDA AND STRATA_BUILD_TESTS AND EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/bench/micro/hit_cpu_order_parity.cu\")\n  add_executable(hit_cpu_order_parity bench/micro/hit_cpu_order_parity.cu)\n  target_link_libraries(hit_cpu_order_parity PRIVATE strata_kernels strata_kernels_cpu ${_strata_gpu_runtime_target})\nendif()\n\nif(STRATA_BUILD_TESTS)\n  # Plan v0.3 P6: one expert applied to several tokens, bitwise vs the single-token kernel (synthetic, CPU only).\n  # plan v0.3 P5: the device dequantizers vs the artifact's CPU dequantizers on the real shards (not a ctest: needs\n  # the 38 GB model; run it by hand or from tools/gpu_session.py)\n  if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)   # #93: it needs the device dequantizers and a GPU runtime\n    add_executable(dequant_bf16_test src/kernels/dequant_bf16_test.cpp)\n    target_link_libraries(dequant_bf16_test PRIVATE strata_kernels strata_artifact ${_strata_gpu_runtime_target})\n  endif()\n\n  add_executable(expert_multi_test src/kernels/cpu/expert_multi_test.cpp)\n  target_link_libraries(expert_multi_test PRIVATE strata_kernels_cpu)\n  add_test(NAME expert_multi_test COMMAND expert_multi_test)\n\n  add_executable(expert_parity src/kernels/cpu/expert_parity.cpp)\n  target_link_libraries(expert_parity PRIVATE strata_kernels_cpu)\n  # The pack is a REQUIRED input, not an optional one: this test compares against a real expert blob, and a\n  # missing file would otherwise be reported as a pass by a test that skipped everything.\n  add_test(NAME expert_parity COMMAND expert_parity --selftest\n           WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n\n  add_executable(pool_test src/kernels/cpu/pool_test.cpp)\n  target_link_libraries(pool_test PRIVATE strata_kernels_cpu)\n  add_test(NAME pool_test COMMAND pool_test --selftest WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})\n  # issue #29: tiny batches with sleeping workers, as on a big-VRAM card; a hang fails it\n  add_executable(pool_stress src/kernels/cpu/pool_stress.cpp)\n  target_link_libraries(pool_stress PRIVATE strata_kernels_cpu)\n  add_test(NAME pool_stress COMMAND pool_stress 20)\n\n  if(UNIX AND NOT APPLE)\n    add_executable(direct_file_async_test tests/platform/direct_file_async.cpp src/platform/direct_file.cpp)\n    target_include_directories(direct_file_async_test PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include)\n    target_link_libraries(direct_file_async_test PRIVATE Threads::Threads)\n    add_test(NAME direct_file_async_test COMMAND direct_file_async_test)\n  endif()\nendif()\n\nif(STRATA_BUILD_TESTS)\n  enable_testing()\n  # Model-level checks may be absent from source distributions.\n  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/CMakeLists.txt\")\n    add_subdirectory(tests)\n  endif()\nendif()\n\n```\n### README.md\n```\n<h1 align=\"center\">Strata</h1>\n\n<p align=\"center\"><b>Run a 125-billion-parameter AI model on a normal gaming PC</b><br>\none NVIDIA card (12-24 GB) + 64 GB of RAM · Windows or Linux · one click to install</p>\n\n<p align=\"center\"><a href=\"https://github.com/Niko1221/Strata/releases/download/v0.1.10/Pagoda.mp4\"><img src=\"docs/media/pagoda-preview.webp\" width=\"720\" alt=\"A voxel pagoda garden that Strata's model wrote, running in the browser\"></a><br>\n<sub>A voxel pagoda garden, 1 shot prompt running on an RTX 5070 with Strata (IQ3_S, 128K context) ·\n<a href=\"https://github.com/Niko1221/Strata/releases/download/v0.1.10/Pagoda.mp4\">full video (49 s)</a></sub></p>\n\nStrata runs **[Qwen3.8-Flash-Next](https://huggingface.co/Qwen/Qwen3.8-Flash-Next)** - a large, smart AI model that\nnormally needs a server - on your own PC. It writes its answers at **60-95 tokens per second** (a token is about ¾\nof a word): faster than you can read.\n\n- **Free and open source.**\n\n> **Jump to:** [How fast?](#how-fast-is-it) · [Which model?](#which-model-should-i-pick) · [Install](#install) ·\n> [Using it](#using-it) · [Problems?](#something-went-wrong) · [How it works](#how-does-it-work) ·\n> [All the details](docs/DETAILS.md)\n\n---\n\n## How fast is it?\n\nMeasured on an RTX 5070 (12 GB), a Ryzen 5 7600 and 64 GB of RAM:\n\n| Size | Writes answers (short chat) | Writes answers (128K context) | Reads your prompt |\n| --- | ---: | ---: | ---: |\n| **Q2_0** | 93 tokens/s | 74 tokens/s | 2,170 tokens/s |\n| **IQ2_XS** | 79 tokens/s | 63 tokens/s | 2,090 tokens/s |\n| **IQ3_XXS** | 62 tokens/s | 49 tokens/s | 1,750 tokens/s |\n| **IQ3_S** | 53 tokens/s | 46 tokens/s | 1,620 tokens/s |\n| **Coder** (IQ1_M) | 55 tokens/s | 43 tokens/s | 2,180 tokens/s |\n\n- **Writes answers** = how fast the reply appears (tokens per second).\n- **Reads your prompt** = how fast it takes in what you send (long documents, code, chat history), measured on a\n  32K-token prompt; a 4K prompt reads at 910-1,580 tokens/s. A 32K prompt takes about 15 seconds with Q2_0.\n\nA card with more VRAM is faster, because more of the model fits on the GPU: an RTX 3090 (24 GB) should do roughly\n100-140 tokens per second. All measurements, long-context numbers and estimates for other cards are in the\n[details](docs/DETAILS.md#speed-measured).\n\nEvery PC is different: `START-HERE.bat --calibrate` measures a few engine settings on yours and keeps the fastest\n(about 5-10 minutes; on the PC above it made the Coder 7% faster).\n\nMeasured Strata on your own PC? See [Community benchmark results](docs/COMMUNITY_BENCHMARKS.md)\nfor a report template and how to share your results in a pull request.\n\n**Two or three NVIDIA cards?** Just run `START-HERE.bat`: it lists your cards, says which ones Strata can use, and\nasks whether to share the model across them (recommended when two can). An install made on one card asks once at\nits next start. Or choose yourself: `START-HERE.bat --gpus 0,2` (both, remembered), `--gpus all`, or `--gpu 0` (one\ncard, this start only). Each card keeps the experts of its own layers, and prompts flow through the cards in a\npipeline: on an RTX 5080 + RTX 3090 prompts were read 18-20% faster than on the 5080 alone, decoding on par.\nEvery card must be an RTX 20 series or newer with 8 GB or more. See [docs/MULTI_GPU.md](docs/MULTI_GPU.md).\n\n## Which model should I pick?\n\n**The size** (the same model, compressed more or less):\n\n| Model | RAM+VRAM Requirements | Speed | Quality |\n| --- | ---: | --- | --- |\n| **Q2_0** | 37.6 GB | fastest | good |\n| **IQ2_XS** | 39.2 GB | fast | better (**recommended**) |\n| **IQ3_XXS** | 47.0 GB | slower | great |\n| **IQ3_S** | 54.8 GB | slowest | best: matches the full model on the published tests (original model only) |\n\n**Will it fit?** Shard 1 is the part of the model that gets loaded when it starts: its experts go into your **RAM**,\nthe rest onto your graphics card (the second shard, a 29 GB lookup table, stays on the SSD). So it fits when your\n**RAM is at least shard 1 + about 10 GB** for Windows and your other programs. With 64 GB of RAM every size fits\n(IQ3_S with little else open); with 48 GB, Q2_0 and IQ2_XS. A bigger graphics card makes it faster, but it doesn't\nlower the RAM needed.\n\n**The version:**\n\n- **Qwen3.8-Flash-Next** - the original.\n- **[Coder](https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-Coder-GGUF)** - ISTA-DASLab's coding\n  version: half of the experts removed, keeping the ones that code, tool use and images need (91% of the full model's\n  SWE-bench Verified score, 99% of LiveCodeBench, by its authors). One size (IQ1_M: its experts stored like IQ3_S):\n  shard 1 is **29.6 GB**, so it fits a PC with **32 GB of RAM**, runs 262K context on 64 GB, and reads long prompts\n  the fastest of all. Weaker outside coding.\n- **[Swift 1.5](https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-Flash-Next-GSQ-RCO-GGUF)** - a fine-tune by UkisAI\n  that thinks much shorter before answering, so you get the answer sooner, with about the same quality. Same speed per\n  token, and about the same RAM as the same size of the original (no IQ3_S). Its own license applies (see its page).\n\nNot sure? Take **IQ2_XS** - or the **Coder** if you mainly write code, or have 32-48 GB of RAM. You can add another\none later with `SETUP.bat` (the same as `START-HERE.bat --setup`; on Linux `./setup.sh --setup`).\n\nFor **OrcaRouter's Flash-Next Uncensored IQ3_XXS**, see the [manual compatibility setup](docs/ORCA.md).\nIt needs an explicit packing conversion and is not an installer menu option.\n\nAn **AMD Radeon RX 7900 XT / XTX, RX 9070 / 9070 XT or Radeon AI PRO R9700 on Linux** works too (experimental; the\nRX 7800 XT / 7700 XT and RX 9060 XT were validated by their owners):\n`./setup.sh --backend hip`, chosen by itself on a PC with no NVIDIA card Strata can use. It installs ROCm without sudo\nand compiles the engine (no images yet; several cards with `--gpus`). Details: [AMD HIP](docs/AMD_HIP.md).\n\n## Install\n\n**You need:** an NVIDIA RTX 20, 30, 40 or 50 card with 12 GB of VRAM or more (RTX 20 since 0.1.27), enough RAM for the size you pick (above;\na big GPU makes up for less RAM - the [low-RAM mode](docs/DETAILS.md)),\n~80 GB of free disk space (an SSD makes the first start much faster), and Windows 10/11 or Linux. The only thing you\ninstall yourself is a current **NVIDIA driver** ([nvidia.com/drivers](https://www.nvidia.com/drivers) or the NVIDIA\nApp). Everything else - Python, the engine, the model - is set up for you.\n\n**Windows**\n\n1. [Download this project](https://github.com/Niko1221/Strata/archive/refs/heads/main.zip) and unzip it (or `git clone` it).\n2. Double-click **`START-HERE.bat`**.\n3. Answer a few questions - or just press Enter each time for the recommended choice:\n   - **Which model and size?** The original or Swift 1.5, and Q2_0, IQ2_XS, IQ3_XXS or IQ3_S - see [above](#which-model-should-i-pick)\n   - **How much context?** How much text it can keep in mind at once (it suggests one for your card). 384K and\n     512K (experimental) extend the model past its trained 262K by rope scaling - the setup turns it on itself (yarn and a\n     covering factor; `--rope-scaling`/`--rope-scale` override) ([details](docs/DETAILS.md))\n   - **Images?** Whether it should also read pictures\n   - **Experimental speed projection?** Off unless you say yes - [read what it does](docs/DETAILS.md#experimental-speed-projection-experimental-off-by-default) first\n\nThen it downloads everything (the model is ~70 GB, so the first time takes a while - you can stop and it picks up\nwhere it left off) and **starts the model**. Your browser opens the Strata app at `http://127.0.0.1:8080`.\n\n> **While the model starts, your PC can be slow or stop responding for 1-3 minutes** (longest the first time): Strata\n> loads 35-55 GB into your RAM and locks part of it for the graphics card. That's normal - wait, and don't close the\n> window. The window tells you what it is doing.\n\n**Next time**, just double-click `START-HERE.bat` again: it starts right away, nothing is downloaded twice. Close its\nwindow to stop the model.\n\n**Updating:** download the new version and unzip it anywhere (or `git pull`), then run `START-HERE.bat` in it. The\nmodel files are kept in a `Strata-data` folder next to your Strata folder, so a new copy finds them and sets itself up\nthe same way - nothing big is downloaded again.\n\n**Linux:** run `./setup.sh` - same questions, same result.\n\n**Docker (Linux):** the same idea, in a container.\n\n1. Host: Docker with the [NVIDIA Container Toolkit](https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html)\n   and a driver **580 or newer** (CUDA 13.0).\n2. Build (this compiles the engine into the image, so the container never compiles):\n   `docker build -t strata .`\n   `docker build -t strata --build-arg CUDA_ARCHITECTURES=89 .` builds for one card only (faster).\n   The default covers RTX 30 (86), RTX 40 (89), RTX 50 (120) and A-series (80); a card outside that\n   set needs a rebuild with its own arch. Add `--build-arg BUILD_VISION=0` to skip the image encoder.\n3. Run (the first start downloads the ~70 GB model, then starts; later starts go straight to serving):\n   `docker run --rm --gpus all -p 8080:8080 --ulimit memlock=-1 -v strata-data:/data strata`\n\n   The setup choices are env vars: `-e MODEL=IQ2_XS -e FAMILY=qwen -e CONTEXT=32768 -e VISION=no`\n   (or `MODEL=Q2_0|IQ3_XXS|IQ3_S`, `FAMILY=swift|coder`; the defaults above are the recommended ones).\n   `-e VISION=cpu` keeps the image encoder on the CPU. `-e KV=int8|q4_0|k8v4` picks the KV cache\n   precision; `k8v4` is INT8 K with 4-bit V and keeps its KV in VRAM from 64K up.\n   Only the model files, the prepared pack, the MTP layer and the install config live in the\n   `strata-data` volume; the engine is part of the image. Switching between models already on the\n   volume needs no setup pass: `-e MODEL=Q2_0 -e FAMILY=coder` picks that model's config. Add\n   `-e REINSTALL=1` only to change settings for a model already set up (context, vision, KV, host,\n   api_key, LOW_RAM), since those are recorded in its config.\n   Strata loads 32-62 GB into RAM. `--gpus all` on a host with two usable cards takes both: the\n   layer split is setup's recommended default ([docs/MULTI_GPU.md](docs/MULTI_GPU.md)), and a volume\n   set up for one card switches to the pair on its first start there. Pin one card with `-e GPU=0`,\n   or name them with `-e GPUS=0,2` and where the later card's layers start with `-e LAYER_SPLIT=18`.\n   A memory limit needs `-e LOW_RAM=on`, which maps the model's experts from the pack instead of\n   keeping them in RAM: setup.py measures the host's RAM, not the container's limit, so it cannot\n   see a cap. LOW_RAM runs on one card.\n   The server listens on `0.0.0.0:8080` by default; set `-e API_KEY=<secret>` before exposing the port\n   to a network. The image has a `HEALTHCHECK` on `/health`, so `docker ps` shows the container\n   healthy once the model is loaded, and `GET /v1/status` says what it is running.\n\n## Using it\n\n<p align=\"center\"><img src=\"docs/media/runpagoda.png\" width=\"900\" alt=\"The Strata app's Monitor tab next to a coding agent\"><br>\n<sub>The Strata app's <b>Monitor</b> (left) while a coding agent writes the pagoda garden from the video (right)</sub></p>\n\n- **In the browser:** `http://127.0.0.1:8080` - the Strata app (it opens by itself when the model starts): **Chat**, a\n  live **Monitor** of the model and your GPU/CPU/RAM, and **About** with the settings and addresses.\n- **Chat in the terminal:** `.venv\\Scripts\\python chat.py`\n- **Your apps and coding agents:** add it as an \"OpenAI-compatible\" provider with base URL\n  **`http://127.0.0.1:8080/v1`**, any API key and any model name. Apps that use Anthropic's API: `http://127.0.0.1:8080/v1/messages`.\n- **Thinking:** the model thinks before it answers. Choose **off, low, medium or high** - in the chat page menu, with\n  `/think low` in `chat.py`, or with your app's \"reasoning effort\" setting. Off is fastest; high is best for hard questions.\n- **Pictures:** in the chat page click **Picture**; in `chat.py` type `/image <path>`; in apps just attach them.\n- **From your phone or another PC:** `START-HERE.bat --setup --host 0.0.0.0 --api-key <secret>`, then open the\n  address the server window prints; see the [details](docs/DETAILS.md#using-it).\n- **Experimental speed projection (off by default):** an experimental control vector that setup can turn on; it\n  changes how the model answers - read [what it does](docs/DETAILS.md#experimental-speed-projection-experimental-off-by-default) first.\n\n**Good to know:** it answers one request at a time. The first message of a chat is read in full (about 1 minute per\n30,000 tokens); after that it keeps the conversation and reads only what is new, so follow-ups start in seconds.\n\n### Where things are stored\n\n- **Your chats: only in your browser.** The Chat tab keeps the conversation, its settings and the API key you typed\n  in the browser's local storage (`strata.*` keys) - not on the server and not in the Strata folder. Pictures are not\n  kept, only their names. Another browser or a private window starts empty; clearing the site's data deletes them.\n- **How the model starts:** `strata-<model>.json` in the Strata folder (context, GPUs, host, API key, ...), written\n  by setup; next to it `run-<model>.bat` / `.sh`, the log `strata-<model>.log` and, when you use \"Use for other\n  apps too\", `strata-<model>.shared-settings.json`.\n- **The model files** (`models/`, `packs/`, `mtp/`, 70-120 GB): in **`Strata-data` next to the Strata folder**, or\n  wherever `--data-dir` put them.\n- **Where that data folder is:** `%APPDATA%\\Strata\\settings.json` on Windows, `~/.config/strata/settings.json` on\n  Linux ([details](docs/DETAILS.md)).\n\n## Something went wrong?\n\n**My PC froze, or got very slow, the first time Strata started.**\nThat's normal while it starts, most of all the first time. Strata loads 35-55 GB into your RAM, locks part of it for\nthe graphics card, and works out how much of the model fits on your GPU. The mouse can freeze for a few minutes. **Wait, and don't close the\nwindow.** The next starts are much faster. Still frozen after 10 minutes? Restart the PC, close other programs\n(browsers use a lot of RAM) and try again. If it keeps happening, pick a smaller size (Q2_0 or IQ2_XS).\n\n**It stopped while downloading or installing.**\nRun `START-HERE.bat` again. It continues where it stopped.\n\n**It says the NVIDIA driver is too old.**\nUpdate it (NVIDIA App or [nvidia.com/drivers](https://www.nvidia.com/drivers)), restart the PC, and run\n`START-HERE.bat` again.\n\n**It says port 8080 is already in use.**\nStrata is already running. Look for its window.\n\n**It's very slow and the disk light keeps blinking.**\nYour PC is out of free RAM. Close other programs, or pick a smaller size (Q2_0 or IQ2_XS).\n\n**An answer stopped with \"the engine stopped unexpectedly\".**\nUsually not enough RAM (on Linux the system then stops the engine). Just send your message again: Strata starts the\nengine by itself. If it keeps happening, close other programs or pick a smaller size.\n\n**It says the prompt exceeds the context.**\nThe conversation is longer than the context you chose. Start a new chat, or run `SETUP.bat` and pick more\ncontext.\n\n**Still stuck?** Look in the [full troubleshooting table](docs/DETAILS.md#troubleshooting), or open an issue and\nattach `strata-<model>.log` from the Strata folder.\n\n## How does it work?\n\nModels like this one normally run on servers with hundreds of gigabytes of graphics memory. Your graphics card has\n12-24 GB. Strata makes it fit by **sharing the work across your whole PC** - the same idea as a kitchen, where the\nthings you use all the time stay on the counter and the rest waits in the pantry.\n\n<p align=\"center\"><img src=\"docs/media/how-it-works.svg\" width=\"860\" alt=\"The model's 24,576 experts: the busiest on the graphics card, all of them in RAM, a lookup table on the SSD\"></p>\n\n- **The model is a team of 24,576 small specialists (\"experts\"),** and each word it writes needs only 10 of them.\n  So it doesn't have to have all of them on the graphics card at once.\n- **Your graphics card** does the part of the work needed for every word, and keeps the few thousand experts that\n  are asked most often. It keeps learning which ones those are while you use it.\n- **Your RAM** holds every expert. When a word needs one the card doesn't have, **your processor** works on it -\n  at the same time as the graphics card, so neither waits for the other.\n- **Your SSD** holds a big lookup table; the model only reads a few small rows of it per word.\n\n<p align=\"center\"><img src=\"docs/media/guess-and-check.svg\" width=\"860\" alt=\"A small helper guesses the next words; the big model checks them all at once and keeps the right ones\"></p>\n\n- **Guess, then check.** A small, fast helper built into the model guesses the next few words, and the big model\n  checks all the guesses in one go. It keeps the ones it agrees with and writes the next word itself - so one step\n  often produces several words. The helper only guesses - the big model decides every word - so you get the same\n  quality answer, 1.6-1.8x sooner.\n- **Long texts are read in big pieces** (up to 8,192 tokens - pieces of words - at a time), which is why a long\n  document or code base is read at over 1,000 tokens per second.\n\nWant the full picture? The [details](docs/DETAILS.md#how-it-works) explain every part and its numbers, and the\n[paper](docs/paper/Strata-Paper.pdf) tells the whole story, with the measurements behind it.\n\n## Credits\n\n- Model: [Qwen3.8-Flash-Next](https://huggingface.co/Qwen/Qwen3.8-Flash-Next) by the Qwen team; compressed versions by\n  [ISTA-DASLab](https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF);\n  [Swift 1.5](https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-Flash-Next-GSQ-RCO-GGUF) by UkisAI. Their licenses apply\n  to the model files.\n- Built with parts of [llama.cpp / ggml](https://github.com/ggml-org/llama.cpp) (MIT). Ideas from\n  [Splash](https://github.com/incoai/splash), [ninfer](https://github.com/Neroued/ninfer) and\n  [HyperQwen](https://github.com/syv-ai/HyperQwen). More in the [details](docs/DETAILS.md#credits-and-licenses).\n\n## License\n\nStrata is open source under the [MIT License](LICENSE). A few parts carry their own licenses: `third_party/ggml`\n(MIT, llama.cpp / ggml), the web app's font (SIL Open Font License 1.1) and the experimental speed projection's\nvector in `data/experimental-speed-projection` (Qwen Community License 1.0, from the model's activations). The\nmodels are not part of this repository; each model's own license applies to its files.\n\n```\n### chat.py\n```\n#!/usr/bin/env python3\n\"\"\"A tiny terminal chat for a running Strata server (start it with run-<model>.bat / run-<model>.sh first).\n\n    python chat.py [--port 8080] [--think none|low|medium|high]\n\nType a message and press Enter.  /image <path> attaches a picture to your next message (when the server was set up\nwith images), /think <none|low|medium|high> sets how long the model thinks first, /reset starts a new conversation,\n/quit leaves.  Standard library only.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport base64\nimport json\nimport mimetypes\nimport os\nimport sys\nimport time\nimport urllib.request\n\n\ndef stream(url, messages, think, max_tokens):\n    body = {\"model\": \"strata\", \"messages\": messages, \"stream\": True, \"max_tokens\": max_tokens,\n            \"reasoning_effort\": think}\n    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})\n    with urllib.request.urlopen(req, timeout=3600) as r:\n        for raw in r:\n            line = raw.decode(\"utf-8\", \"replace\").strip()\n            if not line.startswith(\"data: \") or line == \"data: [DONE]\":\n                continue\n            d = json.loads(line[6:])[\"choices\"][0][\"delta\"]\n            yield d.get(\"reasoning_content\") or \"\", d.get(\"content\") or \"\"\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--port\", type=int, default=8080)\n    ap.add_argument(\"--host\", default=\"127.0.0.1\")\n    ap.add_argument(\"--think\", default=\"medium\", choices=[\"none\", \"low\", \"medium\", \"high\"],\n                    help=\"how long the model thinks before answering (none = answer directly)\")\n    ap.add_argument(\"--no-think\", action=\"store_true\", help=\"same as --think none\")\n    ap.add_argument(\"--max-tokens\", type=int, default=4096)\n    a = ap.parse_args()\n    url = f\"http://{a.host}:{a.port}/v1/chat/completions\"\n    gray, reset = (\"\\033[90m\", \"\\033[0m\") if sys.stdout.isatty() else (\"\", \"\")\n    messages, pending = [], []\n    think = \"none\" if a.no_think else a.think\n    print(f\"Strata chat ({url}).  /image <path> = attach a picture, /think none|low|medium|high (now: {think}), \"\n          f\"/reset = new conversation, /quit = leave.\")\n    while True:\n        try:\n            user = input(\"\\nyou> \").strip()\n        except (EOFError, KeyboardInterrupt):\n            print()\n            return 0\n        if user in (\"/quit\", \"/exit\"):\n            return 0\n        if user == \"/reset\":\n            messages, pending = [], []\n            print(\"(new conversation)\")\n            continue\n        if user.startswith(\"/think\"):\n            level = user[6:].strip().lower()\n            if level in (\"none\", \"low\", \"medium\", \"high\"):\n                think = level\n                print(f\"(thinking: {think})\")\n            else:\n                print(\"(usage: /think none|low|medium|high)\")\n            continue\n        if user.startswith(\"/image\"):\n            path = user[6:].strip().strip('\"').strip(\"'\")\n            if not os.path.isfile(path):\n                print(f\"(no such file: {path or '?'} - usage: /image <path to a picture>)\")\n                continue\n            mime = mimetypes.guess_type(path)[0] or \"image/jpeg\"\n            data = base64.b64encode(open(path, \"rb\").read()).decode()\n            pending.append({\"type\": \"image_url\", \"image_url\": {\"url\": f\"data:{mime};base64,{data}\"}})\n            print(f\"(picture attached: {os.path.basename(path)} - now type your question)\")\n            continue\n        if not user:\n            continue\n        if pending:\n            messages.append({\"role\": \"user\", \"content\": [*pending, {\"type\": \"text\", \"text\": user}]})\n            pending = []\n        else:\n            messages.append({\"role\": \"user\", \"content\": user})\n        answer, n, t0 = [], 0, time.time()\n        print(\"model> \", end=\"\", flush=True)\n        try:\n            in_think = False\n            for reasoning, content in stream(url, messages, think, a.max_tokens):\n                if reasoning:\n                    if not in_think:\n                        print(gray, end=\"\")\n                        in_think = True\n                    print(reasoning, end=\"\", flush=True)\n                if content:\n                    if in_think:\n                        print(reset + \"\\n\", end=\"\")\n                        in_think = False\n                    print(content, end=\"\", flush=True)\n                    answer.append(content)\n                n += 1\n            if in_think:\n                print(reset, end=\"\")\n        except OSError as e:\n            print(f\"\\n(could not reach the server at {url}: {e})\")\n            messages.pop()\n            continue\n        dt = time.time() - t0\n        print(f\"\\n{gray}[{n} chunks in {dt:.1f} s]{reset}\")\n        messages.append({\"role\": \"assistant\", \"content\": \"\".join(answer)})\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n### cmake/hip_backend.cmake\n```\n# Opt-in HIP configuration. Strata's CUDA-shaped kernels target wave32 RDNA3 / RDNA4 (64 KiB LDS per workgroup,\n# the signed dot4 instruction). CMake/compiler discovery stays machine-independent; pass CMAKE_HIP_COMPILER when it\n# is not on PATH.\nif(NOT DEFINED CMAKE_HIP_ARCHITECTURES OR CMAKE_HIP_ARCHITECTURES STREQUAL \"\")\n  set(CMAKE_HIP_ARCHITECTURES gfx1100 CACHE STRING \"Strata HIP target architecture(s), e.g. gfx1100 or gfx1100;gfx1201\")\nendif()\n# Validated on real cards: gfx1100 (RX 7900 XT / XTX) and gfx1201 (RX 9070 / 9070 XT, Radeon AI PRO R9700) by the\n# maintainers; gfx1101 (RX 7800 XT, #254) and gfx1200 (RX 9060 XT, #256) by their owners. gfx1102 (RX 7600) has the\n# same LDS limit and dot4 instruction and passed ctest (#192), but no model run has been reported yet.\nset(_strata_hip_validated gfx1100 gfx1201)\nset(_strata_hip_community gfx1101 gfx1200)\nset(_strata_hip_unvalidated gfx1102)\nset(STRATA_HIP_ARCH_LIST \"\")\nforeach(_arch IN LISTS CMAKE_HIP_ARCHITECTURES)\n  string(REGEX REPLACE \":.*$\" \"\" _base \"${_arch}\")      # gfx1100:xnack- -> gfx1100\n  if(_base IN_LIST _strata_hip_validated)\n  elseif(_base IN_LIST _strata_hip_community)\n    message(STATUS \"Strata HIP: ${_base} was validated by community reports (docs/AMD_HIP.md)\")\n  elseif(_base IN_LIST _strata_hip_unvalidated)\n    message(WARNING \"Strata HIP: ${_base} builds, but it is not validated on a real card yet; please report results\")\n  else()\n    message(FATAL_ERROR\n      \"Strata HIP supports wave32 gfx1100, gfx1101, gfx1200 and gfx1201 (unvalidated: ${_strata_hip_unvalidated}); \"\n      \"CMAKE_HIP_ARCHITECTURES is '${CMAKE_HIP_ARCHITECTURES}'\")\n  endif()\n  list(APPEND STRATA_HIP_ARCH_LIST \"${_base}\")\nendforeach()\nlist(REMOVE_DUPLICATES STRATA_HIP_ARCH_LIST)\nif(NOT STRATA_HIP_ARCH_LIST)\n  message(FATAL_ERROR \"Strata HIP: CMAKE_HIP_ARCHITECTURES is empty\")\nendif()\n# The compiled architectures reach the runtime device check (src/core/device.cu) as \"gfx1100,gfx1201\": a binary\n# carried to a card it has no code for stops at startup with a clear message instead of \"invalid device function\".\nstring(REPLACE \";\" \",\" STRATA_HIP_ARCHS \"${STRATA_HIP_ARCH_LIST}\")\n\nenable_language(HIP)\nfind_package(hip CONFIG REQUIRED)\nfind_package(hipblas CONFIG REQUIRED)\nfind_package(hipblaslt CONFIG QUIET)\n\nif(NOT TARGET hip::host)\n  message(FATAL_ERROR \"The ROCm hip CMake package did not provide hip::host\")\nendif()\nif(NOT TARGET roc::hipblas)\n  message(FATAL_ERROR \"The ROCm hipblas CMake package did not provide roc::hipblas\")\nendif()\nif(TARGET roc::hipblaslt)\n  set(STRATA_HIPBLASLT_AVAILABLE ON)\nelse()\n  set(STRATA_HIPBLASLT_AVAILABLE OFF)\n  message(STATUS \"Strata: hipBLASLt not found; solution-table dispatch is unavailable\")\nendif()\n\n# HIP's link step produces a PIE; make Strata and ggml objects PIC for the ROCm linker.\nset(CMAKE_POSITION_INDEPENDENT_CODE ON)\n\nset(STRATA_HIP_COMPAT_INCLUDE_DIR \"${CMAKE_CURRENT_SOURCE_DIR}/include/strata/hip_compat\")\nadd_library(strata_hip_runtime INTERFACE)\ntarget_include_directories(strata_hip_runtime BEFORE INTERFACE\n  \"${STRATA_HIP_COMPAT_INCLUDE_DIR}\" \"${CMAKE_CURRENT_SOURCE_DIR}/include\")\ntarget_compile_definitions(strata_hip_runtime INTERFACE STRATA_USE_HIP=1 \"STRATA_HIP_ARCHS=\\\"${STRATA_HIP_ARCHS}\\\"\")\ntarget_link_libraries(strata_hip_runtime INTERFACE hip::host)\nforeach(_language IN ITEMS CXX HIP)\n  target_compile_options(strata_hip_runtime INTERFACE\n    \"$<$<COMPILE_LANGUAGE:${_language}>:-include>\"\n    \"$<$<COMPILE_LANGUAGE:${_language}>:${STRATA_HIP_COMPAT_INCLUDE_DIR}/cuda_runtime.h>\")\nendforeach()\n\n# CMake does not infer HIP from Strata's existing CUDA-shaped .cu suffixes.\nfile(GLOB_RECURSE _strata_hip_sources CONFIGURE_DEPENDS\n  \"${CMAKE_CURRENT_SOURCE_DIR}/src/*.cu\"\n  \"${CMAKE_CURRENT_SOURCE_DIR}/bench/*.cu\"\n  \"${CMAKE_CURRENT_SOURCE_DIR}/tests/*.cu\")\nif(_strata_hip_sources)\n  set_source_files_properties(${_strata_hip_sources} PROPERTIES LANGUAGE HIP)\nendif()\nforeach(_source IN ITEMS tests/hip/intrinsics.cpp tests/hip/native_qsa_score.cpp)\n  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/${_source}\")\n    set_source_files_properties(\"${_source}\" PROPERTIES LANGUAGE HIP)\n  endif()\nendforeach()\n\nmessage(STATUS \"Strata: HIP enabled, arch ${STRATA_HIP_ARCHS}\")\n\n```\n### docs/AMD_HIP.md\n```\n# Experimental AMD HIP backend (gfx1100, gfx1101, gfx1200, gfx1201)\n\nThis is a Linux source build for the RX 7900 XT / XTX (RDNA3, gfx1100) and the\nRX 9070 / 9070 XT / Radeon AI PRO R9700 (RDNA4, gfx1201; see [RDNA4](#rdna4-gfx1201)). The RX 7800 XT / 7700 XT\n(gfx1101) and the RX 9060 XT (gfx1200) were validated by their owners (see [Community-validated\ncards](#community-validated-cards)). It is opt-in; the NVIDIA installer and CUDA build remain the default. Other AMD\narchitectures, wave64, Windows HIP, and mixed AMD/NVIDIA execution are outside this contribution.\n\nThe backend maps the CUDA-shaped runtime and BLAS calls to HIP/hipBLAS, uses\nRDNA3/RDNA4's signed integer dot instruction for quantized kernels, and supplies\nwave32 shuffle/packed-byte operations. CUDA-only QSA matrix instructions have\nan ordered FP32 fallback. Prefill supports both dequantization plus hipBLAS GEMM and opt-in HIP ggml MMQ.\nAn optional, calibrated hipBLASLt path accelerates dense projections (per-architecture tables in `tools/hip`).\nThis does not claim bit-identical model answers across backends. See\n[performance settings and evidence](AMD_HIP_PERFORMANCE.md).\n\n## Install with setup (recommended)\n\nOn Linux with an RX 7900 XT / XTX, RX 7800 XT / 7700 XT, RX 9060 XT, RX 9070 / 9070 XT or Radeon AI PRO R9700 and\nthe kernel's amdgpu driver (no ROCm install needed):\n\n```sh\n./setup.sh --backend hip\n```\n\n- **Detection:** setup finds the card through the kernel's KFD topology. Integrated Radeon GPUs are listed as not\n  supported. On a PC without an NVIDIA card Strata can use, `--backend hip` is chosen automatically.\n- **ROCm:** a system ROCm 7 in `/opt/rocm` (or `$ROCM_PATH`) with hipcc and hipBLAS is used when present. Otherwise\n  (or when it is older than 7.0) ROCm is installed into `.venv` from AMD's TheRock wheels (~10 GB, no sudo), pinned\n  to the version this backend was tested with, from the card family's index: `gfx110X-dgpu` for gfx1100 / gfx1101,\n  `gfx120X-all` for gfx1200 / gfx1201 (`STRATA_ROCM_VERSION` / `STRATA_ROCM_INDEX` override them).\n- **Engine:** compiled on your PC for the card's architecture (10-20 minutes, once; again after a `git pull` that\n  changes it, or when you pick a card of another architecture). This needs a C++ compiler and git\n  (`sudo apt install build-essential git`).\n- **hipBLASLt tuning table:** setup uses `tools/hip/<arch>-hipblaslt-<version>.txt` only when it matches both the\n  card's architecture and the installed hipBLASLt version (read from `hipblaslt-version.h`; 1.2.0 is `100200`).\n  Otherwise it says so and the prompt's dense matrix products use plain hipBLAS (slower prompts, same answers).\n  A table's solution ids are valid only for that pair, and the engine refuses any other table.\n- **Several cards:** setup takes one card (the one with the most VRAM, or `--gpu N`) unless you name more:\n  `./setup.sh --backend hip --gpus 1,0` splits the model's layers across them, the first one the main card (numbers\n  as setup lists them; `--gpus all` = every supported card, the most VRAM first). Every chosen card must be one of the\n  architectures above; the engine is compiled for each of them (cards of two families, e.g. gfx1100 + gfx1201, need\n  a system ROCm 7: AMD's wheels hold one family). A split pays only when no single card holds the model's experts\n  (see RDNA4 below).\n- **Limits for now:** no images, no calibration. The Monitor shows no GPU statistics.\n\nThe rest of setup is the same as on NVIDIA: the model download, the start script, the server.\n\n## Build\n\nRequirements: a working ROCm driver/runtime, HIP development headers and\ncompiler, hipBLAS and (for tuned dense prefill) hipBLASLt development files, CMake 3.24+, a C++20 host compiler, and Git.\nThe model still needs sufficient system RAM and fast SSD storage for its PLE\ntable. VRAM occupancy alone is not a throughput measurement.\n\n```sh\ncmake -S . -B build-hip \\\n  -DCMAKE_BUILD_TYPE=Release \\\n  -DSTRATA_ENABLE_HIP=ON -DSTRATA_ENABLE_CUDA=OFF \\\n  -DCMAKE_HIP_ARCHITECTURES=gfx1100\ncmake --build build-hip --target strata -j2\n```\n\n`CMAKE_HIP_ARCHITECTURES` is `gfx1100`, `gfx1101`, `gfx1200`, `gfx1201`, or a list such as `\"gfx1100;gfx1201\"`\n(one binary for both). gfx1102 (the same wave32, 64 KiB LDS and dot4 instruction) builds with a warning: it passed\nctest (#192) but no model run has been reported. At startup the engine and `strata-device` compare each GPU they use\n(`gcnArchName` up to the `:` feature suffix) with the architectures the binary was compiled for, and require\nwave32. A binary carried to another card stops with the card's name, its architecture and the build's list,\ninstead of failing later with \"invalid device function\".\n\nIf CMake cannot find the HIP compiler, add\n`-DCMAKE_HIP_COMPILER=/path/to/rocm/llvm/bin/clang++`. On the Fedora-family test\nhost this was `/usr/lib64/rocm/llvm/bin/clang++`. Use the compiler and libraries\nfrom the same ROCm installation. Do not enable both GPU backends in one build.\n\nNative IQ experts are enabled by default. CMake fetches the llama.cpp revision\npinned by this repository. For an offline build, point `STRATA_GGML_DIR` at a\ncheckout of that exact revision; using an arbitrary newer checkout changes the\ndependency being tested.\n\n## Model and serving configuration\n\nPrepare a supported model pack and its MTP runtime using the existing tools.\nFor OrcaRouter IQ3_XXS, follow [the explicit compatibility conversion](ORCA.md);\nthis backend does not change quantization, model licenses, or tokenizers.\nAdd `--experts-bin` to the `tools/iq_pack.py` command: mmap requires the pack's\n`experts.bin`, which the default native packing command does not emit. This\nconsumes additional disk space. Original GSQ-RCO IQ3_XXS uses shard 2 for PLE;\nOrca uses shard 1. Keep each model's own pack and tokenizer together.\n\nUse `build-hip/strata` as the executable in the server JSON. Select the AMD\ndevice with `ROCR_VISIBLE_DEVICES`/`HIP_VISIBLE_DEVICES` if necessary. Start with\na modest context and prefill chunk size before measuring larger workloads.\nKeep the PLE file on an SSD. Do not assume a configured context length proves\nsuccessful full-window inference.\n\nLarge pinned host allocations can fail on ROCm even when ordinary RAM is\navailable. The existing `--mmap-experts` path avoids allocating the full pinned\nexpert arena; it still depends on OS file-cache residency and may stall on\nstorage reads. It does not make SSD access equivalent to RAM.\n\nStarting args for the original GSQ-RCO IQ3_XXS model (replace the paths):\n\n```sh\nbuild-hip/strata --serve \\\n  --pack packs/iq3xxs \\\n  --native /path/to/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf \\\n  --ple-gguf /path/to/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf \\\n  --mmap-experts --expert-profile data/expert-profile.bin --expert-cache auto \\\n  --prefill 512 --spec 4 --spec-min-p 0.5 --mtp mtp/rt \\\n  --max-context 4096 --kv int8 --pool-workers 15 \\\n  --adapt-every 0 --pcie-frac 0 --vram-reserve-mib 1024\n```\n\n`--serve` is the engine's internal token protocol. For a browser or OpenAI API,\nput these args in the `args` array of the [server JSON example](ORCA.md#local-server),\nset `exe` to `build-hip/strata`, and use the matching pack's `tokenizer` directory.\nLaunch with `.venv/bin/python -m serve.server --engine strata --config strata-hip.json --port 8080`.\nThe worker count above was used on a 16-core CPU; measure it for your CPU.\nThe 4K context is a smoke-test starting point, not a model limit. The expert cache\nsizes itself automatically and leaves 1 GiB of VRAM headroom.\n\nThe installer supports this backend (see \"Install with setup\" above). The vision helper is NVIDIA-only for now.\nSetup installs one AMD card, or several with `--gpus` (the engine's layer split; see RDNA4 below).\n\n## RDNA4 (gfx1201)\n\nThe RX 9070 / 9070 XT and the Radeon AI PRO R9700 run the same kernels as gfx1100: wave32, 64 KiB of LDS per\nworkgroup, the signed dot4 instruction (`v_dot4_i32_iu8` through `__builtin_amdgcn_sudot4`) and a 100 MHz wall\nclock. The first report and patch came from doplxyz (#178). Validated on 2026-09-30 on doplxyz's test machine:\nan RX 9070 XT 16 GB and a Radeon AI PRO R9700 32 GB (both gfx1201), a Ryzen 9 3900X (16 threads, no AVX-512),\n47 GB RAM, Ubuntu 24.04 in a KVM/VFIO guest.\n\n- **Build:** complete HIP build with tests (`-DCMAKE_HIP_ARCHITECTURES=gfx1201 -DSTRATA_BUILD_TESTS=ON\n  -DSTRATA_PREFILL_MMQ=ON`), with the system ROCm 7.14 (hipBLASLt 1.4.1) and with setup's own path: TheRock\n  7.10.0a20251120 wheels from `gfx120X-all` (hipBLASLt 1.2.0) and `build_engine_hip`.\n- **ctest** (all 45 registered tests, R9700): 42 pass, `hip_prefill_hipblaslt_gemm` skips (no table), and two\n  fail for reasons outside the GPU: `ple_parity` needs the Q2_0 model fixture, `expert_multi_test` needs an\n  AVX-512 CPU. `hip_handoff` needed the volatile ring store: on gfx1201 a plain store to mapped pinned memory\n  stays in the GPU's L2 until the stream is synchronized.\n- **Arch check:** a gfx1100-only build stops on the gfx1201 card at startup with the message above (engine and\n  `strata-device`).\n- **End to end** (Coder IQ1_M, setup's arguments: `--expert-cache auto --prefill auto --spec 4 --spec-min-p 0.5`,\n  MTP, `--kv int8`, `--max-context 32768`; 128 greedy tokens, system ROCm 7.14, no hipBLASLt table). The answers\n  are coherent and the same on both cards. The live server smoke (`serve/server.py`: web page, models, props,\n  chat, prefix reuse, streaming, the Anthropic endpoint, a sampled code answer) passed 9/9 on each card.\n\n  | card | expert cache | peak VRAM | 4K prompt | 4K decode | 16K prompt | 16K decode |\n  |---|---|---|---|---|---|---|\n  | Radeon AI PRO R9700 32 GB | 12,288 slots, 23.4 GiB | 29.7 GiB | 982 tok/s | 45.5 tok/s | 1,402 tok/s | 48.3 tok/s |\n  | RX 9070 XT 16 GB | 4,931 slots, 9.4 GiB | 15.6 GiB | 782 tok/s | 30.8 tok/s | 1,235 tok/s | 35.4 tok/s |\n  | R9700, TheRock 7.10 wheels | 12,288 slots | | 957 tok/s | 44.2 tok/s | 1,284 tok/s | 43.9 tok/s |\n\n  The engine's resident memory was about 26 GB in every run. Since 0.1.31 `__byte_perm` is one `v_perm_b32` and the\n  packed byte subtracts/compare work on four lanes at once (#262, ttio2tech): decode +15% on the R9700 (46.0 -> 53.0\n  tok/s on a 4K prompt, 52.0 -> 60.5 warm) and +5-7% on the 9070 XT, prompts unchanged, the same tokens.\n- **hipBLASLt:** there is no gfx1201 table in `tools/hip`. A table calibrated on the R9700 at the engine's shapes\n  (hipBLASLt 1.4.1; 0.98-1.76x per GEMM over hipBLAS) changed the end-to-end prompt speed by 0-3%, within noise,\n  so none is shipped: on gfx1201 the plain hipBLAS path is already close.\n- **Both cards in one run (layer split, engine 0.1.30):** the config's `\"backend\": \"hip\", \"gpu\": [1, 0]` (R9700\n  first) runs through `serve/server.py` (setup writes it with `--gpus 1,0` since 0.1.31). Auto split put layers 0-27 on the R9700 and\n  28-47 on the 9070 XT. With every expert on the GPUs the split gives exactly the tokens of the R9700 alone (4K and\n  16K prompts); checkpoints on the split (second turn, rewind, a prompt sharing a prefix, a cancelled prompt\n  retried) give exactly the tokens of a fresh read. The conversation cache refuses a split at start (exit 2).\n  On this pair the split does not pay: the R9700 alone already holds all 12,288 expert pairs.\n\n  | run (the same session, warm) | 4K prompt | 16K prompt | decode |\n  |---|---|---|---|\n  | R9700 alone | 1,794 tok/s | 1,804 tok/s | 51-52 tok/s |\n  | R9700 + 9070 XT, auto split | 1,384 tok/s | 1,906 tok/s | 42-43 tok/s |\n  | RX 9070 XT alone | 1,016 tok/s | 1,519 tok/s | 38-40 tok/s |\n\n  A split is worth it when no single card holds the model's experts. Since 0.1.31 a split pins the whole expert\n  arena on Linux (the 8 GiB cap is for Windows/WSL2 only, #253): with an expert cache of 1,500 on the R9700 (most\n  experts streamed) the split read a 16K prompt at 1,803 tok/s instead of 1,287, with the same tokens in 5 + 5\n  starts. `\"split_skip_if_fits\": true` in the config (0.1.31, opt-in) runs such a pair on the first card alone when it\n  holds every profiled expert: with the R9700 first, 4K prompts 1,776 tok/s (split: 1,244) and decode ~60 tok/s\n  (split: ~51), the tokens of the R9700 alone (docs/MULTI_GPU.md).\n- **Known:** rarely (about 1 start in 10) a HIP run's greedy output differs from another start's at some token, on\n  one card or two and on engine 0.1.29 as well; not yet explained.\n- **Not validated:** images, long contexts beyond 16K, answer-quality benchmarks.\n\n## Community-validated cards\n\nRun by their owners, not on the maintainers' machines; setup accepts them like gfx1100 / gfx1201. No hipBLASLt table\nis shipped for them (make one with [Tuning table](#tuning-table) and compare the prompt speed with and without it).\n\n- **gfx1101, RX 7800 XT 16 GB** (jhohertz, #254; engine 0.1.29, Ryzen 9 5950X, 121 GiB RAM, system ROCm with\n  hipBLASLt 1.4.1): `./setup.sh --backend hip` detected the card and compiled the engine; `strata-device --selftest`\n  passed; ctest 30/32 (`ple_parity` needs the Q2_0 fixture, `platform_memory_test` the memlock limit). Coder IQ1_M,\n  64K context, MTP, with a table the owner calibrated: fresh prompts of 4K-9K tokens at 898-953 tok/s, decode\n  38-44 tok/s (128 tokens).\n- **gfx1200, RX 9060 XT 16 GB** (Efeisot, #256 after #176; engine 0.1.29, Ryzen 9 7950X, 64 GiB RAM, ROCm 7.2 with\n  hipBLASLt 1.2.2): ctest 32/32 (without `ple_parity` and `platform_memory_test`). Coder IQ1_M, greedy, MTP\n  `--spec 4 --spec-min-p 0.5`, with a table the owner calibrated:\n\n  | prompt | prompt speed | decode |\n  |---|---|---|\n  | 2,374 tokens | 540 tok/s | 27.1 tok/s (0.69 draft acceptance; 31.0 at 1.00) |\n  | 65K (`--kv int8 --kv-resident 65536 --prefill 16384`) | 748-753 tok/s | 26-40 tok/s by acceptance |\n  | 130K (the same flags) | 725 tok/s | - |\n\n  Greedy output was the same across runs. For comparison, llama.cpp's HIP build measured 20 tok/s decode and\n  450 tok/s prompt on that card.\n\n## Tuning table\n\nA hipBLASLt table holds solution ids that are valid only for one GPU architecture and one hipBLASLt version, so it\nis calibrated on the card with the ROCm the engine runs with. The shipped gfx1100 table's rows are the engine's\ndense GEMM shapes; to calibrate them for another card or version (a few minutes):\n\n```sh\ncmake --build build-hip --target tune_hipblaslt\nCASES=$(awk 'NR>2 {printf \" --case %s,%s,%s,%s,%s\", $1, $5, $2, $3, $4}' tools/hip/gfx1100-hipblaslt-100200.txt)\n./build-hip/tune_hipblaslt $CASES --tuning-out table.txt\n```\n\nThe file's second line names the architecture and version (`STRATA_HIPBLASLT_TUNING_V1 gfx1201 100401`); save it\nas `tools/hip/<arch>-hipblaslt-<version>.txt` for setup, or point `STRATA_HIPBLASLT_TUNING` at it. Compare the\nprompt speed with and without it before keeping it.\n\n## Original backend validation (PR #94)\n\nThe following is historical validation of the original backend, not a fresh\ntest count for this replacement. Current build/test evidence and performance\nlimits are recorded in [AMD_HIP_PERFORMANCE.md](AMD_HIP_PERFORMANCE.md).\n\nTested against upstream `c1e903310f211e6630780c3bd2038778c071c68d` (0.1.20),\nwith pinned llama.cpp `3cf03257f219afbe7334045ff7c6a06ac68c627d`.\nThe host has an RX 7900 XTX (24 GiB), Ryzen 9 7950X3D, 64 GiB system RAM,\nand Fedora-family Linux with ROCm 7.1.52802 / Clang 20. The original model used\nfor the smoke check was on mechanical RAID0; cold page faults were slow. Keep\nlatency-sensitive data on SSD and measure warm residency separately.\n\n- Complete HIP Release build, including the executable and parity targets.\n- All 25 tests selected by the command below passed on 2026-09-29.\n- Intrinsic parity includes signed packed-byte dot products and overflow.\n- CPU/GPU mapped-memory handoff covers delayed publication, changing payloads,\n  and repeated graph replay in both directions.\n- GR coverage includes the maximum eight-token fused batch and graph replay\n  after inputs change. Native QSA checks the scalar HIP fallback.\n- Q8_K quantization is byte-exact against the existing reference. HIP's\n  `__fmul_rn` can become ordinary multiplication; disabling contraction in\n  `quantize_act.cu` preserves the separately rounded product before the magic\n  rounding bias is added. CUDA's compile flags remain unchanged.\n- The mmap regression covers canonical and differing native layer sizes,\n  truncated/oversized files, lookup bounds, and reopening after errors.\n- CUDA 13 / GCC 15 / sm_89 executable build passed; GR, sampler, quantization,\n  and mmap tests passed on the same tree. This is a regression check, not a\n  claim of complete CUDA inference validation.\n- CPU-only `strata-plan` build passed without either GPU backend.\n- Real GSQ-RCO IQ3_XXS server smoke with mmap, the shipped expert profile,\n  automatic GPU cache, and MTP passed arithmetic, executable Python addition,\n  system-marker recall, and 1,170-token batched-prefill recall. All four requests\n  ended normally with correct answers; one engine process served them all.\n  The cache held 11,142 experts (18.08 GiB), with 874 MiB of VRAM free after\n  startup. These short checks do not establish a throughput or quality benchmark.\n\nBuild all targets before running the registered focused checks:\n\n```sh\ncmake --build build-hip -j2\nctest --test-dir build-hip --output-on-failure --timeout 60 \\\n  -E '^(ple_parity|platform_memory_test)$'\n```\n\n`ple_parity` requires an external model fixture. `platform_memory_test` requests\n256 MiB of locked memory; the test shell's 8 MiB memlock limit prevented that\ntest from passing. These are explicit exclusions, not skipped tests counted as\npasses. Additional unpublished upstream fixture suites are not covered.\n\nThe published performance table explicitly identifies the measured development\nsnapshot; it must not be read as a benchmark of every subsequent rebase. Vision, long-context stress, broad answer-quality\nequivalence, other AMD cards, and mixed-vendor inference are not validated here.\n\n```\n### docs/AMD_HIP_PERFORMANCE.md\n```\n# RX 7900 XTX support and performance evidence\n\nThis opt-in Linux `gfx1100` backend supersedes the initial support in\n[PR #94](https://github.com/Niko1221/Strata/pull/94). It retains HIP runtime and\nwave32 integer-dot compatibility, native mmap layout validation, and MTP, then\nadds HIP MMQ, optional calibrated dense hipBLASLt GEMM, native prefill batching,\nand the host-memory / SSD paths used by the measured configuration. HIP blocking\nexpert uploads use one reusable pinned staging buffer, including prompt-cache\nrefills, to avoid repeated pageable-source registrations.\n\n## Reproduce the configuration\n\nBuild instructions are in [AMD_HIP.md](AMD_HIP.md). Use the repository-pinned\nllama.cpp dependency; do not silently substitute another revision. Build with\n`STRATA_PREFILL_MMQ=ON` and use these runtime variables for the measured arm:\n\n```sh\nexport STRATA_PREFILL_MMQ=1\nexport STRATA_HIPBLASLT_TUNING=\"$PWD/tools/hip/gfx1100-hipblaslt-100100.txt\"\nexport STRATA_PREFILL_RING=96\nexport STRATA_IO_THREADS=32\n```\n\nThe supplied table is calibrated for gfx1100 and hipBLASLt version 100100.\nIt is not a universal ROCm tuning table. The runtime guards architecture,\nlibrary version and actual shape/stride/workspace requirements, falling back\nwhen a table entry is unavailable or incompatible. HIP MMQ is opt-in at runtime. Default CUDA selection is preserved.\n\nMeasured engine configuration: Orca Flash Next IQ3_XXS, native pack plus matching\nGGUF/tokenizer/template, `--mmap-experts --resident-cpu-experts`, fixed ranked\n`--expert-profile`, `--expert-cache auto`, `--prefill 8192`, `--spec 4`,\n`--spec-min-p 0.5`, matching MTP runtime, `--max-context 262144`, `--kv int8`,\n`--kv-resident 32768`, `--pool-workers 15`, `--adapt-every 0`, `--pcie-frac 0`,\nand `--vram-reserve-mib 1024`. Keep PLE on SSD.\n\n`--resident-cpu-experts` copies the complement of the static GPU cache to ordinary\nRAM. It requires mmap and a fixed expert profile. The slots the prompt path may\nborrow keep their experts in RAM too as far as the budget below allows (the rest\nuse the mapped fallback while borrowed and for their refill), and adaptive swaps\n(`--adapt-every`) exchange experts between VRAM and the RAM copy without reading\nthe file. The copy is pageable; `--resident-experts` (CUDA, chosen by setup)\npage-locks it and uses 4 GiB of headroom. Allocation needs sufficient available RAM;\non Linux this option requires readable standard cgroup-v2 mounts. For each\nfinite cgroup ancestor, the guard credits only `inactive_file` after subtracting\n`file_dirty` and `file_writeback`, capped by current usage; it remains bounded by\nthe ancestor limit and host `MemAvailable`, with 8 GiB headroom. This accounts\nfor reclaimable clean file cache but cannot reserve memory against concurrent\nsystem or process allocations.\nThe POSIX PLE path issues direct reads through a configurable worker pool.\n\nUse a dedicated idle server, restart it between arms, and capture its engine log:\n\n```sh\npython3 tools/hip/bench_prefill.py \\\n  --model MODEL_NAME --url http://127.0.0.1:8080 \\\n  --engine-log /path/to/engine.log --label candidate --output candidate.json\n```\n\nThe script uses the same synthetic source prompts and request order as the\nreported measurements: a small warmup, then 140/280/140/280 functions, with one\nfollow-up after each fresh prompt. It enforces zero reused tokens for the fresh\nprompts and records prefill, decode, wall time and stop reason. It requires the\nunbuffered log to contain exactly one completed timing record per request. The\n128-token output cap is intentional for throughput measurement, not task success.\nNever use cancelled-request timing lines as throughput evidence.\n\n## Final revision benchmark\n\nMeasured on 2026-09-29, source revision `9568e78da663e6b224ab96d57baf450717b36e73`.\nHIP executable SHA-256: `705f5925a788bc227bad72abfb5466032e0879d752fea9afc3\n\nTask: explain what the last file above does, then propose one concrete improvement as a unified diff. This is an offline task with no tools: write the explanation and diff directly in your reply using only the files supplied here. If the last file is truncated, work from the visible portion. Provide a detailed answer of at least 500 words, including the explanation, complete diff, and how to verify the change."
