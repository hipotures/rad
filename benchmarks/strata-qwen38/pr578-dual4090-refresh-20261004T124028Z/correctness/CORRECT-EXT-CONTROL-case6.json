  "text": "```python\ndef binary_search(a, x):\n    \"\"\"\n    Perform binary search on a sorted list 'a' for element 'x'.\n    Returns the index of 'x' if found, otherwise returns -1.\n    \"\"\"\n    low = 0\n    high = len(a) - 1\n    \n    while low <= high:\n        mid = (low + high) // 2\n        if a[mid] == x:\n            return mid\n        elif a[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    \n    return -1\n\n\n# Tests\nif __name__ == \"__main__\":\n    # Test with empty list\n    assert binary_search([], 5) == -1, \"Failed: empty list\"\n    \n    # Test with missing item\n    assert binary_search([1, 3, 5, 7, 9], 4) == -1, \"Failed: missing item\"\n    \n    # Test with found item\n    assert binary_search([1, 3, 5, 7, 9], 5) == 2, \"Failed: found item\"\n    \n    # Test with first item\n    assert binary_search([1, 3, 5, 7, 9], 1) == 0, \"Failed: first item\"\n    \n    # Test with last item\n    assert binary_search([1, 3, 5, 7, 9], 9) == 4, \"Failed: last item\"\n    \n    # Test with single element list\n    assert binary_search([5], 5) == 0, \"Failed: single element found\"\n    assert binary_search([5], 3) == -1, \"Failed: single element not found\"\n    \n    print(\"All tests passed!\")\n```",
