diff --git a/include/strata/kernels/cpu/native_batch.hpp b/include/strata/kernels/cpu/native_batch.hpp
new file mode 100644
index 0000000..4ce13c7
--- /dev/null
+++ b/include/strata/kernels/cpu/native_batch.hpp
@@ -0,0 +1,30 @@
+// Bounded native CPU routed-expert batch, also used by CPU-only prefill.
+#pragma once
+#include "strata/kernels/cpu/pool.hpp"
+#include <algorithm>
+#include <stdexcept>
+namespace strata::kernels::cpu {
+// Inputs are FP32 token rows. src indexes tokens; outputs are consecutive expert-sorted rows.
+// No router weight here: the caller's combine applies it exactly once.
+inline void native_expert_batch(ExpertPool& pool, const NativeFmt& f, const uint8_t* blob,
+                               const float* mixed, int64_t tokens, const int32_t* src,
+                               int64_t count, float* out) {
+    if (!blob || count < 0 || f.n_embd != H || f.n_ff != FF)
+        throw std::invalid_argument("native CPU batch: invalid blob or geometry");
+    alignas(64) uint8_t act[MAXT][kNativeActBytes];
+    for (int64_t b = 0; b < count; b += MAXT) {
+        ExpertJobMulti job;
+        job.blob = blob;
+        job.nt = (int) std::min<int64_t>(MAXT, count - b);
+        for (int t = 0; t < job.nt; ++t) {
+            const int32_t token = src[b + t];
+            if (token < 0 || token >= tokens)
+                throw std::out_of_range("native CPU batch: token index out of range");
+            native_quant_act(f, mixed + (size_t) token * H, act[t]);
+            job.nact[t] = act[t];
+            job.out[t] = out + (size_t) (b + t) * H;
+        }
+        pool.run_split_multi_native(f, &job, 1);
+    }
+}
+} // namespace strata::kernels::cpu
