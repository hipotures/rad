+// Complete metadata and optional tensor directory, but deliberately no alignment
+// padding or payload. The metadata-only case is a valid GGUF shard.
+std::filesystem::path write_unpadded_gguf(bool has_tensor, bool truncated_metadata = false) {
+    std::vector<uint8_t> b;
+    put<uint32_t>(b, 0x46554747u);
+    put<uint32_t>(b, 3);
+    put<uint64_t>(b, has_tensor ? 1 : 0);
+    put<uint64_t>(b, 1);
+    put_str(b, "general.name");
+    put<uint32_t>(b, 8);  // STRING
+    put_str(b, "metadata-only");
+    if (has_tensor) {
+        put_str(b, "t");
+        put<uint32_t>(b, 1);
+        put<uint64_t>(b, 8);
+        put<uint32_t>(b, 0);  // F32
+        put<uint64_t>(b, 0);
+    }
+    if (truncated_metadata) b.pop_back();
+    const auto path = std::filesystem::temp_directory_path() / "strata_gguf_unpadded_test.gguf";
+    std::ofstream(path, std::ios::binary).write(reinterpret_cast<const char*>(b.data()), (std::streamsize)b.size());
+    return path;
+}
 }  // namespace
 
