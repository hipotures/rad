+// Research-only causal information boundary. FULL is the finite tape, not eternity.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+namespace strata::research {
+enum class FutureStatus { Known, UnknownBeyondHorizon, FiniteTapeEnd };
+struct FutureUse { FutureStatus status; int event=-1; };
+struct FutureQueryAudit { uint64_t next_calls=0,count_calls=0,unknown=0; int max_visible_ahead=0; };
+template<int Role> struct FutureView {
+ const std::vector<std::vector<std::pair<int,int>>>* index=nullptr;
+ int horizon=0,total_events=0; // 0 means FULL.
+ mutable FutureQueryAudit audit;
+ int end(int now)const{return horizon?std::min(total_events-1,now+horizon):total_events-1;}
+ FutureUse next(int key,int at,int now)const {
+  ++audit.next_calls; const int stop=end(now);
+  const auto& v=(*index)[key]; auto it=std::lower_bound(v.begin(),v.end(),std::make_pair(at,-1));
+  if(it!=v.end()&&it->first<=stop){audit.max_visible_ahead=std::max(audit.max_visible_ahead,it->first-now);return {FutureStatus::Known,it->first};}
+  if(stop<total_events-1){++audit.unknown;return {FutureStatus::UnknownBeyondHorizon,-1};}
+  return {FutureStatus::FiniteTapeEnd,-1};
+ }
+ int count(int key,int at,int until,int now)const {
+  ++audit.count_calls;until=std::min(until,end(now));if(until<at)return 0;
+  const auto& v=(*index)[key];auto it=std::lower_bound(v.begin(),v.end(),std::make_pair(at,-1));int n=0;
+  for(;it!=v.end()&&it->first<=until;++it){n+=it->second;audit.max_visible_ahead=std::max(audit.max_visible_ahead,it->first-now);}return n;
+ }
+};
+using IncomingFutureView=FutureView<0>;
+using VictimFutureView=FutureView<1>;
+}
