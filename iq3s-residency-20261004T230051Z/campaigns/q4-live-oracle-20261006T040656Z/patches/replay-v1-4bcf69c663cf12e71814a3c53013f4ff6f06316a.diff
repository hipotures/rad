+__global__ void tape_route_kernel(TapePage* p,int layer,int off,int n,int32_t* ids,float* weights,const float* x){
+ int mode=((volatile int32_t*)&p->mode)[0];if(!mode)return;int i=threadIdx.x;
+ if(i==0)atomicAdd(p->seen+layer,1);
+ if(i<8){p->activation[layer][i]=x[i];if(!isfinite(x[i]))atomicOr(&p->nonfinite,1);}
+ if(i<n){int32_t* pi=layer<48?p->routes.ids[layer]+off:p->routes.mtp_ids[layer-48];float* pw=layer<48?p->routes.weights[layer]+off:p->routes.mtp_weights[layer-48];
+  if(!isfinite(weights[i])||ids[i]<0||ids[i]>=512)atomicOr(&p->nonfinite,1);
+  if(mode==1){pi[i]=ids[i];pw[i]=weights[i];}else{if(ids[i]!=pi[i]||__float_as_uint(weights[i])!=__float_as_uint(pw[i]))atomicAdd(p->disagreements+layer,1);ids[i]=pi[i];weights[i]=pw[i];}
+ }
+ __threadfence_system();
+}
+__global__ void tape_head_kernel(TapePage* p,int j,int32_t* out,float* prob){int mode=((volatile int32_t*)&p->mode)[0];if(!mode)return;if(mode==1){p->routes.drafts[j]=out[0];p->routes.probs[j]=prob[0];}else{out[0]=p->routes.drafts[j];prob[0]=p->routes.probs[j];}__threadfence_system();}
+void tape_route(TapePage* p,int l,int off,int n,int32_t* ids,float* w,const float* x,void* s){tape_route_kernel<<<1,64,0,(cudaStream_t)s>>>(p,l,off,n,ids,w,x);}
+void tape_mtp_head(TapePage* p,int j,int32_t* out,float* prob,void* s){tape_head_kernel<<<1,1,0,(cudaStream_t)s>>>(p,j,out,prob);}
+}
