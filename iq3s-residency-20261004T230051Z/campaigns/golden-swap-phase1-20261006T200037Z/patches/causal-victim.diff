+ void reset(){last.fill(-1);last_gap.fill(0);gap_n.fill(0);cache_version.fill(-1);total.fill(0);fast.fill(0);slow.fill(0);gap_sum.fill(0);gap_sq.fill(0);updated.fill(-1);versions.fill(0);feature_ns=score_ns=selection_ns=scores=cache_hits=rejections=invalid=0;}
+ bool load(const char* path){if(!path)return false;std::ifstream f(path);std::string magic;int kind,features;f>>magic>>kind>>features;if(magic!="Q4VICTIM1"||features!=F||(kind!=0&&kind!=1))return false;tree=kind;for(auto& x:mean)f>>x;for(auto& x:scale)f>>x;for(auto& h:heads){f>>h.bias;if(!tree){for(auto& x:h.coefficients)f>>x;}else{int nt;f>>h.lr>>nt;if(nt<1||nt>64)return false;h.trees.resize(nt);for(auto& t:h.trees){int nn;f>>nn;if(nn<1||nn>255)return false;t.resize(nn);for(auto& n:t)f>>n.left>>n.right>>n.feature>>n.threshold>>n.value;for(auto& n:t)if(n.left>=0&&(n.left>=nn||n.right<0||n.right>=nn||n.feature<0||n.feature>=F))return false;}}}if(!f)return false;for(int j=0;j<F;++j)if(!std::isfinite(mean[j])||!std::isfinite(scale[j])||scale[j]<=0)return false;loaded=true;return true;}
+ std::array<double,F> features(int l,int e,int at)const{int k=l*512+e;double wi=at/48.,dt=wi-std::max(0,updated[l]);bool seen=last[k]>=0;double rec=seen?wi-last[k]:wi+1,mu=gap_n[k]?gap_sum[k]/gap_n[k]:0,var=gap_n[k]?std::max(0.,gap_sq[k]/gap_n[k]-mu*mu):0;return {l/47.,double(l/24),double(l==4||l==30||l==46||l==47),double(l==2),double(seen),std::log1p(std::max(0.,rec)),std::log1p(fast[k]*std::exp(-dt/4)),std::log1p(slow[k]*std::exp(-dt/64)),std::log1p(total[k]),std::log1p(double(last_gap[k])),std::log1p(mu),mu>0?std::sqrt(var)/mu:0,std::log1p(wi)};}
+ std::array<double,4> predict(const std::array<double,F>& raw)const{std::array<double,F>x;for(int j=0;j<F;++j)x[j]=(double(float(raw[j]))-mean[j])/scale[j];std::array<double,4>p;for(int i=0;i<4;++i){const auto& h=heads[i];double v=h.bias;if(tree){for(const auto& t:h.trees){int n=0,steps=0;while(t[n].left>=0&&steps++<255)n=x[t[n].feature]<=t[n].threshold?t[n].left:t[n].right;if(steps>=255)return {NAN,NAN,NAN,NAN};v+=h.lr*t[n].value;}}else for(int j=0;j<F;++j)v+=x[j]*h.coefficients[j];p[i]=1/(1+std::exp(-std::clamp(v,-40.,40.)));if(i)p[i]=std::max(p[i],p[i-1]);}return p;}
+ void observe(int l,const int32_t* ids,int n,int ev){int wi=ev/48;double dt=wi-std::max(0,updated[l]),a=std::exp(-dt/4),b=std::exp(-dt/64);for(int e=0;e<512;++e){int k=l*512+e;fast[k]*=a;slow[k]*=b;}updated[l]=wi;++versions[l];int count[512]={};for(int j=0;j<n;++j)++count[ids[j]];for(int e=0;e<512;++e)if(count[e]){int k=l*512+e;if(last[k]>=0){int gap=wi-last[k];last_gap[k]=gap;++gap_n[k];gap_sum[k]+=gap;gap_sq[k]+=double(gap)*gap;}last[k]=wi;total[k]+=count[e];fast[k]+=count[e];slow[k]+=count[e];}}
